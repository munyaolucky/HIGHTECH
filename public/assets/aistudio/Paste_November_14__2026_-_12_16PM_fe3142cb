# **Next development slice: Shared Staff Portal UI**

We will now build the common staff workspace that all HI-TECH College employees use. The layout will automatically display the correct navigation and dashboard according to the authenticated staff role.

This slice covers:

1. Responsive staff sidebar and mobile navigation.
2. Staff header with search, notifications and profile menu.
3. Role-aware dashboard routing.
4. Reusable statistic cards, action buttons and task lists.
5. Access-denied handling for unsupported roles.

The components below are frontend foundations. They must be connected to your existing authentication and API rather than creating a separate login system.

## **1. Staff sidebar**

Create `apps/web/src/portals/staff/StaffSidebar.tsx`.

```

import {
  LayoutDashboard, User, ClipboardList, MessageSquare, Bell,
  LifeBuoy, Folder, Settings, Building2, Users, Network, MapPin,
  CheckCircle, ChartNoAxesCombined, GraduationCap, BriefcaseBusiness,
  UserPlus, ClipboardCheck, BookOpen, CalendarDays, FileText, Award,
  Wallet, CreditCard, Smartphone, Receipt, ChartPie, Clock, Star,
  Presentation, FolderOpen, FilePenLine, CheckCheck, BookMarked,
  RotateCcw, Bookmark, Library, Package, Ticket, Monitor,
  MonitorCheck, Wrench, Building, Calendar, Files, Mail, Gauge,
  FolderCheck, TrendingUp, HeartHandshake, Vote, Bed, Laptop,
  FilePlus, Truck, ShoppingCart, PackageCheck, PackageMinus,
  Megaphone, Globe, Images, ShieldCheck, AlertTriangle, Bus,
  ChevronDown, ChevronRight, X
} from "lucide-react";
import { NavLink } from "react-router-dom";
import { useState } from "react";
import {
  getStaffNavigation,
  type StaffRole,
  type StaffNavItem
} from "../../config/staff-navigation";

const iconMap: Record<string, React.ElementType> = {
  LayoutDashboard, User, ClipboardList, MessageSquare, Bell,
  LifeBuoy, Folder, Settings, Building2, Users, Network, MapPin,
  CheckCircle, ChartNoAxesCombined, GraduationCap, BriefcaseBusiness,
  UserPlus, ClipboardCheck, BookOpen, CalendarDays, FileText, Award,
  Wallet, CreditCard, Smartphone, Receipt, ChartPie, Clock, Star,
  Presentation, FolderOpen, FilePenLine, CheckCheck, BookMarked,
  RotateCcw, Bookmark, Library, Package, Ticket, Monitor,
  MonitorCheck, Wrench, Building, Calendar, Files, Mail, Gauge,
  FolderCheck, TrendingUp, HeartHandshake, Vote, Bed, Laptop,
  FilePlus, Truck, ShoppingCart, PackageCheck, PackageMinus,
  Megaphone, Globe, Images, ShieldCheck, AlertTriangle, Bus
};

interface Props {
  role: StaffRole;
  mobileOpen: boolean;
  onCloseMobile: () => void;
  permissions: string[];
}

function hasPermission(item: StaffNavItem, permissions: string[]) {
  return !item.permission || permissions.includes(item.permission);
}

export default function StaffSidebar({
  role,
  mobileOpen,
  onCloseMobile,
  permissions
}: Props) {
  const [expanded, setExpanded] = useState<string[]>([]);

  const navigation = getStaffNavigation(role).filter(item =>
    hasPermission(item, permissions)
  );

  function toggle(label: string) {
    setExpanded(current =>
      current.includes(label)
        ? current.filter(item => item !== label)
        : [...current, label]
    );
  }

  function renderItem(item: StaffNavItem) {
    const Icon = iconMap[item.icon] ?? Folder;
    const isExpanded = expanded.includes(item.label);
    const hasChildren = Boolean(item.children?.length);

    if (hasChildren) {
      return (
        <div key={item.path}>
          <button
            type="button"
            onClick={() => toggle(item.label)}
            className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-slate-600 hover:bg-slate-100"
            aria-expanded={isExpanded}
          >
            <Icon size={18} />
            <span className="flex-1">{item.label}</span>
            {isExpanded ? <ChevronDown size={16} /> : <ChevronRight size={16} />}
          </button>
          {isExpanded && (
            <div className="ml-7 mt-1 space-y-1">
              {item.children!.filter(child =>
                hasPermission(child, permissions)
              ).map(renderItem)}
            </div>
          )}
        </div>
      );
    }

    return (
      <NavLink
        key={item.path}
        to={item.path}
        onClick={onCloseMobile}
        end={item.path === "/staff/dashboard"}
        className={({ isActive }) =>
          `flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition ${
            isActive
              ? "bg-blue-50 font-semibold text-blue-800"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          }`
        }
      >
        <Icon size={18} />
        <span>{item.label}</span>
      </NavLink>
    );
  }

  return (
    <>
      {mobileOpen && (
        <button
          type="button"
          aria-label="Close navigation"
          onClick={onCloseMobile}
          className="fixed inset-0 z-40 bg-slate-950/40 lg:hidden"
        />
      )}

      <aside
        className={`fixed inset-y-0 left-0 z-50 flex w-72 flex-col border-r border-slate-200 bg-white transition-transform lg:translate-x-0 ${
          mobileOpen ? "translate-x-0" : "-translate-x-full"
        }`}
      >
        <div className="flex h-20 items-center justify-between border-b px-5">
          <div>
            <div className="text-lg font-extrabold tracking-tight text-[#102D50]">
              HI-TECH <span className="text-blue-600">COLLEGE</span>
            </div>
            <div className="text-xs text-slate-500">Staff Workspace</div>
          </div>
          <button
            type="button"
            onClick={onCloseMobile}
            className="rounded-lg p-2 hover:bg-slate-100 lg:hidden"
            aria-label="Close sidebar"
          >
            <X size={20} />
          </button>
        </div>

        <div className="border-b px-5 py-4">
          <div className="rounded-xl bg-[#102D50] p-3 text-white">
            <div className="text-xs text-blue-100">Signed in as</div>
            <div className="mt-1 text-sm font-semibold">
              {role.replaceAll("_", " ")}
            </div>
          </div>
        </div>

        <nav
          aria-label="Staff navigation"
          className="flex-1 space-y-1 overflow-y-auto p-4"
        >
          {navigation.map(renderItem)}
        </nav>

        <div className="border-t p-4 text-xs text-slate-500">
          HI-TECH College · Staff Portal
        </div>
      </aside>
    </>
  );
}

