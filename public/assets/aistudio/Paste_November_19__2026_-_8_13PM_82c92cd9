      active = false;
    };
  }, [eventId]);

  function update(
    field: keyof typeof form,
    value: string | boolean
  ) {
    setForm(current => ({
      ...current,
      [field]: value,
    }));
  }

  async function submit(eventForm: React.FormEvent) {
    eventForm.preventDefault();

    if (!eventId) return;

    if (!form.consent) {
      setError("Consent is required to register.");
      return;
    }

    setSubmitting(true);
    setError("");

    try {
      const registration = await registerForEvent(eventId, form);

      navigate(
        `/events/my-registration/${registration.id}`,
        { state: { registration } }
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Registration failed."
      );
    } finally {
      setSubmitting(false);
    }
  }

  if (loading) {
    return <main role="status">Loading registration form...</main>;
  }

  if (!event || error && !event) {
    return (
      <main className="event-registration">
        <h1>Registration unavailable</h1>
        <p>{error || "The event could not be found."}</p>
        <Link to="/events">View events</Link>
      </main>
    );
  }

  return (
    <main className="event-registration">
      <div className="event-registration__container">
        <div className="event-registration__intro">
          <Link to={`/events/${event.slug}`}>
            ← Back to event
          </Link>

          <h1>Event registration</h1>
          <p>Register to attend this HI-TECH College event.</p>
        </div>

        <div className="event-registration__event">
          {event.bannerUrl && (
            <img src={event.bannerUrl} alt="" />
          )}

          <div>
            <span>{event.category}</span>
            <h2>{event.title}</h2>

            <p>
              {new Date(event.startAt).toLocaleDateString("en-KE", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </p>

            <p>{event.venue || event.mode}</p>
          </div>
        </div>

        <form
          className="event-registration__form"
          onSubmit={submit}
        >
          <h2>Participant information</h2>

          <div className="form-grid">
            <label>
              Full name *
              <input
                required
                autoComplete="name"
                value={form.fullName}
                onChange={e => update("fullName", e.target.value)}
              />
            </label>

            <label>
              Email address *
              <input
                required
                type="email"
                autoComplete="email"
                value={form.email}
                onChange={e => update("email", e.target.value)}
              />
            </label>

            <label>
              Phone number *
              <input
                required
                type="tel"
                autoComplete="tel"
                value={form.phone}
                onChange={e => update("phone", e.target.value)}
              />
            </label>

            <label>
              Organisation / Institution
              <input
                value={form.organisation}
                onChange={e => update("organisation", e.target.value)}
              />
            </label>

            <label>
              Participant category *
              <select
                required
                value={form.participantType}
                onChange={e => update("participantType", e.target.value)}
              >
                <option value="">Select category</option>
                <option value="STUDENT">Student</option>
                <option value="STAFF">College staff</option>
                <option value="PROFESSIONAL">Professional</option>
                <option value="EDUCATOR">Educator</option>
                <option value="PUBLIC">Member of public</option>
                <option value="OTHER">Other</option>
              </select>
            </label>

            <label>
              Attendance mode
              <select
                value={form.attendanceMode}
                onChange={e => update("attendanceMode", e.target.value)}
              >
                <option value="">Choose mode</option>
                <option value="PHYSICAL">Physical</option>
                <option value="ONLINE">Online</option>
              </select>
            </label>
          </div>

          <label>
            Special requirements (optional)
            <textarea
              rows={4}
              value={form.specialRequests}
              onChange={e =>
                update("specialRequests", e.target.value)
              }
              placeholder="Accessibility requirements or other requests..."
            />
          </label>

          <label className="event-consent">
            <input
              type="checkbox"
              checked={form.consent}
              onChange={e => update("consent", e.target.checked)}
              required
            />
            <span>
              I consent to the use of my registration information
              for event coordination and communication.
            </span>
          </label>

          {error && (
            <p className="events-error" role="alert">
              {error}
            </p>
          )}

          <button
            type="submit"
            className="events-button"
            disabled={submitting}
          >
            {submitting
              ? "Submitting registration..."
              : "Submit registration"}
          </button>

          <p className="event-registration__privacy">
            Your information will be used for event coordination
            according to the college privacy policy.
          </p>
        </form>
      </div>
    </main>
  );
}

```

Note: The registration page currently uses a proposed event-by-ID lookup endpoint. It needs to be implemented on the API or replaced with the existing route contract. The server must enforce eligibility, duplicate checks, deadlines, capacity, waitlist and approval rules.

