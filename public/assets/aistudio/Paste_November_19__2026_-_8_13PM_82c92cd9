import { Link, useLocation, useParams } from "react-router-dom";
import { CheckCircle2, CalendarDays, MapPin } from "lucide-react";
import type { EventRegistrationResponse } from "./event-types";
import "./events.css";

type ConfirmationState = {
  registration?: EventRegistrationResponse;
};

export default function EventRegistrationConfirmationPage() {
  const { registrationId } = useParams();
  const location = useLocation();

  const state = location.state as ConfirmationState | null;
  const registration = state?.registration;

  return (
    <main className="event-confirmation">
      <div className="event-confirmation__card">
        <div className="event-confirmation__icon">
          <CheckCircle2 size={52} />
        </div>

