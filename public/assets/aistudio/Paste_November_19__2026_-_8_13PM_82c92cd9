                {registration.registrationNo}
              </strong>
            </div>

            <div>
              <span>Status</span>
              <strong>{registration.status}</strong>
            </div>
          </div>
        ) : (
          <div className="event-confirmation__notice">
            <p>
              Confirmation details may be retrieved using your
              registration reference.
            </p>
            <p>
              Reference: {registrationId}
            </p>
