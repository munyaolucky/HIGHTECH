Registration generator service
Create:

src/modules/registration/services/registrationNumber.service.ts

import {
  Prisma,
  PrismaClient,
  RegistrationRecordType,
} from "@prisma/client";

const prisma = new PrismaClient();

const TYPE_CODES: Record<RegistrationRecordType, string> = {
  STAFF: "STAFF",
  STU: "STU",
  LECT: "LECT",
  ADMIN: "ADMIN",
  PARENT: "PARENT",
  APP: "APP",
  DEPT: "DEPT",
  CAMP: "CAMP",
  EXAM: "EXAM",
  CERT: "CERT",
  LIB: "LIB",
};

export async function generateRegistrationNumber(
  institutionId: string,
  recordType: RegistrationRecordType,
  year: number,
  prefix = "HCA",
): Promise<string> {
  if (!institutionId || !prefix.trim()) {
    throw new Error("Institution and prefix are required");
  }

  if (!Number.isInteger(year) || year < 2000 || year > 9999) {
    throw new Error("Invalid registration year");
  }

  const typeCode = TYPE_CODES[recordType];

  if (!typeCode) {
    throw new Error("Unsupported registration type");
  }

  for (let attempt = 0; attempt < 5; attempt++) {
    try {
      return await prisma.$transaction(
        async (tx) => {
          const counter = await tx.registrationSequence.upsert({
            where: {
              institutionId_recordType_year: {
                institutionId,
                recordType,
                year,
              },
            },
            create: {
              institutionId,
              recordType,
              year,
              prefix,
              nextNumber: 2,
              paddingWidth: 3,
            },
            update: {
              nextNumber: { increment: 1 },
              prefix,
            },
          });

          const sequence = counter.nextNumber - 1;

          const registrationNo =
            `${prefix}/${typeCode}/${year}/` +
            String(sequence).padStart(counter.paddingWidth, "0");

          await tx.registrationNumber.create({
            data: {
              institutionId,
              recordType,
              registrationNo,
              year,
              sequence,
            },
          });

          return registrationNo;
        },
        {
          isolationLevel:
            Prisma.TransactionIsolationLevel.Serializable,
        },
      );
    } catch (error) {
      if (
        error instanceof Prisma.PrismaClientKnownRequestError &&
        ["P2002", "P2034"].includes(error.code)
      ) {
        if (attempt === 4) throw error;
        continue;
      }

      throw error;
    }
  }

  throw new Error("Unable to generate registration number");
}

This is a foundational service example. Production integration must also load the authorised institution prefix from configuration, derive the year using the institution timezone, and link the generated number to the newly created staff or student record in the same database transaction. Retry and rollback tests are required.

