3. Unified login page
src/modules/auth/PortalLoginPage.tsx
This login page supports students and staff through one interface without an account-type selector. The authenticated backend determines the role.


import { FormEvent, useState } from "react";
import { Link, useLocation, useNavigate } from "react-router-dom";
import {
  Eye,
  EyeOff,
  ShieldCheck,
  GraduationCap,
  ArrowRight,
  Loader2,
} from "lucide-react";
import { useAuth } from "../../auth/useAuth";
import "./auth-pages.css";

export default function PortalLoginPage() {
  const { login } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();

  const [identifier, setIdentifier] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [rememberMe, setRememberMe] = useState(false);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const from = location.state?.from;

  function safeRedirect(path: unknown) {
    if (
      typeof path === "string" &&
      path.startsWith("/") &&
      !path.startsWith("//") &&
      !path.includes("\\")
    ) {
      return path;
    }

    return null;
  }

  async function handleSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setError("");

    if (!identifier.trim() || !password) {
      setError("Enter your login details to continue.");
      return;
    }

    setLoading(true);

    try {
      const user = await login({
        identifier: identifier.trim(),
        password,
        rememberMe,
      });

      const requestedPath = safeRedirect(from);

      if (user.mustChangePassword) {
        navigate("/portal/auth/change-password", { replace: true });
        return;
      }

      if (user.requiresProfileCompletion) {
        navigate("/portal/auth/complete-profile", {
          replace: true,
        });
        return;
      }

      const dashboardPath =
        user.dashboardPath ||
        (user.role === "STUDENT"
          ? "/portal/student"
          : "/portal/staff");

      navigate(requestedPath || dashboardPath, {
        replace: true,
      });
    } catch {
      setError(
        "Unable to sign in. Check your details or contact the college support team."
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="auth-page">
      <section className="auth-card">
        <div className="auth-brand">
          <div className="auth-logo">
            <GraduationCap size={32} />
          </div>

          <div>
            <h1>HI-TECH COLLEGE</h1>
            <p>Digital Campus Portal</p>
          </div>
        </div>

        <div className="auth-heading">
          <h2>Welcome back</h2>
          <p>
            Sign in to access your academic and campus services.
          </p>
        </div>

        <form onSubmit={handleSubmit} noValidate>
          <div className="auth-field">
            <label htmlFor="identifier">
              Email, Username or Registration Number
            </label>

            <input
              id="identifier"
              name="identifier"
              autoComplete="username"
              value={identifier}
              onChange={(e) => setIdentifier(e.target.value)}
              placeholder="Enter your account details"
              disabled={loading}
              required
            />
          </div>

          <div className="auth-field">
            <label htmlFor="password">Password</label>

            <div className="password-input">
              <input
                id="password"
                name="password"
                type={showPassword ? "text" : "password"}
                autoComplete="current-password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="Enter your password"
                disabled={loading}
                required
              />

              <button
                type="button"
                className="password-toggle"
                aria-label={
                  showPassword ? "Hide password" : "Show password"
                }
                onClick={() => setShowPassword((v) => !v)}
              >
                {showPassword ? <EyeOff /> : <Eye />}
              </button>
            </div>
          </div>

          <div className="auth-options">
            <label className="remember-option">
              <input
                type="checkbox"
                checked={rememberMe}
                onChange={(e) =>
                  setRememberMe(e.target.checked)
                }
                disabled={loading}
              />
              <span>Remember me</span>
            </label>

            <Link to="/portal/forgot-password">
              Forgot password?
            </Link>
          </div>

          {error && (
            <div
              className="auth-error"
              role="alert"
              aria-live="assertive"
            >
              {error}
            </div>
          )}

          <button
            type="submit"
            className="auth-submit"
            disabled={loading}
          >
            {loading ? (
              <>
                <Loader2 className="spin" size={20} />
                Signing in...
              </>
            ) : (
              <>
                Sign in to Portal
                <ArrowRight size={20} />
              </>
            )}
          </button>
        </form>

        <div className="auth-security">
          <ShieldCheck size={18} />
          <span>
            Secure access to your college account
          </span>
        </div>

        <div className="auth-links">
          <Link to="/portal/activate">
            Activate your account
          </Link>
        </div>

        <footer className="auth-footer">
          <p>
            HI-TECH College · Kitengela Campus
          </p>
          <p>
            Need assistance? Contact the ICT Support Desk.
          </p>
        </footer>
      </section>
    </main>
  );
}

4. Update the authentication contract
The login screen requires identifier and rememberMe. Extend the existing authentication types instead of creating a second authentication system.

src/auth/auth-types.ts
Add or replace the login request interface:


export interface LoginRequest {
  identifier: string;
  password: string;
  rememberMe?: boolean;
}

src/auth/auth-api.ts
Extend the existing API service.


export interface PasswordRecoveryRequest {
  identifier: string;
}

export interface PasswordResetRequest {
  token: string;
  password: string;
}

export interface AccountActivationRequest {
  token: string;
  password: string;
}

export const authApi = {
  // Keep your existing login, me, logout,
  // password change and profile completion methods.

  async forgotPassword(
    data: PasswordRecoveryRequest
  ): Promise<void> {
    await request<void>(
      "/api/auth/password/forgot",
      {
        method: "POST",
        body: JSON.stringify(data),
      }
    );
  },

  async resetPassword(
    data: PasswordResetRequest
  ): Promise<void> {
    await request<void>(
      "/api/auth/password/reset",
      {
        method: "POST",
        body: JSON.stringify(data),
      }
    );
  },

  async activateAccount(
    data: AccountActivationRequest
  ): Promise<void> {
    await request<void>(
      "/api/auth/activate",
      {
        method: "POST",
        body: JSON.stringify(data),
      }
    );
  },
};

Integration note

The request() helper above refers to the helper in the existing auth API service. If it is not exported or is differently named, reuse the existing HTTP wrapper. Do not introduce a duplicate API client. The endpoint names are proposed contracts, not verified endpoints.

Login payload
The web client should submit:


{
  "identifier": "HCA/STD/2026/001",
  "password": "user-entered-password",
  "rememberMe": true
}

The API should resolve the identifier to the correct account and enforce account status, role, permissions, password policy and session security.

5. Forgot password page
src/modules/auth/ForgotPasswordPage.tsx

import { FormEvent, useState } from "react";
import { Link } from "react-router-dom";
import { ArrowLeft, Loader2, Mail } from "lucide-react";
import { authApi } from "../../auth/auth-api";
import "./auth-pages.css";

export default function ForgotPasswordPage() {
  const [identifier, setIdentifier] = useState("");
  const [loading, setLoading] = useState(false);
  const [sent, setSent] = useState(false);
  const [error, setError] = useState("");

  async function handleSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setError("");
    setLoading(true);

    try {
      await authApi.forgotPassword({
        identifier: identifier.trim(),
      });

      setSent(true);
    } catch {
      setError("Unable to process your request. Please try again.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="auth-page">
      <section className="auth-card auth-card-small">
        <div className="auth-icon-circle">
          <Mail size={26} />
        </div>

        <h2>Forgot your password?</h2>

        <p>
          Enter your registered email, username or registration
          number to request password recovery.
        </p>

        {!sent ? (
          <form onSubmit={handleSubmit}>
            <div className="auth-field">
              <label htmlFor="recovery-identifier">
                Account identifier
              </label>

              <input
                id="recovery-identifier"
                value={identifier}
                onChange={(e) => setIdentifier(e.target.value)}
                placeholder="Email or registration number"
                autoComplete="username"
                required
              />
            </div>

            {error && (
              <div className="auth-error" role="alert">
                {error}
              </div>
            )}

            <button
              className="auth-submit"
              disabled={loading}
              type="submit"
            >
              {loading ? (
                <>
                  <Loader2 className="spin" />
                  Processing...
                </>
              ) : (
                "Request password reset"
              )}
            </button>
          </form>
        ) : (
          <div className="auth-success" role="status">
            <h3>Request submitted</h3>
            <p>
              If your account is eligible, recovery instructions
              will be sent through the registered contact channel.
            </p>
          </div>
        )}

        <Link className="auth-back-link" to="/portal/login">
          <ArrowLeft size={18} />
          Back to login
        </Link>
      </section>
    </main>
  );
}

6. Reset password page
src/modules/auth/ResetPasswordPage.tsx
Users reach this page using a reset token from a verified email or other approved recovery channel.


import { FormEvent, useState } from "react";
import { Link, useSearchParams } from "react-router-dom";
import { authApi } from "../../auth/auth-api";
import "./auth-pages.css";

export default function ResetPasswordPage() {
  const [params] = useSearchParams();
  const token = params.get("token") || "";

  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);
  const [error, setError] = useState("");

  async function handleSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setError("");

    if (!token) {
      setError("The reset link is invalid or unavailable.");
      return;
    }

    if (password.length < 12) {
      setError("Your password must contain at least 12 characters.");
      return;
    }

    if (password !== confirmPassword) {
      setError("Your passwords do not match.");
      return;
    }

    setLoading(true);

    try {
      await authApi.resetPassword({
        token,
        password,
      });

      setSuccess(true);
    } catch {
      setError(
        "Password reset failed. Your link may have expired."
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="auth-page">
      <section className="auth-card auth-card-small">
        <h2>Reset password</h2>

        {!success ? (
          <form onSubmit={handleSubmit}>
            <div className="auth-field">
              <label htmlFor="new-password">New password</label>
              <input
                id="new-password"
                type="password"
                autoComplete="new-password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                minLength={12}
                required
              />
            </div>

            <div className="auth-field">
              <label htmlFor="confirm-password">
                Confirm password
              </label>
              <input
                id="confirm-password"
                type="password"
                autoComplete="new-password"
                value={confirmPassword}
                onChange={(e) =>
                  setConfirmPassword(e.target.value)
                }
                required
              />
            </div>

            {error && (
              <div className="auth-error" role="alert">
                {error}
              </div>
            )}

            <button
              type="submit"
              className="auth-submit"
              disabled={loading}
            >
              {loading ? "Resetting..." : "Reset password"}
            </button>
          </form>
        ) : (
          <div className="auth-success" role="status">
            <h3>Password updated</h3>
            <p>
              Your password has been changed. You can now sign in.
            </p>
            <Link to="/portal/login">Sign in</Link>
          </div>
        )}

        {!success && (
          <Link className="auth-back-link" to="/portal/login">
            Back to login
          </Link>
        )}
      </section>
    </main>
  );
}

