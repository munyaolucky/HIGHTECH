export default function Header({ theme, toggleTheme }: HeaderProps) {
  const [mobileOpen, setMobileOpen] = useState(false);
  const [expanded, setExpanded] = useState("");

  return (
    <header className="site-header">
      <div className="topbar">
        <div className="container topbar-inner">
          <div className="top-contact">
            <a href="tel:+254700123456">+254 700 123 456</a>
            <a href="mailto:admissions@hitech.ac.ke">
              admissions@hitech.ac.ke
            </a>
            <span>Kitengela, Kenya</span>
          </div>
          <div className="portal-links">
            <Link to="/student-login">Student Portal</Link>
            <Link to="/staff-login">Staff Portal</Link>
            <Link to="/parent-login">Parent Portal</Link>
          </div>
        </div>
      </div>

      <div className="nav-wrapper">
        <div className="container nav-inner">
          <Link to="/" className="brand">
            <div className="brand-icon">
              <GraduationCap size={35} />
            </div>
            <div>
              <strong>HI-TECH COLLEGE</strong>
              <small>Learn. Innovate. Excel.</small>
            </div>
          </Link>

          <nav className={`main-nav ${mobileOpen ? "open" : ""}`}>
            <NavLink to="/" end onClick={() => setMobileOpen(false)}>
              Home
            </NavLink>

            {navigation.map((menu) => (
              <div className="nav-dropdown" key={menu.label}>
                <button
                  className="nav-menu-button"
                  onClick={() =>
                    setExpanded(expanded === menu.label ? "" : menu.label)
                  }
                  aria-expanded={expanded === menu.label}
                >
                  {menu.label}
                  <ChevronDown size={15} />
                </button>

                <div
                  className={`dropdown-content ${
                    expanded === menu.label ? "dropdown-visible" : ""
                  }`}
                >
                  {menu.links.map(([label, path]) => (
                    <Link
                      key={path}
                      to={path}
                      onClick={() => {
                        setMobileOpen(false);
                        setExpanded("");
                      }}
                    >
                      {label}
                    </Link>
                  ))}
                </div>
              </div>
            ))}

            <NavLink to="/news" onClick={() => setMobileOpen(false)}>
              News
            </NavLink>
            <NavLink to="/contact" onClick={() => setMobileOpen(false)}>
              Contact
            </NavLink>

            <Link
              className="mobile-apply"
              to="/apply"
              onClick={() => setMobileOpen(false)}
            >
              Apply Online
            </Link>
          </nav>

          <div className="nav-actions">
            <button
              className="icon-button"
              onClick={toggleTheme}
              aria-label="Toggle theme"
            >
              {theme === "dark" ? <Sun /> : <Moon />}
            </button>
            <Link to="/apply" className="btn btn-primary desktop-apply">
              Apply Online
            </Link>
            <button
              className="mobile-toggle icon-button"
              onClick={() => setMobileOpen(!mobileOpen)}
              aria-label="Toggle navigation"
              aria-expanded={mobileOpen}
            >
              {mobileOpen ? <X /> : <Menu />}
            </button>
          </div>
        </div>
      </div>
    </header>
  );
}

