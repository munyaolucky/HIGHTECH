import { useMemo, useState } from "react";
import { Link, useSearchParams } from "react-router-dom";
import { Search, ArrowRight } from "lucide-react";
import CourseCard from "../components/CourseCard";
import { programmes, departments } from "../data/college";

export default function Academics() {
  const [params] = useSearchParams();
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState(
    params.get("category") || "All"
  );
  const [department, setDepartment] = useState("All");

  const filtered = useMemo(() => {
    return programmes.filter(p => {
      const matchSearch =
        `${p.name} ${p.code} ${p.department}`
          .toLowerCase().includes(search.toLowerCase());

      const matchCategory =
        category === "All" || p.category === category;

      const matchDepartment =
        department === "All" || p.department === department;

      return matchSearch && matchCategory && matchDepartment;
    });
  }, [search, category, department]);

  return (
    <>
      <section className="page-banner">
        <div className="container">
          <span>ACADEMIC EXCELLENCE</span>
          <h1>Our Academic Programmes</h1>
          <p>Discover courses designed to develop practical skills and knowledge.</p>
        </div>
      </section>

      <section className="section">
        <div className="container">
          <div className="programme-intro">
            <h2>Find Your Programme</h2>
            <p>Search our available programmes and choose your preferred course.</p>
          </div>

          <div className="programme-filters">
            <label className="search-field">
              <Search size={19} />
              <input
                value={search}
                onChange={e => setSearch(e.target.value)}
                placeholder="Search courses, departments or codes..."
              />
            </label>

            <select value={category}
              onChange={e => setCategory(e.target.value)}>
              {["All", "Diploma", "Certificate", "Professional", "Short Course"]
                .map(x => <option key={x}>{x}</option>)}
            </select>

            <select value={department}
              onChange={e => setDepartment(e.target.value)}>
              <option value="All">All Departments</option>
              {departments.map(x => <option key={x}>{x}</option>)}
            </select>
          </div>

          <p className="result-count">
            Showing {filtered.length} programme(s)
          </p>

          <div className="course-grid">
            {filtered.map(p => (
              <CourseCard key={p.id} programme={p} />
            ))}
          </div>

          {filtered.length === 0 && (
            <div className="empty-state">
              <Search size={35} />
              <h3>No programmes found</h3>
              <p>Try changing your search or filters.</p>
              <button className="btn btn-primary"
                onClick={() => {
                  setSearch("");
                  setCategory("All");
                  setDepartment("All");
                }}>
                Clear filters
              </button>
            </div>
          )}

          <div className="admission-cta compact-cta">
            <div>
              <h2>Need help choosing a course?</h2>
              <p>Contact our admissions team for guidance.</p>
            </div>
            <Link to="/contact" className="btn btn-primary">
              Contact Admissions <ArrowRight />
            </Link>
          </div>
        </div>
      </section>
    </>
  );
}

