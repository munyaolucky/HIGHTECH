This stylesheet establishes the institutional theme, typography, responsive layout, navigation, cards, forms, homepage, footer and dark mode.


/* =========================================
   HI-TECH COLLEGE DESIGN SYSTEM
========================================= */

:root {
  font-family: "Inter", sans-serif;
  color-scheme: light;

  --primary: #153b70;
  --primary-light: #2457a7;
  --accent: #d92332;
  --accent-hover: #b91e2b;

  --background: #ffffff;
  --surface: #ffffff;
  --surface-soft: #f1f5fa;
  --surface-blue: #eaf1fa;

  --text: #172033;
  --muted: #64748b;
  --border: #e2e8f0;

  --success: #16845b;
  --shadow: 0 8px 28px rgba(21, 59, 112, 0.09);

  --radius: 14px;
  --radius-lg: 22px;
  --container: 1200px;
}

[data-theme="dark"] {
  color-scheme: dark;

  --background: #101827;
  --surface: #172438;
  --surface-soft: #1d2c42;
  --surface-blue: #203754;

  --text: #f1f5f9;
  --muted: #a8b6c9;
  --border: #304157;

  --shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-size: 15px;
  line-height: 1.65;
  transition: background 0.2s, color 0.2s;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(var(--container), calc(100% - 40px));
  margin-inline: auto;
}

.section {
  padding: 80px 0;
}

.soft-section {
  background: var(--surface-soft);
}

h1, h2, h3, h4, p {
  margin-top: 0;
}

h1, h2, h3 {
  line-height: 1.2;
  letter-spacing: -0.035em;
}

h1 {
  font-size: clamp(2.3rem, 5vw, 4rem);
}

h2 {
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  color: var(--primary);
}

[data-theme="dark"] h2 {
  color: #b9d5ff;
}

h3 {
