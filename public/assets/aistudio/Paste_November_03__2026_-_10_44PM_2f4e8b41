export default function Contact() {
  const [sent, setSent] = useState(false);
  const [form, setForm] = useState({
    name: "",
    email: "",
    subject: "",
    message: ""
  });

  function submit(e: React.FormEvent) {
    e.preventDefault();

    // Connect to POST /api/public/enquiries before enabling
    // actual enquiry transmission.
    setSent(true);
  }

  return (
    <>
      <section className="page-banner">
        <div className="container">
          <span>GET IN TOUCH</span>
          <h1>Contact HI-TECH College</h1>
          <p>We welcome your enquiries and feedback.</p>
        </div>
      </section>

      <section className="section">
        <div className="container contact-grid">
          <div>
            <h2>Contact Information</h2>
            <p>Reach the college through our official communication channels.</p>

            <div className="contact-item">
              <MapPin />
              <div><strong>Location</strong><p>{college.address}</p></div>
            </div>

            <div className="contact-item">
              <Phone />
              <div><strong>Telephone</strong><p>{college.phone}</p></div>
            </div>

            <div className="contact-item">
              <Mail />
              <div><strong>Email</strong><p>{college.email}</p></div>
            </div>
          </div>

          <form className="application-form" onSubmit={submit}>
            <h2>Send an Enquiry</h2>

            {sent ? (
              <div className="success-panel">
                <h3>Enquiry form completed</h3>
                <p>
                  The frontend demonstration is complete. No enquiry
                  has been sent until the backend endpoint is connected.
                </p>
                <button type="button" className="btn btn-primary"
                  onClick={() => setSent(false)}>
                  Send another enquiry
                </button>
              </div>
            ) : (
              <>
                <label className="form-field">
                  <span>Full Name</span>
                  <input required value={form.name}
                    onChange={e => setForm({ ...form, name: e.target.value })} />
                </label>

                <label className="form-field">
                  <span>Email Address</span>
                  <input required type="email" value={form.email}
                    onChange={e => setForm({ ...form, email: e.target.value })} />
                </label>

                <label className="form-field">
                  <span>Subject</span>
                  <input required value={form.subject}
                    onChange={e => setForm({ ...form, subject: e.target.value })} />
                </label>

                <label className="form-field">
                  <span>Message</span>
                  <textarea required rows={5} value={form.message}
                    onChange={e => setForm({ ...form, message: e.target.value })} />
                </label>

                <button className="btn btn-primary" type="submit">
                  Send Enquiry <Send size={17} />
                </button>
              </>
            )}
          </form>
        </div>
      </section>

      <section className="map-section">
        <iframe
          title="HI-TECH College location map"
          src="https://www.openstreetmap.org/export/embed.html?bbox=36.85%2C-1.45%2C37.05%2C-1.30&layer=mapnik"
          loading="lazy"
          referrerPolicy="no-referrer"
        />
      </section>
    </>
  );
}

