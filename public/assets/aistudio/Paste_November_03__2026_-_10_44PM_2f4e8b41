25. Important TypeScript corrections
For the application form, use this safer update handler:

const update = (
  e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>
) => {
  const target = e.target;
  const name = target.name as keyof typeof form;

  const value =
    target instanceof HTMLInputElement &&
    target.type === "checkbox"
      ? target.checked
      : target.value;

  setForm(old => ({
    ...old,
    [name]: value
  }) as typeof form);
};

