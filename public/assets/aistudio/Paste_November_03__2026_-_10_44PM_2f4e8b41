import { useEffect, useState } from "react";
import {
  BrowserRouter,
  Routes,
  Route,
  Link
} from "react-router-dom";

import Header from "./components/Header";
import Footer from "./components/Footer";

import Home from "./pages/Home";
import About from "./pages/About";
import Academics from "./pages/Academics";
import CourseDetails from "./pages/CourseDetails";
import Admissions from "./pages/Admissions";
import Apply from "./pages/Apply";
import CampusLife from "./pages/CampusLife";
import News from "./pages/News";
import Resources from "./pages/Resources";
import Contact from "./pages/Contact";
import NotFound from "./pages/NotFound";

import "./styles.css";

function PortalAccess({ role }: { role: string }) {
  return (
    <section className="portal-access">
      <div className="portal-access-card">
        <div className="brand-icon"><span>HT</span></div>
        <h1>{role} Portal</h1>
        <p>
          Access the official HI-TECH College {role.toLowerCase()} services.
        </p>
        <p className="portal-notice">
          Portal authentication and account services must be connected
          to the institutional authentication API.
        </p>
        <Link to="/" className="btn btn-primary">Return to Website</Link>
      </div>
    </section>
  );
}

function AppContent() {
  const [theme, setTheme] = useState(
    () => localStorage.getItem("hitech-theme") || "light"
  );

  useEffect(() => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("hitech-theme", theme);
  }, [theme]);

  function toggleTheme() {
    setTheme(old => old === "light" ? "dark" : "light");
  }

  return (
    <>
      <Header theme={theme} toggleTheme={toggleTheme} />

      <main>
        <Routes>
          <Route path="/" element={<Home />} />
          <Route path="/about" element={<About />} />
          <Route path="/academics" element={<Academics />} />
          <Route path="/academics/:id" element={<CourseDetails />} />
          <Route path="/admissions" element={<Admissions />} />
          <Route path="/apply" element={<Apply />} />
          <Route path="/campus-life" element={<CampusLife />} />
          <Route path="/news" element={<News />} />
          <Route path="/resources" element={<Resources />} />
          <Route path="/contact" element={<Contact />} />

          <Route path="/student-login"
            element={<PortalAccess role="Student" />} />
          <Route path="/staff-login"
            element={<PortalAccess role="Staff" />} />
          <Route path="/parent-login"
            element={<PortalAccess role="Parent" />} />

          <Route path="*" element={<NotFound />} />
        </Routes>
      </main>

      <Footer />
    </>
  );
}

export default function App() {
  return (
    <BrowserRouter>
      <AppContent />
    </BrowserRouter>
  );
}

