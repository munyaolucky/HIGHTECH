generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  LOCKED
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  REGISTERED
  ACTIVE
  DEFERRED
  SUSPENDED
  DISCONTINUED
  TRANSFERRED
  COMPLETED
  GRADUATED
  ALUMNI
}

enum AcademicPeriodStatus {
  PLANNED
  REGISTRATION_OPEN
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  PUBLISH
  REVOKE
  OTHER
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  email       String?
  phone       String?
  website     String?
  address     String?
  logoUrl     String?
  timezone    String   @default("Africa/Nairobi")
  isActive    Boolean  @default(true)

  campuses    Campus[]
  users       User[]
  departments Department[]
  students    Student[]
  academicYears AcademicYear[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campus {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  code          String
  address       String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)

  institution   Institution @relation(fields: [institutionId], references: [id])
  users         UserCampus[]
  students      Student[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Department {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  code          String
  description   String?
  isActive      Boolean  @default(true)

  institution   Institution @relation(fields: [institutionId], references: [id])
  users         User[]
  students      Student[]
  programmes    Programme[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model User {
  id              String        @id @default(cuid())
  institutionId   String
  departmentId    String?
  firstName       String
  middleName      String?
  lastName        String
  email           String        @unique
  phone           String?
  passwordHash    String
  status          AccountStatus @default(PENDING)
  mustChangePassword Boolean    @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  failedLoginCount Int          @default(0)
  lockedUntil     DateTime?
  mfaEnabled      Boolean       @default(false)

  institution     Institution @relation(fields: [institutionId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  roleAssignments UserRole[]
  campuses        UserCampus[]
  sessions        Session[]
  auditLogs       AuditLog[]   @relation("AuditActor")

