This provides the initial applicant form and validation. Actual submission, document storage, application reference generation and registrar approval must be connected to the admissions API.


import { useState } from "react";
import { programmes } from "../data/college";

export default function Apply() {
  const [submitted, setSubmitted] = useState(false);
  const [form, setForm] = useState({
    firstName: "",
    lastName: "",
    email: "",
    phone: "",
    gender: "",
    courseId: "",
    intake: "",
    education: "",
    consent: false
  });

  const update = (e: React.ChangeEvent<
    HTMLInputElement | HTMLSelectElement
  >) => {
    const target = e.target;
    const value = target instanceof HTMLInputElement &&
      target.type === "checkbox" ? target.checked : target.value;

    setForm(old => ({ ...old, [target.name]: value }));
  };

  function submit(e: React.FormEvent) {
    e.preventDefault();

    if (!form.courseId || !form.consent) return;

    // Connect this form to POST /api/admissions/applications.
    // Do not display a successful admission or reference number
    // until the server confirms that it has saved the application.
    setSubmitted(true);
  }

  return (
    <>
      <section className="page-banner">
        <div className="container">
          <span>ADMISSIONS</span>
          <h1>Online Application</h1>
          <p>Start your application to HI-TECH College.</p>
        </div>
      </section>

      <section className="section">
        <div className="container form-container">
          {submitted ? (
            <div className="success-panel">
              <h2>Application form completed</h2>
              <p>
                This is a frontend demonstration. Your application
                has not been transmitted or registered. Connect the
                admissions API to enable submission.
              </p>
              <button className="btn btn-primary"
                onClick={() => setSubmitted(false)}>
                Return to form
              </button>
            </div>
          ) : (
            <form className="application-form" onSubmit={submit}>
              <h2>Applicant Information</h2>
              <p>Enter accurate information in the required fields.</p>

              <div className="form-grid">
                <Field label="First Name">
                  <input required name="firstName"
                    value={form.firstName} onChange={update} />
                </Field>

                <Field label="Last Name">
                  <input required name="lastName"
                    value={form.lastName} onChange={update} />
                </Field>

                <Field label="Email Address">
                  <input required type="email" name="email"
                    value={form.email} onChange={update} />
                </Field>

                <Field label="Phone Number">
                  <input required type="tel" name="phone"
                    value={form.phone} onChange={update} />
                </Field>

                <Field label="Gender">
                  <select required name="gender"
                    value={form.gender} onChange={update}>
                    <option value="">Select</option>
                    <option>Female</option>
                    <option>Male</option>
                    <option>Prefer not to say</option>
                  </select>
                </Field>

                <Field label="Academic Qualification">
                  <select required name="education"
                    value={form.education} onChange={update}>
                    <option value="">Select</option>
                    <option>KCSE</option>
                    <option>Certificate</option>
                    <option>Diploma</option>
                    <option>Degree</option>
                    <option>Other</option>
                  </select>
                </Field>

                <Field label="Programme">
                  <select required name="courseId"
                    value={form.courseId} onChange={update}>
                    <option value="">Select programme</option>
                    {programmes.map(p => (
                      <option key={p.id} value={p.id}>{p.name}</option>
                    ))}
                  </select>
                </Field>

                <Field label="Preferred Intake">
                  <select required name="intake"
                    value={form.intake} onChange={update}>
                    <option value="">Select intake</option>
                    <option>January 2027</option>
                    <option>May 2027</option>
                    <option>September 2027</option>
                  </select>
                </Field>
              </div>

              <label className="consent-check">
                <input type="checkbox" name="consent"
                  checked={form.consent} onChange={update} required />
                I consent to the processing of my application information
                in accordance with the college privacy policy.
              </label>

              <button type="submit" className="btn btn-primary btn-large">
                Submit Application
              </button>
            </form>
          )}
        </div>
      </section>
    </>
  );
}

function Field({ label, children }: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <label className="form-field">
      <span>{label}</span>
      {children}
    </label>
  );
}

