async function main() {
  for (const permission of permissions) {
    await prisma.permission.upsert({
      where: { code: permission.code },
      update: { description: permission.description },
      create: permission
    });
  }

  for (const [roleName, permissionCodes] of Object.entries(roleDefinitions)) {
    const role = await prisma.role.upsert({
      where: { name: roleName },
      update: {
        description: `${roleName.replaceAll("_", " ")} system role`
      },
      create: {
        name: roleName,
        description: `${roleName.replaceAll("_", " ")} system role`,
        isSystem: true
      }
    });

    const rolePermissions = await prisma.permission.findMany({
      where: {
        code: { in: permissionCodes }
      },
      select: { id: true }
    });

    await prisma.$transaction([
      prisma.rolePermission.deleteMany({
        where: { roleId: role.id }
      }),
      prisma.rolePermission.createMany({
        data: rolePermissions.map((permission) => ({
          roleId: role.id,
          permissionId: permission.id
        })),
        skipDuplicates: true
      })
    ]);
  }

  console.log("HI-TECH system roles and permissions seeded.");
}

main()
  .catch((error) => {
    console.error(error);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });

