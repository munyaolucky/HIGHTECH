import { Request, Response, NextFunction } from "express";

export type LecturerPermission =
  | "lecturer:dashboard:read"
  | "lecturer:profile:read"
  | "lecturer:profile:update"
  | "lecturer:assignments:read"
  | "lecturer:students:read"
  | "lecturer:lesson:create"
  | "lecturer:attendance:manage"
  | "lecturer:materials:manage"
  | "lecturer:assessment:manage"
  | "lecturer:marking:manage"
  | "lecturer:results:submit";

export interface AuthenticatedRequest extends Request {
  user?: {
    id: string;
    institutionId: string;
    role: string;
    permissions: string[];
  };
}

export function requireLecturerPermission(
  permission: LecturerPermission
) {
  return (
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
  ) => {
    if (!req.user) {
      return res.status(401).json({
        message: "Authentication required"
      });
    }

    if (
      !["LECTURER", "TRAINER", "INSTRUCTOR", "PRACTICAL_ASSESSOR"].includes(
        req.user.role
      )
    ) {
      return res.status(403).json({
        message: "Lecturer portal access required"
      });
    }

    if (!req.user.permissions.includes(permission)) {
      return res.status(403).json({
        message: "You do not have permission to perform this action"
      });
    }

    next();
  };
}

Your existing authentication middleware must populate req.user. Permissions must come from the institutional role and access-policy system, not from values supplied by the browser.

