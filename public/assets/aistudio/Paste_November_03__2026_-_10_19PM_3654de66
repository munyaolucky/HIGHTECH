import { Request, Response } from "express";
import { lecturerProfileService } from "./lecturer.profile.service";

interface LecturerRequest extends Request {
  lecturerId?: string;
}

export async function getLecturerProfile(
  req: LecturerRequest,
  res: Response
) {
  try {
    const profile = await lecturerProfileService.getProfile(
      req.lecturerId!
    );

    if (!profile) {
      return res.status(404).json({
        message: "Lecturer profile not found"
      });
    }

    return res.json({ success: true, data: profile });
  } catch {
    return res.status(500).json({
      message: "Unable to retrieve lecturer profile"
    });
  }
}

export async function requestProfileCorrection(
  req: LecturerRequest,
  res: Response
) {
  try {
    const { fieldName, newValue, reason } = req.body;

    if (
      typeof fieldName !== "string" ||
      typeof newValue !== "string" ||
      typeof reason !== "string" ||
      !newValue.trim() ||
      !reason.trim()
    ) {
      return res.status(400).json({
        message: "Field, new value and reason are required"
      });
    }

    const result =
      await lecturerProfileService.requestCorrection(
        req.lecturerId!,
        fieldName,
        newValue.trim(),
        reason.trim()
      );

    return res.status(201).json({
      success: true,
      message: "Correction request submitted to HR",
      data: result
    });
  } catch (error) {
    return res.status(400).json({
      message: error instanceof Error
        ? error.message
        : "Unable to submit correction"
    });
  }
}

export async function getProfileCorrections(
  req: LecturerRequest,
  res: Response
) {
  try {
    const data =
      await lecturerProfileService.getCorrectionRequests(
        req.lecturerId!
      );

    return res.json({ success: true, data });
  } catch {
    return res.status(500).json({
      message: "Unable to retrieve correction requests"
    });
  }
}

The lecturerId request property must be populated by a trusted backend middleware after resolving the authenticated user's existing staff record. Never accept it from the request body.

