import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

export class LaboratoryService {
  async getEquipment(campusId: string, laboratoryId: string) {
    return prisma.laboratoryEquipment.findMany({
      where: {
        campusId,
        laboratoryId,
        condition: { not: "DISPOSED" }
      },
      orderBy: { equipmentName: "asc" }
    });
  }

  async reportFault(
    lecturerId: string,
    equipmentId: string,
    description: string,
    priority: string
  ) {
    if (!description.trim()) {
      throw new Error("Fault description is required");
    }

    if (!["LOW", "NORMAL", "HIGH", "URGENT"].includes(priority)) {
      throw new Error("Invalid fault priority");
    }

    const equipment =
      await prisma.laboratoryEquipment.findUnique({
        where: { id: equipmentId }
      });

    if (!equipment) {
      throw new Error("Equipment not found");
    }

    // In production, verify the lecturer's campus and
    // laboratory access before allowing the report.

    return prisma.$transaction(async tx => {
      const fault = await tx.equipmentFault.create({
        data: {
          equipmentId,
          reportedBy: lecturerId,
          description: description.trim(),
          priority,
          status: "REPORTED"
        }
      });

      if (priority === "URGENT") {
        await tx.laboratoryEquipment.update({
          where: { id: equipmentId },
          data: { condition: "DAMAGED" }
        });
      }

      return fault;
    });
  }

  async getFaults(campusId: string) {
    return prisma.equipmentFault.findMany({
      where: {
        equipment: { campusId }
      },
      include: {
        equipment: true
      },
      orderBy: { reportedAt: "desc" }
    });
  }
}

