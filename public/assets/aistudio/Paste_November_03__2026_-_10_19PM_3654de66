10. Add questions to an assessment
The lecturer selects questions from the approved question bank. The system must verify that each selected question belongs to the lecturer's assigned unit or is shared with that lecturer by an authorized administrator.

Add this method to assessments.service.ts:


async addQuestions(
  lecturerId: string,
  assessmentId: string,
  selected: Array<{ questionId: string; marks: number }>
) {
  if (!selected.length) {
    throw new Error("Select at least one question");
  }

  if (
    new Set(selected.map(x => x.questionId)).size !== selected.length ||
    selected.some(x => !Number.isFinite(x.marks) || x.marks <= 0)
  ) {
    throw new Error("Invalid question selection");
  }

  return prisma.$transaction(async tx => {
    const assessment = await tx.lecturerAssessment.findFirst({
      where: {
        id: assessmentId,
        lecturerId,
        status: "DRAFT"
      }
    });

    if (!assessment) {
      throw new Error("Draft assessment not found");
    }

    const questions = await tx.lecturerQuestion.findMany({
      where: {
        id: { in: selected.map(x => x.questionId) },
        lecturerId,
        assignmentId: assessment.assignmentId
      }
    });

    if (questions.length !== selected.length) {
      throw new Error(
        "One or more questions are unavailable for this unit"
      );
    }

    const current = await tx.lecturerAssessmentQuestion.findMany({
      where: { assessmentId }
    });

    const existingIds = new Set(current.map(q => q.questionId));

    if (selected.some(q => existingIds.has(q.questionId))) {
      throw new Error("A selected question is already attached");
    }

    const nextOrder = current.length + 1;

    await tx.lecturerAssessmentQuestion.createMany({
      data: selected.map((question, index) => ({
        assessmentId,
        questionId: question.questionId,
        orderNumber: nextOrder + index,
        marks: new Prisma.Decimal(question.marks)
      }))
    });

    const updated = await tx.lecturerAssessmentQuestion.findMany({
      where: { assessmentId }
    });

    const total = updated.reduce(
      (sum, question) => sum + Number(question.marks),
      0
    );

    if (total > Number(assessment.totalMarks)) {
      throw new Error(
        "Attached question marks exceed the assessment total"
      );
    }

    return updated;
  });
}

