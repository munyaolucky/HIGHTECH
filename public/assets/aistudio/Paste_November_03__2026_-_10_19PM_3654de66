export function canManageQuestion(
  action: LecturerQuestionAction,
  question: {
    lecturerId: string;
    status: string;
  },
  currentLecturerId: string
) {
  if (question.lecturerId !== currentLecturerId) {
    return false;
  }

  if (
    action === "question:update" ||
    action === "question:archive"
  ) {
    return question.status === "DRAFT";
  }

  return true;
