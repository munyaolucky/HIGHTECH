import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

export class LecturerSchemeService {
  async create(
    lecturerId: string,
    data: {
      assignmentId: string;
      title: string;
      academicYear: string;
      semester: string;
      weeks: {
        weekNumber: number;
        plannedDate?: string;
        topic: string;
        subtopic?: string;
        learningOutcome?: string;
        activities?: string;
        resources?: string;
        assessment?: string;
      }[];
    }
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: data.assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    if (!data.weeks.length) {
      throw new Error("Add at least one teaching week");
    }

    const numbers = data.weeks.map(w => w.weekNumber);

    if (
      new Set(numbers).size !== numbers.length ||
      data.weeks.some(w =>
        !Number.isInteger(w.weekNumber) ||
        w.weekNumber < 1 ||
        !w.topic.trim()
      )
    ) {
      throw new Error("Invalid weekly teaching plan");
    }

    return prisma.$transaction(async tx => {
      const scheme = await tx.schemeOfWork.create({
        data: {
          lecturerId,
          assignmentId: data.assignmentId,
          title: data.title,
          academicYear: data.academicYear,
          semester: data.semester,
          content: data.weeks,
          status: "DRAFT"
        }
      });

      await tx.schemeOfWorkWeek.createMany({
        data: data.weeks.map(week => ({
          schemeId: scheme.id,
          weekNumber: week.weekNumber,
          plannedDate: week.plannedDate
            ? new Date(week.plannedDate)
            : null,
          topic: week.topic,
          subtopic: week.subtopic,
          learningOutcome: week.learningOutcome,
          activities: week.activities,
          resources: week.resources,
          assessment: week.assessment
        }))
      });

      return tx.schemeOfWork.findUnique({
        where: { id: scheme.id },
        include: {
          // The weeks relation must be added to
          // SchemeOfWork in your Prisma schema.
        }
      });
    });
  }

  async list(lecturerId: string) {
    return prisma.schemeOfWork.findMany({
      where: { lecturerId },
      orderBy: { createdAt: "desc" }
    });
  }

  async updateProgress(
    lecturerId: string,
    weekId: string,
    data: {
      actualDate?: string;
      completed: boolean;
      remarks?: string;
    }
  ) {
    const week = await prisma.schemeOfWorkWeek.findFirst({
      where: {
        id: weekId,
        // Ownership is verified through the scheme below.
      }
    });

    if (!week) throw new Error("Teaching week not found");

    const scheme = await prisma.schemeOfWork.findFirst({
      where: {
        id: week.schemeId,
        lecturerId
      }
    });

    if (!scheme) throw new Error("Access denied");

    return prisma.schemeOfWorkWeek.update({
      where: { id: weekId },
      data: {
        actualDate: data.actualDate
          ? new Date(data.actualDate)
          : undefined,
        completed: data.completed,
        remarks: data.remarks
      }
    });
  }

  async submitForReview(
    lecturerId: string,
    schemeId: string
  ) {
    const scheme = await prisma.schemeOfWork.findFirst({
      where: {
        id: schemeId,
        lecturerId,
        status: { in: ["DRAFT", "REJECTED"] }
      }
    });

    if (!scheme) {
      throw new Error("Scheme cannot be submitted");
    }

    return prisma.schemeOfWork.update({
      where: { id: schemeId },
      data: { status: "SUBMITTED" }
    });
  }
}

