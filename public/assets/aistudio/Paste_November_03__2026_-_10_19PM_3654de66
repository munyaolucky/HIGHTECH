4. Assessment service
backend/src/modules/lecturer/assessments/assessments.service.ts

The service enforces assignment ownership, validates assessment dates and marks, and prevents lecturers from publishing an assessment before approval.


import { Prisma, PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

type CreateAssessmentInput = {
  assignmentId: string;
  title: string;
  instructions: string;
  assessmentType:
    | "CAT"
    | "ASSIGNMENT"
    | "THEORY_EXAM"
    | "PRACTICAL_EXAM"
    | "PROGRAMMING"
    | "NETWORKING_LAB"
    | "ICDL"
    | "ORAL"
    | "LANGUAGE"
    | "OTHER";
  totalMarks: number;
  passMark?: number;
  durationMinutes?: number;
  availableFrom?: string;
  availableUntil?: string;
  allowLate?: boolean;
  randomizeQuestions?: boolean;
};

export class LecturerAssessmentService {
  private async verifyAssignment(
    lecturerId: string,
    assignmentId: string
  ) {
    const assignment = await prisma.teachingAssignment.findFirst({
      where: {
        id: assignmentId,
        lecturerId,
        active: true
      }
    });

    if (!assignment) {
      throw new Error("You are not assigned to this teaching unit");
    }

    return assignment;
  }

  async create(
    lecturerId: string,
    input: CreateAssessmentInput
  ) {
    await this.verifyAssignment(lecturerId, input.assignmentId);

    if (!input.title.trim() || !input.instructions.trim()) {
      throw new Error("Title and instructions are required");
    }

    if (
      !Number.isFinite(input.totalMarks) ||
      input.totalMarks <= 0
    ) {
      throw new Error("Total marks must be greater than zero");
    }

    if (
      input.passMark !== undefined &&
      (
        !Number.isFinite(input.passMark) ||
        input.passMark < 0 ||
        input.passMark > input.totalMarks
      )
    ) {
      throw new Error("Invalid pass mark");
    }

    if (
      input.durationMinutes !== undefined &&
      (
        !Number.isInteger(input.durationMinutes) ||
        input.durationMinutes < 1 ||
        input.durationMinutes > 600
      )
    ) {
      throw new Error("Duration must be between 1 and 600 minutes");
    }

    const from = input.availableFrom
      ? new Date(input.availableFrom)
      : null;

    const until = input.availableUntil
      ? new Date(input.availableUntil)
      : null;

    if (
      (from && Number.isNaN(from.getTime())) ||
      (until && Number.isNaN(until.getTime())) ||
      (from && until && from >= until)
    ) {
      throw new Error("Invalid assessment availability period");
    }

    return prisma.lecturerAssessment.create({
      data: {
        lecturerId,
        assignmentId: input.assignmentId,
        title: input.title.trim(),
        instructions: input.instructions.trim(),
        assessmentType: input.assessmentType,
        totalMarks: new Prisma.Decimal(input.totalMarks),
        passMark: input.passMark === undefined
          ? null
          : new Prisma.Decimal(input.passMark),
        durationMinutes: input.durationMinutes,
        availableFrom: from,
        availableUntil: until,
        allowLate: input.allowLate ?? false,
        randomizeQuestions: input.randomizeQuestions ?? false,
        status: "DRAFT"
      }
    });
  }

  async list(lecturerId: string) {
    return prisma.lecturerAssessment.findMany({
      where: { lecturerId },
      orderBy: { createdAt: "desc" },
      include: {
        _count: {
          select: {
            questions: true,
            submissions: true
          }
        }
      }
    });
  }

  async getOne(lecturerId: string, assessmentId: string) {
    return prisma.lecturerAssessment.findFirst({
      where: {
        id: assessmentId,
        lecturerId
      },
      include: {
        questions: {
          orderBy: { orderNumber: "asc" }
        },
        _count: {
          select: { submissions: true }
        }
      }
    });
  }

  async requestApproval(
    lecturerId: string,
    assessmentId: string
  ) {
    const assessment =
      await prisma.lecturerAssessment.findFirst({
        where: {
          id: assessmentId,
          lecturerId
        },
        include: { questions: true }
      });

    if (!assessment) {
      throw new Error("Assessment not found");
    }

    if (assessment.status !== "DRAFT") {
      throw new Error("Only draft assessments can be submitted");
    }

    if (assessment.questions.length === 0) {
      throw new Error("Add at least one question before submission");
    }

    const questionTotal = assessment.questions.reduce(
      (sum, question) => sum + Number(question.marks),
      0
    );

    if (Math.abs(questionTotal - Number(assessment.totalMarks)) > 0.001) {
      throw new Error(
        "Question marks must add up to the assessment total"
      );
    }

    return prisma.lecturerAssessment.update({
      where: { id: assessmentId },
      data: { status: "PENDING_APPROVAL" }
    });
  }
}

export const lecturerAssessmentService =
  new LecturerAssessmentService();

