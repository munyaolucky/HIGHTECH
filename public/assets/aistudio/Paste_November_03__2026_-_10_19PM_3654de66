import { useEffect, useState } from "react";
import { Search, Download, UserRound } from "lucide-react";
import { useParams } from "react-router-dom";

export default function ClassStudents() {
  const { assignmentId } = useParams();

  const [students, setStudents] = useState<any[]>([]);
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function loadStudents(query = "") {
    const response = await fetch(
      `/api/lecturer/classes/${assignmentId}/students?search=${encodeURIComponent(query)}`,
      { credentials: "include" }
    );

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.message || "Failed to load students");
    }

    setStudents(result.data);
  }

  useEffect(() => {
    loadStudents()
      .catch(e => setError(e.message))
      .finally(() => setLoading(false));
  }, [assignmentId]);

  function exportCSV() {
    const headers = [
      "Registration Number",
      "Student Name",
      "Official Email",
      "Enrolment Status"
    ];

    const rows = students.map(item => [
      item.student.registrationNumber,
      `${item.student.firstName} ${item.student.lastName}`,
      item.student.officialEmail || "",
      item.status
    ]);

    const csv = [headers, ...rows]
      .map(row =>
        row.map(value =>
          `"${String(value ?? "").replace(/"/g, '""')}"`
        ).join(",")
      )
      .join("\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "class-student-register.csv";
    link.click();

    URL.revokeObjectURL(url);
  }

  const filtered = students.filter(item => {
    const student = item.student;
    const name = `${student.firstName} ${student.lastName}`;

    return `${name} ${student.registrationNumber}`
      .toLowerCase()
      .includes(search.toLowerCase());
  });

  return (
    <div>
      <div className="page-heading">
        <div>
          <h1>Class Student Register</h1>
          <p>Official list of students enrolled in your unit.</p>
        </div>

        <button className="primary-button" onClick={exportCSV}>
          <Download size={17} /> Export Register
        </button>
      </div>

      <div className="search-box">
        <Search size={18} />
        <input
          placeholder="Search student or registration number..."
          value={search}
          onChange={e => setSearch(e.target.value)}
        />
      </div>

      {error && <div className="error-message">{error}</div>}

      <div className="dashboard-panel">
        <h3>Enrolled Students: {students.length}</h3>

        {loading ? (
          <p>Loading student register...</p>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table className="student-table">
              <thead>
                <tr>
                  <th>Registration Number</th>
                  <th>Student Name</th>
                  <th>Email</th>
                  <th>Enrolment</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody>
                {filtered.map(item => (
                  <tr key={item.id}>
                    <td>{item.student.registrationNumber}</td>
                    <td>
                      {item.student.firstName}{" "}
                      {item.student.lastName}
                    </td>
                    <td>{item.student.officialEmail || "—"}</td>
                    <td>{item.status}</td>
                    <td>
                      <button
                        onClick={() =>
                          window.location.assign(
                            `/lecturer/classes/${assignmentId}/students/${item.student.id}`
                          )
                        }
                      >
                        <UserRound size={15} /> View
                      </button>
                    </td>
                  </tr>
                ))}

                {filtered.length === 0 && (
