  const [correctOptionIds, setCorrectOptionIds] = useState<string[]>([]);
  const [expectedAnswer, setExpectedAnswer] = useState("");
  const [explanation, setExplanation] = useState("");
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");

  const isChoice =
    type === "MCQ_SINGLE" || type === "MCQ_MULTIPLE";

  const isBoolean = type === "TRUE_FALSE";
  const isText =
    type === "SHORT_ANSWER" || type === "LONG_ANSWER";
  const isNumeric = type === "NUMERIC";

  function addOption() {
    setOptions((current) => [
      ...current,
      { id: crypto.randomUUID(), text: "" },
    ]);
  }

  function updateOption(id: string, text: string) {
    setOptions((current) =>
      current.map((option) =>
        option.id === id ? { ...option, text } : option
      )
    );
  }

  function toggleCorrectOption(id: string) {
    if (type === "MCQ_SINGLE") {
      setCorrectOptionIds([id]);
      return;
    }

    setCorrectOptionIds((current) =>
      current.includes(id)
        ? current.filter((item) => item !== id)
        : [...current, id]
    );
  }

  async function saveQuestion() {
    setMessage("");

    if (!assignmentId.trim()) {
      setMessage("Select or enter your teaching assignment.");
      return;
    }

    if (!title.trim() || !prompt.trim()) {
      setMessage("Question title and question content are required.");
      return;
    }

    if (isChoice && correctOptionIds.length === 0) {
      setMessage("Select at least one correct answer.");
      return;
    }

    if (isChoice && options.some((option) => !option.text.trim())) {
      setMessage("Complete all answer options.");
      return;
    }

    setSaving(true);

    try {
      let answerConfig: Record<string, unknown> = {};

      if (isChoice) {
        answerConfig = { correctOptionIds };
      } else if (isBoolean) {
        answerConfig = { correctAnswer: expectedAnswer };
      } else if (isText || isNumeric) {
        answerConfig = { acceptedAnswers: [expectedAnswer] };
      }

      await questionBankApi.create({
        assignmentId,
        type,
        title,
        prompt,
        instructions,
        topic,
        marks,
        difficulty,
        options: isChoice ? options : [],
        answerConfig,
        explanation,
      });

      setMessage("Question saved as a draft.");
      setTitle("");
      setPrompt("");
      setInstructions("");
      setTopic("");
      setExplanation("");
      setCorrectOptionIds([]);
      setExpectedAnswer("");
    } catch (error) {
      setMessage(
        error instanceof Error ? error.message : "Unable to save question."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <main className="lecturer-page">
      <header className="page-heading">
        <div>
          <p className="eyebrow">QUESTION BANK</p>
          <h1>Create question</h1>
          <p>Save a reusable question as a draft before adding it to an assessment.</p>
        </div>
        <a href="/lecturer/question-bank">Back to question bank</a>
      </header>

      <div className="editor-layout">
        <section className="editor-main">
          <label>
            Question title
            <input
              value={title}
              onChange={(event) => setTitle(event.target.value)}
              placeholder="e.g. Functions of an operating system"
            />
          </label>

          <label>
            Question instructions
            <textarea
              value={instructions}
              onChange={(event) => setInstructions(event.target.value)}
              placeholder="Optional instructions for the candidate"
            />
          </label>

          <label>
            Question content
            <textarea
              className="question-prompt"
              value={prompt}
              onChange={(event) => setPrompt(event.target.value)}
              placeholder="Enter the question..."
            />
          </label>

          {isChoice && (
            <section className="editor-subsection">
              <h2>Answer options</h2>
              <p>Select the correct answer. Multiple answers are allowed for multiple-choice questions.</p>

              {options.map((option, index) => (
                <div className="option-row" key={option.id}>
                  <input
                    value={option.text}
                    onChange={(event) =>
                      updateOption(option.id, event.target.value)
                    }
                    placeholder={`Option ${index + 1}`}
                  />
                  <label>
                    <input
                      type={type === "MCQ_SINGLE" ? "radio" : "checkbox"}
                      checked={correctOptionIds.includes(option.id)}
                      onChange={() => toggleCorrectOption(option.id)}
                      name="correct-answer"
                    />
                    Correct
                  </label>
                </div>
              ))}

              <button type="button" onClick={addOption}>
                + Add option
              </button>
            </section>
          )}

          {isBoolean && (
            <label>
              Correct answer
              <select
                value={expectedAnswer}
                onChange={(event) => setExpectedAnswer(event.target.value)}
              >
                <option value="">Select answer</option>
                <option value="true">True</option>
                <option value="false">False</option>
              </select>
            </label>
          )}

          {(isText || isNumeric) && (
            <label>
              Accepted answer
              <textarea
                value={expectedAnswer}
                onChange={(event) => setExpectedAnswer(event.target.value)}
                placeholder="Enter expected answer or marking reference"
              />
            </label>
          )}

          {!isChoice && !isBoolean && !isText && !isNumeric && (
            <section className="editor-subsection">
              <h2>Specialized question configuration</h2>
              <p>
                This question type requires its dedicated editor.
                Configure matching, ordering, practical tasks, code tests,
                file requirements or other response settings in the
                appropriate type-specific editor before publishing.
              </p>
            </section>
          )}

          <label>
            Explanation / feedback
            <textarea
              value={explanation}
              onChange={(event) => setExplanation(event.target.value)}
              placeholder="Explanation shown after the assessment, subject to assessment settings"
            />
          </label>
        </section>

        <aside className="editor-sidebar">
          <h2>Question settings</h2>

          <label>
            Teaching assignment ID
            <input
              value={assignmentId}
              onChange={(event) => setAssignmentId(event.target.value)}
              placeholder="Select assignment from your courses"
            />
          </label>

          <label>
            Question type
            <select
              value={type}
              onChange={(event) => {
                setType(event.target.value);
                setCorrectOptionIds([]);
                setExpectedAnswer("");
              }}
            >
              {TYPES.map(([value, label]) => (
                <option key={value} value={value}>{label}</option>
              ))}
            </select>
          </label>

          <label>
            Topic
            <input
              value={topic}
              onChange={(event) => setTopic(event.target.value)}
              placeholder="e.g. Computer hardware"
            />
          </label>

          <label>
            Marks
            <input
              type="number"
              min="0.25"
              max="1000"
              step="0.25"
              value={marks}
              onChange={(event) => setMarks(Number(event.target.value))}
            />
          </label>

          <label>
            Difficulty
            <select
              value={difficulty}
              onChange={(event) => setDifficulty(event.target.value)}
            >
              <option value="EASY">Easy</option>
              <option value="MEDIUM">Medium</option>
              <option value="HARD">Hard</option>
              <option value="ADVANCED">Advanced</option>
            </select>
          </label>

          <div className="editor-actions">
            <button
              className="primary-button"
              type="button"
              onClick={saveQuestion}
              disabled={saving}
            >
              {saving ? "Saving..." : "Save draft"}
            </button>
          </div>

          {message && <p role="status">{message}</p>}
        </aside>
      </div>
    </main>
  );
}

Important: The editor above is a working pattern for the representative types, not a complete implementation of every specialized type. In particular, matching, ordering, programming, file-upload and practical-software questions need their own structured configuration components and server-side validators. Do not allow those types to be published with empty or incomplete configuration.

11. Add questions to an assessment
A lecturer should be able to select questions from the bank and attach them to an assessment. The backend must check assignment ownership and ensure the selected questions belong to the lecturer's permitted course scope.

Add this method to the existing assessment service. Adapt the relation names to the actual Prisma schema.


async addQuestions(
  lecturerId: string,
  assessmentId: string,
  questionIds: string[]
) {
  const assessment = await prisma.lecturerAssessment.findFirst({
    where: {
      id: assessmentId,
      lecturerId,
    },
    select: {
      id: true,
      assignmentId: true,
      status: true,
    },
  });

  if (!assessment) {
    throw new Error("Assessment not found or access denied.");
  }

  if (!["DRAFT"].includes(assessment.status)) {
    throw new Error("Questions can only be changed while the assessment is a draft.");
  }

  const uniqueIds = [...new Set(questionIds)];

  if (!uniqueIds.length) {
    throw new Error("Select at least one question.");
  }

  const questions = await prisma.lecturerQuestion.findMany({
    where: {
      id: { in: uniqueIds },
      lecturerId,
      assignmentId: assessment.assignmentId,
      status: "DRAFT",
    },
    select: {
      id: true,
      marks: true,
    },
  });

  if (questions.length !== uniqueIds.length) {
    throw new Error(
      "One or more questions are unavailable or outside this assignment."
    );
  }

  return prisma.$transaction(async (tx) => {
    const existing = await tx.lecturerAssessmentQuestion.findMany({
      where: { assessmentId },
      select: { questionId: true },
    });

    const existingIds = new Set(existing.map((item) => item.questionId));
    const newQuestions = questions.filter(
      (question) => !existingIds.has(question.id)
    );

    const nextOrder = existing.length;

    await tx.lecturerAssessmentQuestion.createMany({
      data: newQuestions.map((question, index) => ({
        assessmentId,
        questionId: question.id,
        orderNumber: nextOrder + index + 1,
        marks: question.marks,
      })),
    });

    return tx.lecturerAssessmentQuestion.findMany({
      where: { assessmentId },
      orderBy: { orderNumber: "asc" },
      include: {
        question: {
          select: {
            id: true,
            title: true,
            type: true,
            marks: true,
            difficulty: true,
          },
        },
      },
    });
  });
}

Add the route to your assessment routes:

router.post(
  "/:assessmentId/questions",
  requireAuth,
  requireLecturer,
  addAssessmentQuestions
);

The controller should validate questionIds as an array of non-empty strings before calling the service.

Assessment validation must also run after adding questions: calculate the total marks from the attached assessment-question records, compare them with the assessment's configured total, and prevent approval if they differ.

