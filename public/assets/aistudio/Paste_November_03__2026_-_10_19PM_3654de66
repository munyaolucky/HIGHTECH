import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

interface QuestionInput {
  assignmentId: string;
  questionType: string;
  questionText: string;
  marks: number;
  difficulty: string;
  options?: unknown;
  answerKey?: unknown;
  explanation?: string;
}

const supportedDifficulty = [
  "EASY",
  "MEDIUM",
  "HARD",
  "ADVANCED"
];

export class LecturerQuestionBankService {
  async create(
    lecturerId: string,
    input: QuestionInput
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: input.assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    if (
      !input.questionText.trim() ||
      !input.questionType.trim() ||
      !Number.isFinite(input.marks) ||
      input.marks <= 0 ||
      !supportedDifficulty.includes(input.difficulty)
    ) {
      throw new Error("Invalid question details");
    }

    // Replace lecturerQuestion with the actual question
    // model in your existing assessment engine.
    return prisma.lecturerQuestion.create({
      data: {
        lecturerId,
        assignmentId: input.assignmentId,
        questionType: input.questionType,
        questionText: input.questionText.trim(),
        marks: input.marks,
        difficulty: input.difficulty,
        options: input.options as any,
        answerKey: input.answerKey as any,
        explanation: input.explanation
      }
    });
  }

  async list(
    lecturerId: string,
    assignmentId: string,
    questionType?: string
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    return prisma.lecturerQuestion.findMany({
      where: {
        lecturerId,
        assignmentId,
        ...(questionType ? { questionType } : {})
      },
      orderBy: { createdAt: "desc" }
    });
  }

  async delete(lecturerId: string, questionId: string) {
    const question = await prisma.lecturerQuestion.findFirst({
      where: {
        id: questionId,
        lecturerId
      }
    });

    if (!question) {
      throw new Error("Question not found");
    }

    const used = await prisma.lecturerAssessmentQuestion.findFirst({
      where: { questionId }
    });

    if (used) {
      throw new Error(
        "Question is already used in an assessment. Archive it instead."
      );
    }

    return prisma.lecturerQuestion.delete({
      where: { id: questionId }
    });
  }
}

export const lecturerQuestionBankService =
  new LecturerQuestionBankService();

Important: lecturerQuestion is a placeholder name. It must be replaced by the actual question model from the existing platform. Question options, answer keys and marking data must be stored securely; never expose answer keys to students through student-facing APIs.

