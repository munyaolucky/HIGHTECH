14. Mobile attendance synchronization
The lecturer mobile app should allow attendance to be drafted when internet connectivity is unavailable.

The following is the synchronization service foundation. It uses an idempotency key so that retrying a batch does not create duplicate attendance entries.

backend/src/modules/lecturer/attendance/attendance-sync.service.ts


import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

interface AttendanceRecord {
  studentId: string;
  status: string;
}

interface AttendanceBatch {
  idempotencyKey: string;
  assignmentId: string;
  lessonDate: string;
  records: AttendanceRecord[];
}

export async function synchronizeAttendance(
  lecturerId: string,
  batch: AttendanceBatch
) {
  if (
    !batch.idempotencyKey ||
    !batch.assignmentId ||
    !Array.isArray(batch.records) ||
    batch.records.length === 0
  ) {
    throw new Error("Invalid synchronization batch");
  }

  const assignment =
    await prisma.teachingAssignment.findFirst({
      where: {
        id: batch.assignmentId,
        lecturerId,
        active: true
      }
    });

  if (!assignment) {
    throw new Error("Teaching assignment not found");
  }

  const allowedStatuses = [
    "PRESENT",
    "ABSENT",
    "LATE",
    "EXCUSED",
    "AUTHORIZED_ABSENCE",
    "LEFT_EARLY"
  ];

  const studentIds = batch.records.map(r => r.studentId);

  if (
    new Set(studentIds).size !== studentIds.length ||
    batch.records.some(r => !allowedStatuses.includes(r.status))
  ) {
    throw new Error("Invalid attendance records");
  }

  // The existing attendance service must also verify
  // that every student has an approved enrolment in
  // the assigned unit and semester.

  return prisma.$transaction(async tx => {
    const previous = await tx.attendanceBatch.findUnique({
      where: {
        idempotencyKey: batch.idempotencyKey
      }
    });

    if (previous) {
      if (
        previous.lecturerId !== lecturerId ||
        previous.assignmentId !== batch.assignmentId
      ) {
        throw new Error("Idempotency key conflict");
      }

      return {
        duplicate: true,
        batchId: previous.id,
        status: previous.status
      };
    }

    const saved = await tx.attendanceBatch.create({
      data: {
        idempotencyKey: batch.idempotencyKey,
        lecturerId,
        assignmentId: batch.assignmentId,
        lessonDate: new Date(batch.lessonDate),
        status: "PROCESSING"
      }
    });

    for (const record of batch.records) {
      await tx.attendanceRecord.create({
        data: {
          batchId: saved.id,
          assignmentId: batch.assignmentId,
          studentId: record.studentId,
          status: record.status
        }
      });
    }

    await tx.attendanceBatch.update({
      where: { id: saved.id },
      data: { status: "COMPLETED" }
    });

    return {
      duplicate: false,
      batchId: saved.id,
      status: "COMPLETED"
    };
  });
}

The attendanceBatch and attendanceRecord models must be integrated with your existing attendance schema. The existing attendance records must remain the authoritative academic record.

