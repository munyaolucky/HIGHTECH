import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

export class LecturerTimetableService {
  async getTimetable(
    lecturerId: string,
    from: Date,
    to: Date
  ) {
    if (
      Number.isNaN(from.getTime()) ||
      Number.isNaN(to.getTime()) ||
      from >= to ||
      to.getTime() - from.getTime() > 93 * 86400000
    ) {
      throw new Error("Invalid timetable date range");
    }

    const assignments =
      await prisma.teachingAssignment.findMany({
        where: {
          lecturerId,
          active: true
        },
        select: { id: true }
      });

    const assignmentIds = assignments.map(a => a.id);

    if (!assignmentIds.length) return [];

    return prisma.academicTimetableEntry.findMany({
      where: {
        assignmentId: { in: assignmentIds },
        startTime: { gte: from, lt: to }
      },
      orderBy: { startTime: "asc" }
    });
  }

  async requestChange(
    lecturerId: string,
    input: {
      assignmentId: string;
      currentDate: string;
      requestedDate: string;
      currentStart: string;
      requestedStart: string;
      reason: string;
    }
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: input.assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    const currentDate = new Date(input.currentDate);
    const requestedDate = new Date(input.requestedDate);

    if (
      Number.isNaN(currentDate.getTime()) ||
      Number.isNaN(requestedDate.getTime()) ||
      !input.reason.trim() ||
      !/^\d{2}:\d{2}$/.test(input.currentStart) ||
      !/^\d{2}:\d{2}$/.test(input.requestedStart)
    ) {
      throw new Error("Invalid timetable change request");
    }

    return prisma.lecturerTimetableRequest.create({
      data: {
        lecturerId,
        assignmentId: input.assignmentId,
        currentDate,
        requestedDate,
        currentStart: input.currentStart,
        requestedStart: input.requestedStart,
        reason: input.reason.trim()
      }
    });
  }

  async getChangeRequests(lecturerId: string) {
    return prisma.lecturerTimetableRequest.findMany({
      where: { lecturerId },
      orderBy: { createdAt: "desc" }
    });
  }
}

export const lecturerTimetableService =
  new LecturerTimetableService();

