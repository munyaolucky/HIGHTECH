import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

const ALLOWED_TYPES = new Set([
  "application/pdf",
  "application/msword",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  "application/vnd.ms-powerpoint",
  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
  "application/vnd.ms-excel",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
  "image/jpeg",
  "image/png",
  "audio/mpeg",
  "video/mp4",
  "application/zip"
]);

const MAX_FILE_SIZE = 100 * 1024 * 1024;

export class LecturerMaterialService {
  async create(
    lecturerId: string,
    input: {
      assignmentId: string;
      title: string;
      description?: string;
      topic?: string;
      fileName: string;
      fileUrl: string;
      mimeType: string;
      fileSize: number;
    }
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: input.assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    if (!ALLOWED_TYPES.has(input.mimeType)) {
      throw new Error("Unsupported file format");
    }

    if (
      input.fileSize <= 0 ||
      input.fileSize > MAX_FILE_SIZE
    ) {
      throw new Error("File size exceeds the allowed limit");
    }

    return prisma.learningMaterial.create({
      data: {
        lecturerId,
        assignmentId: input.assignmentId,
        title: input.title,
        description: input.description,
        topic: input.topic,
        fileName: input.fileName,
        fileUrl: input.fileUrl,
        mimeType: input.mimeType,
        published: false
      }
    });
  }

  async list(lecturerId: string) {
    return prisma.learningMaterial.findMany({
      where: { lecturerId },
      orderBy: { createdAt: "desc" }
    });
  }

  async publish(
    lecturerId: string,
    materialId: string
  ) {
    const material =
      await prisma.learningMaterial.findFirst({
        where: {
          id: materialId,
          lecturerId
        }
      });

    if (!material) {
      throw new Error("Material not found");
    }

    return prisma.learningMaterial.update({
      where: { id: materialId },
      data: {
        published: true,
        publishedAt: new Date()
      }
    });
  }

  async unpublish(
    lecturerId: string,
    materialId: string
  ) {
    const material =
      await prisma.learningMaterial.findFirst({
        where: {
          id: materialId,
          lecturerId
        }
      });

    if (!material) {
      throw new Error("Material not found");
    }

    return prisma.learningMaterial.update({
      where: { id: materialId },
      data: {
        published: false,
        publishedAt: null
      }
    });
  }
}

export const lecturerMaterialService =
  new LecturerMaterialService();

