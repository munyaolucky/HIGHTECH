import { PrismaClient, AttendanceStatus } from "@prisma/client";

const prisma = new PrismaClient();

export class LecturerService {
  async getProfile(userId: string) {
    return prisma.lecturerProfile.findFirst({
      where: {
        staff: {
          // Connect this condition to the authenticated
          // account relation in your existing Staff schema.
          userId
        }
      },
      include: {
        staff: true,
        departments: true,
        campuses: true,
        assignments: {
          where: { active: true }
        }
      }
    });
  }

  async getDashboard(lecturerId: string) {
    const [
      profile,
      assignments,
      lessons,
      attendance,
      assessments,
      results,
      notifications
    ] = await Promise.all([
      prisma.lecturerProfile.findUnique({
        where: { id: lecturerId },
        include: { staff: true }
      }),

      prisma.teachingAssignment.count({
        where: { lecturerId, active: true }
      }),

      prisma.lessonPlan.count({
        where: {
          lecturerId,
          status: "DRAFT"
        }
      }),

      prisma.classAttendance.count({
        where: {
          lecturerId,
          submitted: false
        }
      }),

      prisma.assessment.count({
        where: {
          lecturerId,
          status: { in: ["DRAFT", "PENDING_APPROVAL"] }
        }
      }),

      prisma.resultSubmission.count({
        where: {
          lecturerId,
          status: { in: ["DRAFT", "REJECTED"] }
        }
      }),

      prisma.lecturerNotification.findMany({
        where: { lecturerId, read: false },
        orderBy: { createdAt: "desc" },
        take: 5
      })
    ]);

    if (!profile) {
      throw new Error("Lecturer profile not found");
    }

    return {
      lecturer: {
        name: profile.staff.fullName,
        registrationNumber: profile.staff.registrationNumber,
        employmentStatus: profile.employmentStatus
      },
      statistics: {
        assignedUnits: assignments,
        pendingLessonPlans: lessons,
        pendingAttendance: attendance,
        pendingAssessments: assessments,
        pendingResults: results
      },
      notifications
    };
  }

  async getAssignments(lecturerId: string) {
    return prisma.teachingAssignment.findMany({
      where: {
        lecturerId,
        active: true
      },
      orderBy: { createdAt: "desc" }
    });
  }

  async createLessonPlan(
    lecturerId: string,
    data: {
      assignmentId: string;
      lessonDate: string;
      durationMinutes: number;
      topic: string;
      objectives: string;
      subtopic?: string;
      teachingMethods?: string;
      activities?: string;
      resources?: string;
      remarks?: string;
    }
  ) {
    const assignment = await prisma.teachingAssignment.findFirst({
      where: {
        id: data.assignmentId,
        lecturerId,
        active: true
      }
    });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    return prisma.lessonPlan.create({
      data: {
        lecturerId,
        assignmentId: data.assignmentId,
        lessonDate: new Date(data.lessonDate),
        durationMinutes: data.durationMinutes,
        topic: data.topic,
        objectives: data.objectives,
        subtopic: data.subtopic,
        teachingMethods: data.teachingMethods,
        activities: data.activities,
        resources: data.resources,
        remarks: data.remarks
      }
    });
  }

  async recordAttendance(
    lecturerId: string,
    assignmentId: string,
    lessonDate: string,
    records: {
      studentId: string;
      status: AttendanceStatus;
      reason?: string;
    }[]
  ) {
    const assignment = await prisma.teachingAssignment.findFirst({
      where: {
        id: assignmentId,
        lecturerId,
        active: true
      }
    });

    if (!assignment) {
      throw new Error("Teaching assignment not found");
    }

    return prisma.$transaction(async (tx) => {
      const session = await tx.classAttendance.create({
        data: {
          lecturerId,
          assignmentId,
          lessonDate: new Date(lessonDate)
        }
      });

      await tx.attendanceRecord.createMany({
        data: records.map((record) => ({
          sessionId: session.id,
          studentId: record.studentId,
          status: record.status,
          reason: record.reason
        })),
        skipDuplicates: true
      });

      return tx.classAttendance.findUnique({
        where: { id: session.id },
        include: { records: true }
      });
    });
  }

  async getNotifications(lecturerId: string) {
    return prisma.lecturerNotification.findMany({
      where: { lecturerId },
      orderBy: { createdAt: "desc" },
      take: 50
    });
  }
}

export const lecturerService = new LecturerService();

