6. Question bank service
Create question-bank.service.ts.

This example assumes a Prisma model named lecturerQuestion. If your current assessment engine already has a question model, replace the Prisma calls with an adapter to that model. Do not create a second question table.


import { prisma } from "../../../lib/prisma";
import {
  getQuestionType,
} from "./question-types.registry";

type QuestionInput = {
  assignmentId: string;
  courseId?: string;
  unitId?: string;
  topic?: string;
  type: string;
  title: string;
  prompt: string;
  instructions?: string;
  marks: number;
  difficulty: "EASY" | "MEDIUM" | "HARD" | "ADVANCED";
  options?: unknown[];
  answerConfig?: Record<string, unknown>;
  markingConfig?: Record<string, unknown>;
  explanation?: string;
  tags?: string[];
};

export class LecturerQuestionBankService {
  async assertAssignmentAccess(
    lecturerId: string,
    assignmentId: string
  ) {
    const assignment = await prisma.teachingAssignment.findFirst({
      where: {
        id: assignmentId,
        lecturerId,
        status: "ACTIVE",
      },
      select: {
        id: true,
        courseId: true,
        unitId: true,
        campusId: true,
      },
    });

    if (!assignment) {
      throw new Error("You are not assigned to this course or unit.");
    }

    return assignment;
  }

  async create(
    lecturerId: string,
    input: QuestionInput
  ) {
    const assignment = await this.assertAssignmentAccess(
      lecturerId,
      input.assignmentId
    );

    const type = getQuestionType(input.type);

    if (!type) {
      throw new Error("This question type is not enabled.");
    }

    if (
      type.requiresOptions &&
      (!input.options || input.options.length < 2)
    ) {
      throw new Error("This question type requires at least two options.");
    }

    if (
      input.courseId &&
      input.courseId !== assignment.courseId
    ) {
      throw new Error("Course does not match the teaching assignment.");
    }

    if (
      input.unitId &&
      assignment.unitId &&
      input.unitId !== assignment.unitId
    ) {
      throw new Error("Unit does not match the teaching assignment.");
    }

    return prisma.lecturerQuestion.create({
      data: {
        lecturerId,
        assignmentId: assignment.id,
        courseId: assignment.courseId,
        unitId: input.unitId ?? assignment.unitId,
        topic: input.topic,
        type: input.type,
        title: input.title,
        prompt: input.prompt,
        instructions: input.instructions,
        marks: input.marks,
        difficulty: input.difficulty,
        options: input.options ?? [],
        answerConfig: input.answerConfig ?? {},
        markingConfig: input.markingConfig ?? {},
        explanation: input.explanation,
        tags: input.tags ?? [],
        status: "DRAFT",
      },
    });
  }

  async list(
    lecturerId: string,
    filters: {
      search?: string;
      assignmentId?: string;
      courseId?: string;
      unitId?: string;
      topic?: string;
      type?: string;
      difficulty?: string;
      page: number;
      pageSize: number;
    }
  ) {
    const where: any = {
      lecturerId,
      status: { not: "ARCHIVED" },
    };

    if (filters.assignmentId) {
      await this.assertAssignmentAccess(
        lecturerId,
        filters.assignmentId
      );
      where.assignmentId = filters.assignmentId;
    }

    if (filters.courseId) where.courseId = filters.courseId;
    if (filters.unitId) where.unitId = filters.unitId;
    if (filters.topic) where.topic = filters.topic;
    if (filters.type) where.type = filters.type;
    if (filters.difficulty) {
      where.difficulty = filters.difficulty;
    }

    if (filters.search) {
      where.OR = [
        { title: { contains: filters.search, mode: "insensitive" } },
        { prompt: { contains: filters.search, mode: "insensitive" } },
        { topic: { contains: filters.search, mode: "insensitive" } },
      ];
    }

    const skip = (filters.page - 1) * filters.pageSize;

    const [items, total] = await prisma.$transaction([
      prisma.lecturerQuestion.findMany({
        where,
        skip,
        take: filters.pageSize,
        orderBy: { updatedAt: "desc" },
        select: {
          id: true,
          title: true,
          type: true,
          topic: true,
          marks: true,
          difficulty: true,
          status: true,
          updatedAt: true,
          assignmentId: true,
          courseId: true,
          unitId: true,
        },
      }),
      prisma.lecturerQuestion.count({ where }),
    ]);

    return {
      items,
      pagination: {
        page: filters.page,
        pageSize: filters.pageSize,
        total,
        pages: Math.ceil(total / filters.pageSize),
      },
    };
  }

  async getOne(lecturerId: string, questionId: string) {
    const question = await prisma.lecturerQuestion.findFirst({
      where: {
        id: questionId,
        lecturerId,
        status: { not: "ARCHIVED" },
      },
    });

    if (!question) {
      throw new Error("Question not found.");
    }

    return question;
  }

  async update(
    lecturerId: string,
    questionId: string,
    data: Partial<QuestionInput>
  ) {
    const existing = await this.getOne(lecturerId, questionId);

    if (existing.status !== "DRAFT") {
      throw new Error("Only draft questions can be edited.");
    }

    if (data.type && !getQuestionType(data.type)) {
      throw new Error("Question type is not enabled.");
    }

    return prisma.lecturerQuestion.update({
      where: { id: questionId },
      data: {
        ...data,
        updatedAt: new Date(),
      },
    });
  }

  async archive(lecturerId: string, questionId: string) {
    const question = await this.getOne(lecturerId, questionId);

    if (question.status !== "DRAFT") {
      throw new Error("Only draft questions can be archived.");
    }

    return prisma.lecturerQuestion.update({
      where: { id: questionId },
      data: { status: "ARCHIVED" },
    });
  }
}

Security note: answerConfig and markingConfig contain correct answers and marking rules. They must only be returned to authorized lecturer, examiner, and marking endpoints. Student-facing assessment endpoints must use a separate response DTO that excludes both fields.

