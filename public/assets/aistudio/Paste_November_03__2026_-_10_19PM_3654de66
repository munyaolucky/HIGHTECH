import { useEffect, useState } from "react";
import {
  CalendarDays,
  Clock,
  MapPin,
  RefreshCw
} from "lucide-react";

export default function LecturerTimetable() {
  const [entries, setEntries] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [week, setWeek] = useState(() => {
    const now = new Date();
    const day = (now.getDay() + 6) % 7;
    now.setDate(now.getDate() - day);
    return now;
  });

  const end = new Date(week);
  end.setDate(end.getDate() + 7);

  const fromString = week.toISOString();
  const toString = end.toISOString();

  async function load() {
    setLoading(true);
    setError("");

    try {
      const response = await fetch(
        `/api/lecturer/timetable?from=${encodeURIComponent(fromString)}&to=${encodeURIComponent(toString)}`,
        { credentials: "include" }
      );

      const result = await response.json();

      if (!response.ok) throw new Error(result.message);

      setEntries(result.data);
    } catch (e) {
      setError(
        e instanceof Error ? e.message : "Timetable unavailable"
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, [week]);

  const days = Array.from({ length: 7 }, (_, index) => {
    const date = new Date(week);
    date.setDate(date.getDate() + index);
    return date;
  });

  return (
    <div>
      <div className="page-heading">
        <div>
          <h1>My Teaching Timetable</h1>
          <p>Official teaching sessions and scheduled activities.</p>
        </div>

        <button className="primary-button" onClick={load}>
          <RefreshCw size={16} /> Refresh
        </button>
      </div>

      <div className="timetable-toolbar">
        <button
          onClick={() => {
            const next = new Date(week);
            next.setDate(next.getDate() - 7);
            setWeek(next);
          }}
        >
          Previous
        </button>

        <strong>
          {week.toLocaleDateString()} –{" "}
          {new Date(end.getTime() - 86400000).toLocaleDateString()}
        </strong>

        <button
          onClick={() => {
            const next = new Date(week);
            next.setDate(next.getDate() + 7);
            setWeek(next);
          }}
        >
          Next
        </button>
      </div>

      {error && <div className="error-message">{error}</div>}

      {loading ? (
        <p>Loading timetable...</p>
      ) : (
        <div className="timetable-grid">
          {days.map(day => {
            const daily = entries.filter(entry =>
              new Date(entry.startTime).toDateString() ===
              day.toDateString()
            );

            return (
              <section className="timetable-day" key={day.toISOString()}>
                <header>
                  <strong>
                    {day.toLocaleDateString("en-KE", {
                      weekday: "short"
                    })}
                  </strong>
                  <span>{day.getDate()}</span>
                </header>

                {daily.length === 0 ? (
                  <p className="empty-day">No scheduled sessions</p>
                ) : daily.map(entry => (
                  <article className="timetable-event" key={entry.id}>
                    <CalendarDays size={17} />
                    <strong>{entry.title || entry.unitId}</strong>

                    <p>
                      <Clock size={13} />
                      {new Date(entry.startTime).toLocaleTimeString([], {
                        hour: "2-digit",
                        minute: "2-digit"
                      })}
                      {" – "}
                      {new Date(entry.endTime).toLocaleTimeString([], {
                        hour: "2-digit",
                        minute: "2-digit"
                      })}
                    </p>

                    <p>
                      <MapPin size={13} />
                      {entry.roomName || "Location to be confirmed"}
                    </p>

                    <small>{entry.sessionType || "Teaching"}</small>
                  </article>
                ))}
              </section>
            );
          })}
        </div>
      )}
    </div>
  );
}

