This implementation uses the teaching assignment as the lecturer's access boundary. The classGroupId must resolve to an actual class group, and the student list must come from approved enrolments.


import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

export class LecturerClassesService {
  async getMyClasses(lecturerId: string) {
    const assignments =
      await prisma.teachingAssignment.findMany({
        where: {
          lecturerId,
          active: true
        },
        orderBy: {
          createdAt: "desc"
        }
      });

    return assignments;
  }

  async getClassStudents(
    lecturerId: string,
    assignmentId: string,
    search = ""
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("You are not assigned to this class");
    }

    // Adapt this query to the existing student-unit
    // enrolment relation in the college database.
    return prisma.studentUnitEnrollment.findMany({
      where: {
        unitId: assignment.unitId,
        semesterId: assignment.semesterId,
        status: "APPROVED",
        ...(search ? {
          student: {
            OR: [
              {
                firstName: {
                  contains: search,
                  mode: "insensitive"
                }
              },
              {
                lastName: {
                  contains: search,
                  mode: "insensitive"
                }
              },
              {
                registrationNumber: {
                  contains: search,
                  mode: "insensitive"
                }
              }
            ]
          }
        } : {})
      },
      include: {
        student: {
          select: {
            id: true,
            registrationNumber: true,
            firstName: true,
            lastName: true,
            officialEmail: true
          }
        }
      },
      orderBy: {
        student: {
          registrationNumber: "asc"
        }
      },
      take: 100
    });
  }

  async getStudentProfile(
    lecturerId: string,
    assignmentId: string,
    studentId: string
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Access denied");
    }

    const enrollment =
      await prisma.studentUnitEnrollment.findFirst({
        where: {
          unitId: assignment.unitId,
          semesterId: assignment.semesterId,
          studentId,
          status: "APPROVED"
        },
        include: {
          student: true
        }
      });

    if (!enrollment) {
      throw new Error(
        "Student is not enrolled in your assigned unit"
      );
    }

    return enrollment.student;
  }
}

export const lecturerClassesService =
  new LecturerClassesService();

Privacy rule: Lecturers can access academic information needed for their assigned classes. Sensitive financial, medical, disciplinary and unrelated personal records remain restricted to their authorized offices.

