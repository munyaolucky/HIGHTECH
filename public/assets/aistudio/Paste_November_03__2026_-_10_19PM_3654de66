router.post(
  "/lesson-plans",
  requireLecturerPermission("lecturer:lesson:create"),
  async (req: AuthenticatedRequest, res: Response) => {
    try {
      const profile = await getLecturerId(req);

      const {
        assignmentId,
        lessonDate,
        durationMinutes,
        topic,
        objectives
      } = req.body;

      if (
        !assignmentId ||
        !lessonDate ||
        !topic?.trim() ||
        !objectives?.trim() ||
        !Number.isInteger(durationMinutes) ||
        durationMinutes <= 0 ||
        Number.isNaN(Date.parse(lessonDate))
      ) {
        return res.status(400).json({
          message: "Invalid lesson plan information"
        });
      }

      const lesson = await lecturerService.createLessonPlan(
        profile!.id,
        req.body
      );

      res.status(201).json({
        success: true,
        data: lesson
      });
    } catch (error) {
      res.status(400).json({
        message: error instanceof Error
          ? error.message
          : "Unable to create lesson plan"
      });
    }
  }
);

router.post(
  "/attendance",
  requireLecturerPermission("lecturer:attendance:manage"),
  async (req: AuthenticatedRequest, res: Response) => {
    try {
      const profile = await getLecturerId(req);

      const { assignmentId, lessonDate, records } = req.body;

      if (
        !assignmentId ||
        !lessonDate ||
        !Array.isArray(records) ||
        records.length === 0 ||
        new Set(records.map((r: any) => r.studentId)).size !== records.length
      ) {
        return res.status(400).json({
          message: "Invalid attendance submission"
        });
      }

      const allowedStatuses = [
        "PRESENT",
        "ABSENT",
        "LATE",
        "EXCUSED",
        "AUTHORIZED_ABSENCE",
        "LEFT_EARLY"
      ];

      if (
        records.some((record: any) =>
          !record.studentId ||
          !allowedStatuses.includes(record.status)
        )
      ) {
        return res.status(400).json({
          message: "Invalid attendance record"
        });
      }

      const attendance = await lecturerService.recordAttendance(
        profile!.id,
        assignmentId,
        lessonDate,
        records
      );

      res.status(201).json({
        success: true,
        data: attendance
      });
    } catch (error) {
      res.status(400).json({
        message: error instanceof Error
          ? error.message
          : "Unable to record attendance"
      });
    }
  }
);

router.get(
