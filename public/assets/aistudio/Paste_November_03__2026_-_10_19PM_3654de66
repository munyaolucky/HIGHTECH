import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

const EDITABLE_FIELDS = [
  "phone",
  "officialEmail",
  "specialization",
  "academicQualifications",
  "professionalQualifications"
] as const;

type EditableField = typeof EDITABLE_FIELDS[number];

export class LecturerProfileService {
  async getProfile(lecturerId: string) {
    return prisma.lecturerProfile.findUnique({
      where: { id: lecturerId },
      include: {
        staff: true,
        departments: true,
        campuses: true
      }
    });
  }

  async requestCorrection(
    lecturerId: string,
    fieldName: string,
    newValue: string,
    reason: string
  ) {
    if (!EDITABLE_FIELDS.includes(fieldName as EditableField)) {
      throw new Error("This field requires an authorized HR update");
    }

    const profile = await prisma.lecturerProfile.findUnique({
      where: { id: lecturerId }
    });

    if (!profile) throw new Error("Profile not found");

    const oldValue = profile[fieldName as EditableField];

    return prisma.lecturerProfileChange.create({
      data: {
        lecturerId,
        fieldName,
        oldValue,
        newValue,
        reason,
        status: "PENDING"
      }
    });
  }

  async getCorrectionRequests(lecturerId: string) {
    return prisma.lecturerProfileChange.findMany({
      where: { lecturerId },
      orderBy: { createdAt: "desc" }
    });
  }
}

