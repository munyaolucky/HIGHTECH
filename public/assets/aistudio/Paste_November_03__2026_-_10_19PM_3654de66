import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

export class OnlineClassesService {
  async create(
    lecturerId: string,
    data: {
      assignmentId: string;
      title: string;
      description?: string;
      scheduledStart: string;
      scheduledEnd: string;
      provider: string;
      meetingUrl: string;
    }
  ) {
    const assignment =
      await prisma.teachingAssignment.findFirst({
        where: {
          id: data.assignmentId,
          lecturerId,
          active: true
        }
      });

    if (!assignment) {
      throw new Error("Invalid teaching assignment");
    }

    const start = new Date(data.scheduledStart);
    const end = new Date(data.scheduledEnd);

    if (
      Number.isNaN(start.getTime()) ||
      Number.isNaN(end.getTime()) ||
      start <= new Date() ||
      end <= start ||
      !data.title.trim()
    ) {
      throw new Error("Invalid online lesson schedule");
    }

    if (!["TEAMS", "GOOGLE_MEET", "OTHER"].includes(data.provider)) {
      throw new Error("Unsupported meeting provider");
    }

    const url = new URL(data.meetingUrl);

    if (
      url.protocol !== "https:" ||
      !["teams.microsoft.com", "meet.google.com"].includes(url.hostname) &&
      data.provider !== "OTHER"
    ) {
      throw new Error("Invalid meeting link");
    }

    return prisma.lecturerOnlineClass.create({
      data: {
        lecturerId,
        assignmentId: data.assignmentId,
        title: data.title,
        description: data.description,
        scheduledStart: start,
        scheduledEnd: end,
        provider: data.provider,
        meetingUrl: data.meetingUrl,
        status: "SCHEDULED"
      }
    });
  }

  async list(lecturerId: string) {
    return prisma.lecturerOnlineClass.findMany({
      where: { lecturerId },
      orderBy: { scheduledStart: "desc" }
    });
  }

  async cancel(lecturerId: string, id: string) {
    const lesson = await prisma.lecturerOnlineClass.findFirst({
      where: {
        id,
        lecturerId,
        status: "SCHEDULED"
      }
    });

    if (!lesson) {
      throw new Error("Online lesson cannot be cancelled");
    }

    return prisma.lecturerOnlineClass.update({
      where: { id },
      data: { status: "CANCELLED" }
    });
  }
}

