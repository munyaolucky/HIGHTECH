## 4. Add the dashboard to your application

For example, in `src/App.tsx`:

```
import StudentDashboard from "./modules/student/StudentDashboard";

function App() {
  return (
    <StudentDashboard
      studentName="Amina Wanjiku"
      registrationNumber="HCA/STU/2026/001"
      programme="BSc. Computer Science"
      academicYear="2026"
      semester="Semester 1"
      registeredCourses={6}
      attendance={95}
      gpa={3.75}
      onNavigate={(page) => {
        console.log("Navigate to:", page);
      }}
      onLogout={() => {
        window.location.href = "/login";
      }}
    />
  );
}

export default App;
```

