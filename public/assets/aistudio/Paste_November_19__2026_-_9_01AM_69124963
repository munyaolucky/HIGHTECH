### `src/modules/admissions/AdmissionsPage.tsx`

```

import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import {
  Search,
  UserPlus,
  Eye,
  RefreshCw,
} from "lucide-react";

import PortalPage from "../../components/portal/PortalPage";
import { admissionApi } from "./admission-api";
import type {
  AdmissionApplication,
  AdmissionStatus,
} from "./admission-types";

import "./admissions.css";

const PAGE_SIZE = 20;

const statuses: AdmissionStatus[] = [
  "SUBMITTED",
  "UNDER_REVIEW",
  "DOCUMENTS_REQUIRED",
  "APPROVED",
  "OFFER_SENT",
  "OFFER_ACCEPTED",
  "REJECTED",
  "REGISTERED",
];

function label(status: AdmissionStatus) {
  return status.replace(/_/g, " ");
}

export default function AdmissionsPage() {
  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("");
  const [page, setPage] = useState(1);
  const [refreshKey, setRefreshKey] = useState(0);

  const [items, setItems] = useState<AdmissionApplication[]>([]);
  const [total, setTotal] = useState(0);
  const [totalPages, setTotalPages] = useState(0);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function load() {
      setLoading(true);
      setError("");

      try {
        const response = await admissionApi.list({
          q: search || undefined,
          status: status
            ? (status as AdmissionStatus)
            : undefined,
          page,
          pageSize: PAGE_SIZE,
        });

        if (cancelled) return;

        setItems(response.items);
        setTotal(response.total);
        setTotalPages(response.totalPages);
      } catch {
        if (!cancelled) {
          setError("Unable to load applications.");
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    load();

    return () => {
      cancelled = true;
    };
  }, [search, status, page, refreshKey]);

  return (
    <PortalPage
      title="Admissions"
      subtitle="Review applications and manage the admission process."
      action={
        <Link
          to="/portal/staff/admissions/new"
          className="admission-primary-button"
        >
          <UserPlus size={18} />
          New Application
        </Link>
      }
    >
      <section className="admissions-workspace">
        <div className="admissions-toolbar">
          <div className="admissions-search">
            <Search size={18} />
            <input
              value={search}
              onChange={(e) => {
                setSearch(e.target.value);
                setPage(1);
              }}
              placeholder="Search applicants..."
              aria-label="Search applicants"
            />
          </div>

          <select
            value={status}
            onChange={(e) => {
              setStatus(e.target.value);
              setPage(1);
            }}
            aria-label="Filter application status"
          >
            <option value="">All statuses</option>
            {statuses.map((s) => (
              <option key={s} value={s}>
                {label(s)}
              </option>
            ))}
          </select>

          <button
            type="button"
            className="admission-refresh"
            onClick={() => setRefreshKey((v) => v + 1)}
          >
            <RefreshCw size={17} />
            Refresh
          </button>
        </div>

        <div className="admissions-total">
          {total} application records
        </div>

        {error && (
          <div className="admissions-error" role="alert">
            {error}
          </div>
        )}

        {loading ? (
          <div className="admissions-loading" role="status">
            Loading applications...
          </div>
        ) : items.length === 0 ? (
          <div className="admissions-empty">
            <h3>No applications found</h3>
            <p>Change the filters or search terms.</p>
          </div>
        ) : (
          <>
            <div className="admissions-table-wrapper">
              <table className="admissions-table">
                <thead>
                  <tr>
                    <th scope="col">Applicant</th>
                    <th scope="col">Application No.</th>
                    <th scope="col">Programme</th>
                    <th scope="col">Intake</th>
                    <th scope="col">Status</th>
                    <th scope="col">Action</th>
                  </tr>
                </thead>

                <tbody>
                  {items.map((item) => (
                    <tr key={item.id}>
                      <td>
                        <div className="admission-person">
                          <strong>
                            {item.firstName} {item.lastName}
                          </strong>
                          <span>{item.email}</span>
                        </div>
                      </td>

                      <td>
                        <code>{item.applicationNumber}</code>
                      </td>

                      <td>{item.programmeName}</td>

                      <td>{item.intakeName}</td>

                      <td>
                        <span
                          className={`admission-status status-${item.status.toLowerCase()}`}
                        >
                          {label(item.status)}
                        </span>
                      </td>

                      <td>
                        <Link
                          to={`/portal/staff/admissions/${encodeURIComponent(item.id)}`}
                          className="admission-view"
                        >
                          <Eye size={17} />
                          Review
                        </Link>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div className="admissions-mobile-list">
              {items.map((item) => (
                <article
                  key={item.id}
                  className="admissions-mobile-card"
                >
                  <div>
                    <strong>
                      {item.firstName} {item.lastName}
                    </strong>
                    <span>{item.applicationNumber}</span>
                  </div>

                  <p>{item.programmeName}</p>

                  <span
                    className={`admission-status status-${item.status.toLowerCase()}`}
                  >
                    {label(item.status)}
                  </span>

                  <Link
                    to={`/portal/staff/admissions/${encodeURIComponent(item.id)}`}
                    className="admission-view"
                  >
                    Review application
                    <Eye size={17} />
                  </Link>
                </article>
              ))}
            </div>
          </>
        )}

        {!loading && totalPages > 1 && (
          <div className="admissions-pagination">
            <span>
              Page {page} of {totalPages}
            </span>

            <div>
              <button
                type="button"
                disabled={page <= 1}
                onClick={() => setPage((v) => v - 1)}
              >
                Previous
              </button>

              <button
                type="button"
                disabled={page >= totalPages}
                onClick={() => setPage((v) => v + 1)}
              >
                Next
              </button>
            </div>
          </div>
        )}
      </section>
    </PortalPage>
  );
}

