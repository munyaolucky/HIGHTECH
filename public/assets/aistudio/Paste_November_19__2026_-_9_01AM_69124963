## **5. Student API service**

### `src/modules/students/student-api.ts`

```

import type {
  StudentListResponse,
  StudentSearchParams,
} from "./student-types";

const API_BASE = "/api/students";

function buildQuery(params: StudentSearchParams) {
  const query = new URLSearchParams();

  Object.entries(params).forEach(([key, value]) => {
    if (value !== undefined && value !== null && value !== "") {
      query.set(key, String(value));
    }
  });

  return query.toString();
}

async function request<T>(url: string): Promise<T> {
  const response = await fetch(url, {
    credentials: "include",
    headers: {
      Accept: "application/json",
    },
  });

  if (!response.ok) {
    throw new Error("Unable to retrieve student records.");
  }

  return response.json() as Promise<T>;
}

export const studentApi = {
  list(
    params: StudentSearchParams
  ): Promise<StudentListResponse> {
    return request<StudentListResponse>(
      `${API_BASE}?${buildQuery(params)}`
    );
  },
};

```

API contract assumption

The endpoint and response format above are proposed. Reuse the existing API client and student route if they already exist. The server must enforce permissions, validate query parameters and restrict which student fields can be returned.

## **6. Student directory page**

### `src/modules/students/StudentDirectoryPage.tsx`

The directory includes search, status filtering, pagination, responsive table/cards and student profile links.

```

import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import {
  Search,
  UserPlus,
  Eye,
  ChevronLeft,
  ChevronRight,
  RefreshCw,
  Users,
} from "lucide-react";

import PortalPage from "../../components/portal/PortalPage";
import { useAuth } from "../../auth/useAuth";

import { studentApi } from "./student-api";
import type {
  StudentRecord,
  StudentStatus,
} from "./student-types";

import "./students.css";

const PAGE_SIZE = 20;

const statusOptions: StudentStatus[] = [
  "ACTIVE",
  "PENDING",
  "DEFERRED",
  "SUSPENDED",
  "COMPLETED",
  "WITHDRAWN",
];

function statusLabel(status: StudentStatus) {
  return status.replace(/_/g, " ");
}

export default function StudentDirectoryPage() {
  const { hasPermission } = useAuth();

  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("");
  const [page, setPage] = useState(1);

  const [students, setStudents] = useState<StudentRecord[]>([]);
  const [total, setTotal] = useState(0);
  const [totalPages, setTotalPages] = useState(0);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const canRegister = hasPermission(
    "student.registration.create"
  );

  useEffect(() => {
    let cancelled = false;

    async function loadStudents() {
      setLoading(true);
      setError("");

      try {
        const response = await studentApi.list({
          q: search || undefined,
          status: status
            ? (status as StudentStatus)
            : undefined,
          page,
          pageSize: PAGE_SIZE,
        });

        if (cancelled) return;

        setStudents(response.items);
        setTotal(response.total);
        setTotalPages(response.totalPages);
      } catch {
        if (!cancelled) {
          setError(
            "Unable to load students. Please try again."
          );
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    loadStudents();

    return () => {
      cancelled = true;
    };
  }, [search, status, page]);

  function handleSearch(value: string) {
    setSearch(value);
    setPage(1);
  }

  function handleStatus(value: string) {
    setStatus(value);
    setPage(1);
  }

  return (
    <PortalPage
      title="Student Directory"
      subtitle="Search, review and manage student records."
      action={
        canRegister ? (
          <Link
            className="student-primary-button"
            to="/portal/staff/students/register"
          >
            <UserPlus size={18} />
            <span>Register Student</span>
          </Link>
        ) : undefined
      }
    >
      <div className="student-directory">
        <div className="student-directory-toolbar">
          <div className="student-search">
            <Search size={19} />

            <input
              type="search"
              value={search}
              onChange={(e) => handleSearch(e.target.value)}
              placeholder="Search students..."
              aria-label="Search students"
            />
          </div>

          <select
            value={status}
            onChange={(e) => handleStatus(e.target.value)}
            aria-label="Filter by student status"
          >
            <option value="">All statuses</option>

            {statusOptions.map((option) => (
              <option key={option} value={option}>
                {statusLabel(option)}
              </option>
            ))}
          </select>
        </div>

        <div className="student-directory-summary">
          <div>
            <Users size={20} />
            <span>
              <strong>{total}</strong> student records
            </span>
          </div>

          <button
            type="button"
            className="student-refresh"
            onClick={() => setPage((current) => current)}
            aria-label="Refresh student records"
          >
            <RefreshCw size={17} />
            Refresh
          </button>
        </div>

        {error && (
          <div className="student-error" role="alert">
            {error}
          </div>
        )}

        {loading ? (
          <div
            className="student-loading"
            role="status"
            aria-live="polite"
          >
            Loading student records...
          </div>
        ) : students.length === 0 ? (
          <div className="student-empty">
            <Users size={40} />
            <h3>No students found</h3>
            <p>
              Try changing your search or filter.
            </p>
          </div>
        ) : (
          <>
            <div className="student-table-wrapper">
              <table className="student-table">
                <thead>
                  <tr>
                    <th scope="col">Student</th>
                    <th scope="col">Registration Number</th>
                    <th scope="col">Programme</th>
                    <th scope="col">Campus</th>
                    <th scope="col">Status</th>
                    <th scope="col">Action</th>
                  </tr>
                </thead>

                <tbody>
                  {students.map((student) => {
                    const fullName = [
                      student.firstName,
                      student.middleName,
                      student.lastName,
                    ]
                      .filter(Boolean)
                      .join(" ");

                    return (
                      <tr key={student.id}>
                        <td>
                          <div className="student-table-person">
                            <div className="student-avatar">
                              {student.photoUrl ? (
                                <img
                                  src={student.photoUrl}
                                  alt=""
                                />
                              ) : (
                                fullName
                                  .slice(0, 1)
                                  .toUpperCase()
                              )}
                            </div>

                            <div>
                              <strong>{fullName}</strong>
                              <span>{student.email}</span>
                            </div>
                          </div>
                        </td>

                        <td>
                          <span className="student-reg-number">
                            {student.registrationNumber}
                          </span>
                        </td>

                        <td>{student.programmeName}</td>

                        <td>
                          {student.campusName || "—"}
                        </td>

                        <td>
                          <span
                            className={`student-status status-${student.status.toLowerCase()}`}
                          >
                            {statusLabel(student.status)}
                          </span>
                        </td>

                        <td>
                          <Link
                            to={`/portal/staff/students/${encodeURIComponent(student.id)}`}
                            className="student-view-link"
                            aria-label={`View ${fullName}`}
                          >
                            <Eye size={17} />
                            View
                          </Link>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <div className="student-mobile-list">
              {students.map((student) => {
                const fullName = [
                  student.firstName,
                  student.middleName,
                  student.lastName,
                ]
                  .filter(Boolean)
                  .join(" ");

                return (
                  <article
                    className="student-mobile-card"
                    key={student.id}
                  >
                    <div className="student-table-person">
                      <div className="student-avatar">
                        {student.photoUrl ? (
                          <img
                            src={student.photoUrl}
                            alt=""
                          />
                        ) : (
                          fullName.slice(0, 1).toUpperCase()
                        )}
                      </div>

                      <div>
                        <strong>{fullName}</strong>
                        <span>
                          {student.registrationNumber}
                        </span>
                      </div>
                    </div>

                    <div className="student-mobile-details">
                      <span>Programme</span>
                      <strong>{student.programmeName}</strong>
                    </div>

                    <div className="student-mobile-details">
                      <span>Status</span>
                      <span
                        className={`student-status status-${student.status.toLowerCase()}`}
                      >
                        {statusLabel(student.status)}
                      </span>
                    </div>

                    <Link
                      to={`/portal/staff/students/${encodeURIComponent(student.id)}`}
                      className="student-view-link student-mobile-view"
                    >
                      View profile
                      <Eye size={17} />
                    </Link>
                  </article>
                );
              })}
            </div>
          </>
        )}

        {!loading && totalPages > 1 && (
          <div className="student-pagination">
            <span>
              Page {page} of {totalPages}
            </span>

            <div>
              <button
                type="button"
                disabled={page <= 1}
                onClick={() => setPage((p) => p - 1)}
                aria-label="Previous page"
              >
                <ChevronLeft size={18} />
              </button>

              <button
                type="button"
                disabled={page >= totalPages}
                onClick={() => setPage((p) => p + 1)}
                aria-label="Next page"
              >
                <ChevronRight size={18} />
              </button>
            </div>
          </div>
        )}
      </div>
    </PortalPage>
  );
}

```

