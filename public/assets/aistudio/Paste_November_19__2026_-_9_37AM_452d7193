              <a href="/portal/activate">Activate Invited Account</a>
              <a href="/portal/registration">Manual User Registration Desk</a>
            </div>
          </div>
        </div>

        {/* BOTTOM BAR */}
        <div className="ht-footer-bottom">
          <div className="ht-footer-bottom-inner">
            <p className="ht-copyright">
              © {new Date().getFullYear()} HI-TECH College of Technology
              & Applied Sciences. All Rights Reserved.
              <br />
              Reg No: TVETA/PUBLIC/0291/2026.
            </p>

            <nav className="ht-legal-links" aria-label="Legal links">
              <a href="/verify">Verify Certificate</a>
              <a href="/fees">Fees Structure</a>
              <a href="/admissions/enquiry">Admissions Enquiry</a>
              <a href="/privacy">Privacy Policy</a>
              <a href="/terms">Terms & Conditions</a>
              <a href="/accessibility">Accessibility</a>
              <a href="/sitemap">Sitemap</a>
            </nav>

            <div className="ht-accreditations">
              <div>
                <ShieldCheck />
                <span><strong>TVETA</strong>Approved</span>
              </div>
              <div>
                <Award />
                <span><strong>KNEC</strong>Registered</span>
              </div>
              <div>
                <ShieldCheck />
                <span><strong>ISO</strong>Certified</span>
              </div>
            </div>
          </div>
        </div>

        {/* Scroll to top */}
        <button
          type="button"
          className="ht-back-to-top"
          onClick={scrollToTop}
          aria-label="Back to top"
          title="Back to top"
        >
          <ArrowUp size={23} />
        </button>
      </footer>

      {/* MOBILE CHAT BUTTON */}
      <button
        type="button"
        className="ht-chat-button"
        onClick={onChatOpen ?? (() => window.dispatchEvent(
          new CustomEvent("hitech:open-chat")
        ))}
        aria-label="Open Dr.IT support chatbot"
      >
        <span className="ht-chat-icon">
          <MessageCircle size={23} />
        </span>
        <span>
          <strong>HI-TECH SUPPORT</strong>
          <small>Ask Questions & Admissions</small>
        </span>
        <span className="ht-chat-status" />
      </button>
    </>
  );
}

