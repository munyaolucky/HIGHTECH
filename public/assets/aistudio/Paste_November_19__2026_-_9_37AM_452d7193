  { label: "About Us", href: "/about" },
  { label: "Academics", href: "/academics" },
  { label: "Admissions", href: "/admissions" },
  { label: "Campus", href: "/campus" },
  { label: "Student Life", href: "/student-life" },
  { label: "Digital Library", href: "/library" },
  { label: "Careers", href: "/careers" },
  { label: "Gallery", href: "/gallery" },
  { label: "FAQs", href: "/faqs" },
  { label: "Contact Us", href: "/contact" },
];

const services = [
  { label: "ICT & Computing", href: "/academics/ict", icon: Monitor },
  { label: "AI & Machine Learning", href: "/academics/ai", icon: Cpu },
  { label: "Business Management", href: "/academics/business", icon: BriefcaseBusiness },
  { label: "Engineering & Technology", href: "/academics/engineering", icon: Building2 },
  { label: "E-Learning Portal", href: "/elearning", icon: BookOpen },
  { label: "Library Services", href: "/library", icon: BookOpen },
  { label: "Student Support", href: "/student-support", icon: Headset },
  { label: "Certifications (KNEC/KASNEB/TVET)", href: "/certifications", icon: Award },
];

const socialLinks = [
  { label: "Facebook", href: "https://facebook.com/", icon: Facebook },
  { label: "LinkedIn", href: "https://linkedin.com/", icon: Linkedin },
  { label: "YouTube", href: "https://youtube.com/", icon: Youtube },
  { label: "Telegram", href: "https://t.me/", icon: Send },
];

export default function Footer({
  onSubscribe,
  onChatOpen,
}: FooterProps) {
  const [email, setEmail] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [message, setMessage] = useState("");
  const [mobileOpen, setMobileOpen] = useState(false);

  const handleSubscribe = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    if (!email.trim()) {
      setMessage("Please enter your email address.");
      return;
    }

    if (!onSubscribe) {
      setMessage("Newsletter subscription is not yet connected.");
      return;
    }

    try {
      setSubmitting(true);
      await onSubscribe(email.trim());
      setMessage("Thank you! Your subscription was received.");
      setEmail("");
    } catch {
      setMessage("Subscription failed. Please try again.");
    } finally {
      setSubmitting(false);
    }
  };

  const scrollToTop = () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  return (
    <>
      <footer className="ht-footer">
        {/* Decorative top edge */}
        <div className="ht-footer-wave" aria-hidden="true" />

        <div className="ht-footer-main">
          <div className="ht-footer-grid">

            {/* COLLEGE INFORMATION */}
            <section className="ht-footer-brand">
              <a href="/" className="ht-brand" aria-label="HI-TECH College homepage">
                <div className="ht-brand-emblem">
                  <GraduationCap size={54} strokeWidth={1.6} />
                  <span>HI-TECH</span>
                </div>

                <div className="ht-brand-text">
                  <div className="ht-brand-name">
                    HI-TECH <span>COLLEGE</span>
                  </div>
                  <p>Excellence in Technology, Skills & Innovation</p>
                </div>
              </a>

              <p className="ht-footer-description">
                Empowering Next-Generation Digital Innovators & Leaders.
                Providing government-accredited diploma and certificate
                programmes in Computing, Artificial Intelligence, Business
                Management, and Engineering with high-fidelity digital
                campus infrastructure.
              </p>

              {/* College statistics */}
              <div className="ht-footer-stats">
                <div className="ht-stat">
                  <GraduationCap />
                  <strong>3,850+</strong>
                  <span>Enrolled Students</span>
                </div>

                <div className="ht-stat">
                  <Award />
                  <strong>98.4%</strong>
                  <span>Success Rate</span>
                </div>

                <div className="ht-stat">
                  <BookOpen />
                  <strong>37+</strong>
                  <span>Programmes</span>
                </div>
              </div>

              {/* Social media */}
              <div className="ht-social-section">
                <strong>Follow Us:</strong>
                <div className="ht-social-links">
                  {socialLinks.map(({ label, href, icon: Icon }) => (
                    <a
                      key={label}
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={label}
                      className={`ht-social ht-social-${label.toLowerCase()}`}
                    >
                      <Icon size={21} />
                    </a>
                  ))}
                </div>
              </div>
            </section>

            {/* QUICK LINKS */}
            <section className="ht-footer-column">
              <h3 className="ht-footer-heading">
                <GraduationCap />
                Quick Links
              </h3>

              <ul className="ht-footer-links">
                {quickLinks.map((link) => (
                  <li key={link.label}>
                    <a href={link.href}>
                      <ChevronRight size={16} />
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>

            {/* SERVICES */}
            <section className="ht-footer-column">
              <h3 className="ht-footer-heading">
                <Building2 />
                Our Services
              </h3>

              <ul className="ht-service-links">
                {services.map(({ label, href, icon: Icon }) => (
                  <li key={label}>
                    <a href={href}>
                      <Icon size={22} />
                      <span>{label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>

            {/* CONTACT AND NEWSLETTER */}
            <section className="ht-footer-contact">
              <h3 className="ht-footer-heading">
                <Phone />
                Contact Us
              </h3>

              <div className="ht-contact-list">
                <div className="ht-contact-item">
                  <span className="ht-contact-icon">
                    <MapPin />
                  </span>
                  <p>
                    <strong>HI-TECH College</strong>
                    <br />
                    Kitengela Campus,
                    <br />
                    P.O. Box 1849-00100 Nairobi, Kenya
                  </p>
                </div>

                <div className="ht-contact-item">
                  <span className="ht-contact-icon">
                    <Phone />
                  </span>
                  <p>
                    <a href="tel:+254207801200">
                      +254 (0) 20 780 1200
                    </a>
                    <br />
                    <a href="tel:+254772345678">
                      +254 772 345 678
                    </a>
                  </p>
                </div>

                <div className="ht-contact-item">
                  <span className="ht-contact-icon">
                    <Mail />
                  </span>
                  <p>
                    <a href="mailto:info@hitech.ac.ke">
                      info@hitech.ac.ke
                    </a>
                  </p>
                </div>

                <div className="ht-contact-item">
                  <span className="ht-contact-icon">
                    <Clock />
                  </span>
                  <p>
                    Mon - Fri: 7:30 AM - 6:00 PM
                    <br />
                    Sat: 8:00 AM - 2:00 PM
                  </p>
                </div>
              </div>

              {/* Campus image */}
              <div className="ht-footer-campus">
                <img
                  src="/images/campus/campus-students.jpg"
                  alt="HI-TECH College campus and students"
                  loading="lazy"
                  onError={(event) => {
                    event.currentTarget.style.display = "none";
                  }}
                />
                <div className="ht-campus-overlay">
                  <Building2 size={19} />
                  <span>Explore Our Campus</span>
                  <a href="/campus" aria-label="Explore our campus">
                    <ArrowRight size={19} />
                  </a>
                </div>
              </div>

              {/* Newsletter */}
              <div className="ht-newsletter">
                <div className="ht-newsletter-title">
                  <Newspaper size={27} />
                  <div>
                    <h4>Subscribe to Our Newsletter</h4>
                    <p>Get the latest updates and academic news.</p>
                  </div>
                </div>

                <form
                  className="ht-newsletter-form"
                  onSubmit={handleSubscribe}
                >
                  <label className="ht-visually-hidden" htmlFor="ht-newsletter-email">
                    Email address
                  </label>

                  <input
                    id="ht-newsletter-email"
                    type="email"
                    placeholder="Enter your email address"
                    value={email}
                    onChange={(event) => setEmail(event.target.value)}
                    required
                    disabled={submitting}
                  />

                  <button type="submit" disabled={submitting}>
                    {submitting ? "Sending..." : "Subscribe"}
                    <ArrowRight size={19} />
                  </button>
                </form>

                {message && (
                  <p className="ht-newsletter-message" role="status">
                    {message}
                  </p>
                )}
              </div>
            </section>
          </div>
        </div>

        {/* PORTAL ACCESS STRIP */}
        <div className="ht-footer-portals">
          <div className="ht-portal-content">
            <div>
              <span className="ht-portal-label">
                <LockKeyhole size={15} />
