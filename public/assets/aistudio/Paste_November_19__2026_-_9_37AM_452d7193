  margin-bottom: 5px;
  padding: 12px 15px;
  border: 1px solid #28518d;
  border-radius: 8px;
  background: #102b52;
  font-size: 12px;
  font-weight: 700;
  transition: .2s;
}

.ht-portal-button:hover {
  background: #193d70;
  border-color: var(--ht-gold);
}

.ht-student-login {
  background: var(--ht-red);
  border-color: var(--ht-red);
}

.ht-student-login:hover {
  background: #b80019;
}

.ht-staff-access {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.ht-staff-access a {
  color: var(--ht-muted);
  font-size: 12px;
  transition: color .2s;
}

.ht-staff-access a:hover {
  color: var(--ht-gold);
}

/* Bottom bar */

.ht-footer-bottom {
  border-top: 3px solid var(--ht-gold);
  background: #061323;
  padding: 20px 32px;
}

.ht-footer-bottom-inner {
  max-width: 1800px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}

.ht-copyright {
  color: var(--ht-muted);
  font-size: 11px;
  line-height: 1.8;
  margin: 0;
  flex: 1.2;
}

.ht-legal-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  flex: 1.5;
}

.ht-legal-links a {
  color: var(--ht-muted);
  font-size: 11px;
  border-right: 1px solid rgba(255,255,255,.4);
  padding-right: 12px;
}

.ht-legal-links a:last-child {
  border: 0;
}

.ht-legal-links a:hover {
  color: var(--ht-gold);
}

.ht-accreditations {
  display: flex;
  gap: 16px;
  align-items: center;
}

.ht-accreditations > div {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ht-accreditations svg {
  width: 30px;
  height: 30px;
  color: var(--ht-gold);
}

.ht-accreditations span {
  display: flex;
  flex-direction: column;
  font-size: 9px;
  color: var(--ht-muted);
}

.ht-accreditations strong {
  color: white;
  font-size: 12px;
}

/* Back to top */

.ht-back-to-top {
  position: absolute;
  right: 30px;
  top: 44%;
  width: 43px;
  height: 43px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.5);
  background: #173c6b;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: .2s;
  z-index: 5;
}

.ht-back-to-top:hover {
  background: var(--ht-red);
  transform: translateY(-4px);
}

/* Dr.IT chatbot */

.ht-chat-button {
  position: fixed;
  right: 25px;
  bottom: 22px;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 18px 10px 11px;
  border: 1px solid var(--ht-gold);
  border-radius: 40px;
  background: #087c60;
  color: white;
  box-shadow: 0 7px 25px rgba(0,0,0,.3);
  cursor: pointer;
  transition: transform .2s, background .2s;
}

.ht-chat-button:hover {
  background: #05694f;
  transform: translateY(-4px);
}

.ht-chat-icon {
  width: 37px;
  height: 37px;
  border-radius: 50%;
  background: var(--ht-gold);
  color: var(--ht-navy);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ht-chat-button > span:nth-child(2) {
  display: flex;
  flex-direction: column;
  text-align: left;
  gap: 3px;
}

.ht-chat-button strong {
  font-size: 11px;
  color: var(--ht-gold);
}

.ht-chat-button small {
  font-size: 12px;
  font-weight: 700;
}

.ht-chat-status {
  position: absolute;
  right: 12px;
  top: 7px;
  height: 9px;
  width: 9px;
  background: #20e58b;
  border-radius: 50%;
  box-shadow: 0 0 0 3px rgba(32,229,139,.2);
}

/* Tablet */

@media (max-width: 1150px) {
  .ht-footer-grid {
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
  }

  .ht-footer-brand {
