function formatTime(seconds?: number) {
  if (seconds == null) return "--:--";

  const safe = Math.max(0, seconds);
  const hours = Math.floor(safe / 3600);
  const minutes = Math.floor((safe % 3600) / 60);
  const remaining = safe % 60;

  if (hours > 0) {
    return `${hours}:${String(minutes).padStart(2, "0")}:${String(
      remaining
    ).padStart(2, "0")}`;
  }

  return `${minutes}:${String(remaining).padStart(2, "0")}`;
}

function formatDate(date?: string) {
  if (!date) return "—";

  return new Date(date).toLocaleTimeString("en-KE", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function ExaminationSupervisorDashboard() {
  const [candidates, setCandidates] =
    useState<CandidateSession[]>(initialCandidates);

  const [incidents, setIncidents] =
    useState<SecurityIncident[]>(initialIncidents);

  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] =
    useState<CandidateExamStatus | "ALL">("ALL");

  const [selectedCandidate, setSelectedCandidate] =
    useState<CandidateSession | null>(null);

  const [activeTab, setActiveTab] = useState<
    "candidates" | "incidents" | "reports" | "audit"
  >("candidates");

  const counts = useMemo(() => {
    const count = (status: CandidateExamStatus) =>
      candidates.filter((c) => c.status === status).length;

    return {
      total: candidates.length,
      active: count("ACTIVE"),
      disconnected: count("DISCONNECTED"),
      submitted: count("SUBMITTED"),
      notStarted: count("NOT_STARTED"),
      expired: count("EXPIRED"),
      terminated: count("TERMINATED"),
    };
  }, [candidates]);

  const filteredCandidates = candidates.filter((candidate) => {
    const matchesSearch =
      candidate.studentName.toLowerCase().includes(search.toLowerCase()) ||
      candidate.registrationNumber
        .toLowerCase()
        .includes(search.toLowerCase());

    const matchesStatus =
      statusFilter === "ALL" || candidate.status === statusFilter;

    return matchesSearch && matchesStatus;
  });

  function updateStatus(
    id: string,
    status: CandidateExamStatus,
    reason: string
  ) {
    if (!reason.trim()) {
      window.alert("An intervention reason is required.");
      return;
    }

    setCandidates((previous) =>
      previous.map((candidate) =>
        candidate.id === id
          ? {
              ...candidate,
              status,
              connection:
                status === "ACTIVE" ? "ONLINE" : candidate.connection,
            }
          : candidate
      )
    );

    setSelectedCandidate(null);
  }

  function reviewIncident(id: string, notes: string) {
    setIncidents((previous) =>
      previous.map((incident) =>
        incident.id === id
          ? {
              ...incident,
              reviewed: true,
              reviewNotes: notes,
            }
          : incident
      )
    );
  }

  return (
    <main className="supervisor-dashboard">
      <header className="supervisor-header">
        <div>
          <span className="supervisor-eyebrow">
            EXAMINATION MANAGEMENT
          </span>

          <h1>Examination Supervisor</h1>

          <p>
            Monitor candidates, manage exam sessions and review
            examination incidents.
          </p>
        </div>

        <div className="live-indicator">
          <span className="live-dot" />
          Monitoring
        </div>
      </header>

      <section className="exam-session-banner">
        <div>
          <span className="session-label">CURRENT EXAMINATION</span>
          <h2>Computer Packages</h2>
          <p>November 2026 · CAT / Final Assessment</p>
        </div>

        <div className="session-banner-meta">
          <div>
            <span>Session status</span>
            <strong>Running</strong>
          </div>
          <div>
            <span>Exam duration</span>
            <strong>2 Hours</strong>
          </div>
        </div>
      </section>

      <section className="supervisor-stats">
        <StatCard label="Candidates" value={counts.total} />
        <StatCard label="Active" value={counts.active} tone="success" />
        <StatCard
          label="Disconnected"
          value={counts.disconnected}
          tone="warning"
        />
        <StatCard label="Submitted" value={counts.submitted} tone="blue" />
        <StatCard label="Not started" value={counts.notStarted} />
        <StatCard label="Expired" value={counts.expired} tone="danger" />
      </section>

      <nav className="supervisor-tabs" aria-label="Exam monitoring sections">
        {(["candidates", "incidents", "reports", "audit"] as const).map(
          (tab) => (
            <button
              key={tab}
              className={activeTab === tab ? "active" : ""}
              onClick={() => setActiveTab(tab)}
            >
              {tab === "candidates"
                ? "Candidates"
                : tab === "incidents"
                ? `Incidents (${incidents.filter((i) => !i.reviewed).length})`
                : tab === "reports"
                ? "Reports"
                : "Audit trail"}
            </button>
          )
        )}
      </nav>

      {activeTab === "candidates" && (
        <section className="supervisor-panel">
          <div className="panel-heading">
            <div>
              <h2>Candidate monitoring</h2>
              <p>Inspect and manage examination sessions.</p>
            </div>
          </div>

          <div className="candidate-filters">
            <input
              aria-label="Search candidate"
              placeholder="Search name or registration number..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />

            <select
              aria-label="Filter candidate status"
              value={statusFilter}
              onChange={(e) =>
                setStatusFilter(
                  e.target.value as CandidateExamStatus | "ALL"
                )
              }
            >
              <option value="ALL">All statuses</option>
              <option value="ACTIVE">Active</option>
              <option value="DISCONNECTED">Disconnected</option>
              <option value="SUBMITTED">Submitted</option>
              <option value="NOT_STARTED">Not started</option>
              <option value="EXPIRED">Expired</option>
              <option value="TERMINATED">Terminated</option>
            </select>
          </div>

          <CandidateTable
            candidates={filteredCandidates}
            onInspect={setSelectedCandidate}
          />
        </section>
      )}

      {activeTab === "incidents" && (
        <IncidentList
          incidents={incidents}
          onReview={reviewIncident}
        />
      )}

      {activeTab === "reports" && (
        <ExamReport candidates={candidates} />
      )}

      {activeTab === "audit" && (
        <AuditTrail />
      )}

      {selectedCandidate && (
        <CandidateInspection
          candidate={selectedCandidate}
          onClose={() => setSelectedCandidate(null)}
          onIntervention={updateStatus}
        />
      )}
    </main>
  );
}

