  );
}

function IncidentList({
  incidents,
  onReview,
}: {
  incidents: SecurityIncident[];
  onReview: (id: string, notes: string) => void;
}) {
  return (
    <section className="supervisor-panel">
      <h2>Security incident monitoring</h2>

      {incidents.length === 0 ? (
        <p>No recorded incidents.</p>
      ) : (
        <div className="incident-list">
          {incidents.map((incident) => (
            <article key={incident.id} className="incident-item">
              <div>
                <strong>{incident.studentName}</strong>
                <small>{incident.registrationNumber}</small>
              </div>

              <div>
                <span className={`severity ${incident.severity.toLowerCase()}`}>
                  {incident.severity}
                </span>

                <strong>{incident.eventType.replace(/_/g, " ")}</strong>
                <p>{incident.description}</p>
                <small>{formatDate(incident.occurredAt)}</small>
              </div>

              <div>
                {incident.reviewed ? (
                  <span className="reviewed">Reviewed</span>
                ) : (
                  <button
                    onClick={() => {
                      const notes = window.prompt(
                        "Enter incident review notes:"
                      );

                      if (notes?.trim()) {
                        onReview(incident.id, notes);
                      }
                    }}
                  >
                    Review
                  </button>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  );
}

function CandidateInspection({
  candidate,
  onClose,
  onIntervention,
}: {
  candidate: CandidateSession;
  onClose: () => void;
  onIntervention: (
    id: string,
    status: CandidateExamStatus,
    reason: string
  ) => void;
}) {
  const [reason, setReason] = useState("");

  return (
    <div className="supervisor-modal-backdrop">
      <section
        className="supervisor-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="candidate-inspection-title"
      >
        <header>
          <div>
            <h2 id="candidate-inspection-title">Candidate inspection</h2>
            <p>{candidate.registrationNumber}</p>
          </div>
          <button onClick={onClose} aria-label="Close inspection">
            ×
          </button>
        </header>

        <div className="candidate-details">
          <Detail label="Student" value={candidate.studentName} />
          <Detail label="Exam" value={candidate.examName} />
          <Detail label="Status" value={statusLabels[candidate.status]} />
          <Detail label="Connection" value={candidate.connection} />
          <Detail label="Started" value={formatDate(candidate.startedAt)} />
          <Detail
            label="Remaining"
            value={formatTime(candidate.remainingSeconds)}
          />
          <Detail label="Progress" value={`${candidate.progress}%`} />
          <Detail
            label="Incidents"
            value={String(candidate.securityEvents)}
          />
        </div>

        <div className="intervention-section">
          <h3>Supervisor intervention</h3>

          <label htmlFor="intervention-reason">
            Reason for action
          </label>

          <textarea
            id="intervention-reason"
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            placeholder="Enter the reason. This will be recorded in the audit trail."
          />

          <div className="intervention-actions">
            <button
              onClick={() =>
                onIntervention(candidate.id, "ACTIVE", reason)
              }
            >
              Restore session
            </button>

            <button
              className="warning-action"
              onClick={() =>
                onIntervention(candidate.id, "SUBMITTED", reason)
              }
            >
              Manual submit
            </button>

            <button
              className="danger-action"
              onClick={() =>
                onIntervention(candidate.id, "TERMINATED", reason)
              }
            >
              Terminate session
            </button>
          </div>
        </div>
      </section>
    </div>
  );
}

function Detail({ label, value }: { label: string; value: string }) {
  return (
    <div className="candidate-detail">
      <span>{label}</span>
      <strong>{value}</strong>
    </div>
  );
}

function ExamReport({ candidates }: { candidates: CandidateSession[] }) {
  const submitted = candidates.filter((c) => c.status === "SUBMITTED");
  const active = candidates.filter((c) => c.status === "ACTIVE");
  const disconnected = candidates.filter(
    (c) => c.status === "DISCONNECTED"
  );

  return (
    <section className="supervisor-panel">
      <h2>Examination report</h2>

      <div className="report-summary">
        <Detail label="Registered" value={String(candidates.length)} />
        <Detail label="Submitted" value={String(submitted.length)} />
        <Detail label="Active" value={String(active.length)} />
        <Detail label="Disconnected" value={String(disconnected.length)} />
      </div>

      <button
        onClick={() => {
          const csv = [
            [
              "Student",
              "Registration",
              "Status",
              "Progress",
              "Incidents",
            ],
            ...candidates.map((c) => [
              c.studentName,
              c.registrationNumber,
              c.status,
              String(c.progress),
              String(c.securityEvents),
            ]),
          ]
            .map((row) =>
              row
                .map((value) => `"${String(value).replace(/"/g, '""')}"`)
                .join(",")
            )
            .join("\r\n");

          const blob = new Blob([csv], {
            type: "text/csv;charset=utf-8",
          });

          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = "exam-supervisor-report.csv";
          link.click();
          URL.revokeObjectURL(url);
        }}
      >
        Export CSV
      </button>
    </section>
  );
}

function AuditTrail() {
  return (
    <section className="supervisor-panel">
      <h2>Supervisor audit trail</h2>
      <p>
        The audit trail will record supervisor interventions,
        submissions, incident reviews and termination actions.
      </p>

      <p>
        The live audit table will be populated from the server's
        examination audit records.
      </p>
    </section>
  );
}
```

