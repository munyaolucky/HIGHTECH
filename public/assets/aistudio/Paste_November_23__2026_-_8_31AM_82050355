export type CandidateExamStatus =
  | "NOT_STARTED"
  | "ACTIVE"
  | "DISCONNECTED"
  | "SUBMITTED"
  | "EXPIRED"
  | "TERMINATED";

export type SecurityEventType =
  | "TAB_SWITCH"
  | "FULLSCREEN_EXIT"
  | "COPY_ATTEMPT"
  | "PASTE_ATTEMPT"
  | "MULTIPLE_DISCONNECTS"
  | "UNUSUAL_ACTIVITY"
  | "OTHER";

export interface CandidateSession {
  id: string;
  studentId: string;
  registrationNumber: string;
  studentName: string;
  examName: string;
  status: CandidateExamStatus;
  startedAt?: string;
  submittedAt?: string;
  lastSeenAt?: string;
  remainingSeconds?: number;
  progress: number;
  securityEvents: number;
  connection: "ONLINE" | "OFFLINE";
}

export interface SecurityIncident {
  id: string;
  candidateSessionId: string;
  studentName: string;
  registrationNumber: string;
  eventType: SecurityEventType;
  description: string;
  occurredAt: string;
  severity: "LOW" | "MEDIUM" | "HIGH";
  reviewed: boolean;
  reviewNotes?: string;
}

export interface SupervisorAction {
  id: string;
  candidateSessionId: string;
  action:
    | "EXTEND_TIME"
    | "FORCE_SUBMIT"
    | "TERMINATE"
    | "RECONNECT"
    | "MARK_ATTENDANCE"
    | "REVIEW_INCIDENT";
  reason: string;
  performedBy: string;
  performedAt: string;
}
```

