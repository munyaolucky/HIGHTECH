## **10. Session extension service**

**Proposed path:** `apps/api/src/modules/exams/supervisor/supervisor.service.ts`

```

import { prisma } from "../../../../lib/prisma";

export async function extendExamSession(
  sessionId: string,
  actorId: string,
  minutes: number,
  reason: string
) {
  return prisma.$transaction(async (tx) => {
    const session = await tx.examSession.findUnique({
      where: { id: sessionId },
    });

    if (!session) {
      throw new Error("Exam session not found.");
    }

    if (session.status !== "ACTIVE") {
      throw new Error("Only active sessions can be extended.");
    }

    const now = new Date();

    if (session.expiresAt <= now) {
      throw new Error("Expired sessions cannot be extended.");
    }

    const newExpiry = new Date(
      session.expiresAt.getTime() + minutes * 60 * 1000
    );

    const updated = await tx.examSession.update({
      where: { id: sessionId },
      data: { expiresAt: newExpiry },
    });

    await tx.examSupervisorAction.create({
      data: {
        sessionId,
        actorId,
        actionType: "TIME_EXTENSION",
        reason,
        details: {
          minutes,
          previousExpiry: session.expiresAt.toISOString(),
          newExpiry: newExpiry.toISOString(),
        },
      },
    });

    return updated;
  });
}

```

**The extension service is a starting example. Production must use permission checks, concurrency control, a consistent policy for the original exam closing time and audit protection.**

## **11. Termination service**

```

import { prisma } from "../../../../lib/prisma";

export async function terminateExamSession(
  sessionId: string,
  actorId: string,
  reason: string
) {
  return prisma.$transaction(async (tx) => {
    const session = await tx.examSession.findUnique({
      where: { id: sessionId },
    });

    if (!session) {
      throw new Error("Exam session not found.");
    }

    if (session.status !== "ACTIVE") {
      throw new Error("Session is not active.");
    }

    const updated = await tx.examSession.update({
      where: { id: sessionId },
      data: {
        status: "TERMINATED",
        submittedAt: new Date(),
      },
    });

    await tx.examSupervisorAction.create({
      data: {
        sessionId,
        actorId,
        actionType: "SESSION_TERMINATION",
        reason,
      },
    });

    return updated;
  });
}

```

Termination and force-submission are different actions and should not be treated interchangeably. Termination should preserve answers and record the reason. Whether terminated attempts are marked, reviewed or excluded should be decided by examination policy.

