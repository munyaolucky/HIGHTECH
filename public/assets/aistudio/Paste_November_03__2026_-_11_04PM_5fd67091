## 2. Governance service

Create `apps/api/src/services/aiGovernance.ts`.

This service centralizes AI enablement checks so that the chatbot cannot bypass the emergency disable switch.

```

import { prisma } from "../lib/prisma";

export async function isAIAvailable(institutionId: string) {
  const configuration = await prisma.chatbotAIConfiguration.findUnique({
    where: { institutionId },
    select: {
      enabled: true,
      globalEnabled: true,
      emergencyDisabled: true,
    },
  });

  if (!configuration) return false;

  return (
    configuration.enabled &&
    configuration.globalEnabled &&
    !configuration.emergencyDisabled &&
    process.env.CHATBOT_AI_ENABLED === "true"
  );
}

export async function recordAIUsage(input: {
  institutionId: string;
  userId?: string | null;
  conversationId?: string | null;
  providerKey: string;
  model: string;
  operation: string;
  inputTokens?: number;
  outputTokens?: number;
  estimatedCost?: number;
  requestStatus: "SUCCESS" | "FAILED" | "BLOCKED";
}) {
  const inputTokens = Math.max(0, Math.trunc(input.inputTokens ?? 0));
  const outputTokens = Math.max(0, Math.trunc(input.outputTokens ?? 0));
  const estimatedCost = Math.max(0, input.estimatedCost ?? 0);

  return prisma.aIUsageRecord.create({
    data: {
      institutionId: input.institutionId,
      userId: input.userId ?? null,
      conversationId: input.conversationId ?? null,
      providerKey: input.providerKey,
      model: input.model,
      operation: input.operation,
      inputTokens,
      outputTokens,
      totalTokens: inputTokens + outputTokens,
      estimatedCost,
      requestStatus: input.requestStatus,
    },
  });
}

export async function recordGovernanceAudit(input: {
  institutionId: string;
  actorId?: string | null;
  action:
    | "CONFIG_UPDATED"
    | "AI_ENABLED"
    | "AI_DISABLED"
    | "EMERGENCY_DISABLED"
    | "PROVIDER_CHECKED"
    | "PROMPT_CREATED"
    | "PROMPT_PUBLISHED"
    | "PROMPT_ARCHIVED"
    | "QUOTA_UPDATED"
    | "INDEXING_REQUESTED";
  targetType: string;
  targetId?: string | null;
  details?: Record<string, unknown>;
}) {
  return prisma.aIGovernanceAudit.create({
    data: {
      institutionId: input.institutionId,
      actorId: input.actorId ?? null,
      action: input.action,
      targetType: input.targetType,
      targetId: input.targetId ?? null,
      details: input.details as object | undefined,
    },
  });
}

```

Use `isAIAvailable()` before calling the generation provider in `chatbotRAG.ts` or the main chatbot route. The environment variable remains an additional platform-level safety gate.

## 3. AI governance API

Create `apps/api/src/routes/aiGovernance.ts`.

This API provides configuration, emergency controls, usage reports and quotas. It deliberately does not accept provider API keys.

```

import { Router } from "express";
import { z } from "zod";
import { prisma } from "../lib/prisma";
import { requireAuth } from "../middleware/requireAuth";
import { allowRoles } from "../middleware/allowRoles";
import { recordGovernanceAudit } from "../services/aiGovernance";

const router = Router();

router.use(requireAuth);
router.use(allowRoles("SUPER_ADMIN", "ADMIN"));

function scope(req: any) {
  const institutionId = req.user?.institutionId;
  const actorId = req.user?.id;

  if (!institutionId || !actorId) {
    throw new Error("Missing authenticated institution or user.");
  }

  return { institutionId, actorId };
}

const configSchema = z.object({
  enabled: z.boolean(),
  globalEnabled: z.boolean(),
  monthlyTokenLimit: z.number().int().min(0).max(100_000_000),
  monthlyRequestLimit: z.number().int().min(0).max(1_000_000),
  confidenceThreshold: z.number().min(0).max(1),
  maxContextArticles: z.number().int().min(1).max(10),
  responseLanguage: z.enum(["auto", "en", "sw"]),
});

router.get("/configuration", async (req, res) => {
  try {
    const { institutionId } = scope(req);

    const configuration = await prisma.chatbotAIConfiguration.findUnique({
      where: { institutionId },
      select: {
        enabled: true,
        globalEnabled: true,
        emergencyDisabled: true,
        monthlyTokenLimit: true,
        monthlyRequestLimit: true,
        confidenceThreshold: true,
        maxContextArticles: true,
        responseLanguage: true,
        updatedAt: true,
      },
    });

    return res.json({
      configuration: configuration ?? null,
      environmentEnabled: process.env.CHATBOT_AI_ENABLED === "true",
    });
  } catch {
    return res.status(400).json({ message: "Unable to load AI configuration." });
  }
});

router.patch("/configuration", async (req, res) => {
  const parsed = configSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({
      message: "Invalid AI configuration.",
      errors: parsed.error.flatten(),
    });
  }

  try {
    const { institutionId, actorId } = scope(req);

    const current = await prisma.chatbotAIConfiguration.findUnique({
      where: { institutionId },
    });

    const next = parsed.data;

    const configuration = await prisma.chatbotAIConfiguration.upsert({
      where: { institutionId },
      create: {
        institutionId,
        ...next,
      },
      update: next,
      select: {
        enabled: true,
        globalEnabled: true,
        emergencyDisabled: true,
        monthlyTokenLimit: true,
        monthlyRequestLimit: true,
        confidenceThreshold: true,
        maxContextArticles: true,
        responseLanguage: true,
        updatedAt: true,
      },
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "CONFIG_UPDATED",
      targetType: "AI_CONFIGURATION",
      details: {
        previousEnabled: current?.enabled ?? false,
        enabled: next.enabled,
        globalEnabled: next.globalEnabled,
        monthlyTokenLimit: next.monthlyTokenLimit,
        monthlyRequestLimit: next.monthlyRequestLimit,
      },
    });

    return res.json({ configuration });
  } catch (error) {
    console.error("AI configuration update failed:", error);
    return res.status(500).json({ message: "Unable to update AI configuration." });
  }
});

router.post("/emergency-disable", async (req, res) => {
  try {
    const { institutionId, actorId } = scope(req);

    const configuration = await prisma.chatbotAIConfiguration.upsert({
      where: { institutionId },
      create: {
        institutionId,
        enabled: false,
        globalEnabled: false,
        emergencyDisabled: true,
      },
      update: {
        enabled: false,
        globalEnabled: false,
        emergencyDisabled: true,
      },
      select: {
        enabled: true,
        globalEnabled: true,
        emergencyDisabled: true,
      },
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "EMERGENCY_DISABLED",
      targetType: "AI_CONFIGURATION",
      details: { reason: "Administrator emergency disable action." },
    });

    return res.json({
      message: "AI has been disabled for this institution.",
      configuration,
    });
  } catch (error) {
    console.error("AI emergency disable failed:", error);
    return res.status(500).json({ message: "Unable to disable AI." });
  }
});

router.post("/restore", async (req, res) => {
  try {
    const { institutionId, actorId } = scope(req);

    const configuration = await prisma.chatbotAIConfiguration.update({
      where: { institutionId },
      data: { emergencyDisabled: false },
      select: {
        enabled: true,
        globalEnabled: true,
        emergencyDisabled: true,
      },
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "CONFIG_UPDATED",
      targetType: "AI_CONFIGURATION",
      details: { emergencyDisableRestored: true },
    });

    return res.json({
      message: "Emergency disable has been lifted. Normal AI controls still apply.",
      configuration,
    });
  } catch (error) {
    console.error("AI restore failed:", error);
    return res.status(500).json({ message: "Unable to restore AI controls." });
  }
});

router.get("/usage", async (req, res) => {
  try {
    const { institutionId } = scope(req);
    const monthStart = new Date();
    monthStart.setDate(1);
    monthStart.setHours(0, 0, 0, 0);

    const [
      totals,
      successfulRequests,
      failedRequests,
      recentRecords,
    ] = await Promise.all([
      prisma.aIUsageRecord.aggregate({
        where: { institutionId, createdAt: { gte: monthStart } },
        _sum: {
          inputTokens: true,
          outputTokens: true,
          totalTokens: true,
          estimatedCost: true,
        },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.count({
        where: {
          institutionId,
          createdAt: { gte: monthStart },
          requestStatus: "SUCCESS",
        },
      }),
      prisma.aIUsageRecord.count({
        where: {
          institutionId,
          createdAt: { gte: monthStart },
          requestStatus: "FAILED",
        },
      }),
      prisma.aIUsageRecord.findMany({
        where: { institutionId },
        orderBy: { createdAt: "desc" },
        take: 50,
        select: {
          providerKey: true,
          model: true,
          operation: true,
          inputTokens: true,
          outputTokens: true,
          totalTokens: true,
          estimatedCost: true,
          requestStatus: true,
          createdAt: true,
        },
      }),
    ]);

    return res.json({
      period: { start: monthStart },
      totals: {
        requests: totals._count._all,
        successfulRequests,
        failedRequests,
        inputTokens: totals._sum.inputTokens ?? 0,
        outputTokens: totals._sum.outputTokens ?? 0,
        totalTokens: totals._sum.totalTokens ?? 0,
        estimatedCost: Number(totals._sum.estimatedCost ?? 0),
      },
      recentRecords,
    });
  } catch (error) {
    console.error("AI usage report failed:", error);
    return res.status(500).json({ message: "Unable to load AI usage." });
  }
});

const quotaSchema = z.object({
  role: z.string().min(2).max(50),
  monthlyTokens: z.number().int().min(0).max(100_000_000),
  monthlyRequests: z.number().int().min(0).max(1_000_000),
  enabled: z.boolean(),
});

router.get("/quotas", async (req, res) => {
  try {
    const { institutionId } = scope(req);

    const quotas = await prisma.aIUsageQuota.findMany({
      where: { institutionId },
      orderBy: { role: "asc" },
    });

    return res.json({ quotas });
  } catch {
    return res.status(500).json({ message: "Unable to load AI quotas." });
  }
});

router.put("/quotas", async (req, res) => {
  const parsed = quotaSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({ message: "Invalid quota configuration." });
  }

  try {
    const { institutionId, actorId } = scope(req);
    const quota = await prisma.aIUsageQuota.upsert({
      where: {
        institutionId_role: {
          institutionId,
          role: parsed.data.role,
        },
      },
      create: { institutionId, ...parsed.data },
      update: {
        monthlyTokens: parsed.data.monthlyTokens,
        monthlyRequests: parsed.data.monthlyRequests,
        enabled: parsed.data.enabled,
      },
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "QUOTA_UPDATED",
      targetType: "AI_USAGE_QUOTA",
      targetId: quota.id,
      details: {
        role: quota.role,
        monthlyTokens: quota.monthlyTokens,
        monthlyRequests: quota.monthlyRequests,
        enabled: quota.enabled,
      },
    });

    return res.json({ quota });
  } catch (error) {
    console.error("AI quota update failed:", error);
    return res.status(500).json({ message: "Unable to update AI quota." });
  }
});

router.get("/audit", async (req, res) => {
  try {
    const { institutionId } = scope(req);

    const records = await prisma.aIGovernanceAudit.findMany({
      where: { institutionId },
      orderBy: { createdAt: "desc" },
      take: 100,
    });

    return res.json({ records });
  } catch {
    return res.status(500).json({ message: "Unable to load AI audit records." });
  }
});

export default router;

```

