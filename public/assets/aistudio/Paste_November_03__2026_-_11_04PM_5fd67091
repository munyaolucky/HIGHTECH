## 4. Enforce quotas before AI requests

Create `apps/api/src/services/aiQuota.ts`.

This service checks the institution's monthly token and request limits, plus the authenticated user's role quota.

```

import { prisma } from "../lib/prisma";

export async function checkAIQuota(input: {
  institutionId: string;
  role: string;
}) {
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);

  const configuration = await prisma.chatbotAIConfiguration.findUnique({
    where: { institutionId },
    select: {
      enabled: true,
      globalEnabled: true,
      emergencyDisabled: true,
      monthlyTokenLimit: true,
      monthlyRequestLimit: true,
    },
  });

  if (
    !configuration ||
    !configuration.enabled ||
    !configuration.globalEnabled ||
    configuration.emergencyDisabled ||
    process.env.CHATBOT_AI_ENABLED !== "true"
  ) {
    return { allowed: false, reason: "AI is disabled." };
  }

  const quota = await prisma.aIUsageQuota.findUnique({
    where: {
      institutionId_role: {
        institutionId: input.institutionId,
        role: input.role,
      },
    },
  });

  if (quota && !quota.enabled) {
    return { allowed: false, reason: "AI access is disabled for this role." };
  }

  const [institutionUsage, roleUsage] = await Promise.all([
    prisma.aIUsageRecord.aggregate({
      where: { institutionId: input.institutionId, createdAt: { gte: monthStart } },
      _sum: { totalTokens: true },
      _count: { _all: true },
    }),
    quota
      ? prisma.aIUsageRecord.aggregate({
          where: {
            institutionId: input.institutionId,
            createdAt: { gte: monthStart },
            // Role-specific usage requires a role field on AIUsageRecord.
          },
          _sum: { totalTokens: true },
          _count: { _all: true },
        })
      : Promise.resolve(null),
  ]);

  const institutionTokens = institutionUsage._sum.totalTokens ?? 0;
  const institutionRequests = institutionUsage._count._all;

  if (
    configuration.monthlyTokenLimit > 0 &&
    institutionTokens >= configuration.monthlyTokenLimit
  ) {
    return { allowed: false, reason: "Institution monthly token quota reached." };
  }

  if (
    configuration.monthlyRequestLimit > 0 &&
    institutionRequests >= configuration.monthlyRequestLimit
  ) {
    return { allowed: false, reason: "Institution monthly request quota reached." };
  }

  if (quota && roleUsage) {
    const roleTokens = roleUsage._sum.totalTokens ?? 0;
    const roleRequests = roleUsage._count._all;

    if (quota.monthlyTokens > 0 && roleTokens >= quota.monthlyTokens) {
      return { allowed: false, reason: "Role monthly token quota reached." };
    }

    if (quota.monthlyRequests > 0 && roleRequests >= quota.monthlyRequests) {
      return { allowed: false, reason: "Role monthly request quota reached." };
    }
  }

  return { allowed: true, reason: null };
}

```

Required schema refinement for accurate role quotas: Add `userRole String?` to `AIUsageRecord`, and record the authenticated user's role with every request. Then add `userRole: input.role` to the usage record and filter the role aggregation using `userRole: input.role`.

Replace the role aggregation filter with:

```
where: {
  institutionId: input.institutionId,
  userRole: input.role,
  createdAt: { gte: monthStart },
}
```

The quota check above is a preflight check, not a concurrency-safe reservation. For strict limits under high request volume, implement an atomic monthly usage counter or transactional quota reservation before provider calls. Also, zero limits currently mean unlimited; if the college wants zero to mean disabled, change that policy consistently.

## 5. Provider health checks

Do not let an administrator enter an arbitrary URL and have the server fetch it. That can create server-side request forgery (SSRF) vulnerabilities.

For this module, provider health checks should use the provider endpoint configured in server environment variables and an allowlisted provider key.

Create `apps/api/src/services/aiProviderHealth.ts`:

```

const providers = {
  "openai-compatible": {
    baseUrl: process.env.CHATBOT_AI_BASE_URL,
    apiKey: process.env.CHATBOT_AI_API_KEY,
    model: process.env.CHATBOT_AI_MODEL,
  },
};

export async function checkAIProviderHealth(providerKey: string) {
  if (providerKey !== "openai-compatible") {
    return {
      healthy: false,
      message: "Provider is not in the approved provider allowlist.",
    };
  }

  const provider = providers["openai-compatible"];

  if (!provider.baseUrl || !provider.apiKey || !provider.model) {
    return {
      healthy: false,
      message: "Provider environment configuration is incomplete.",
    };
  }

  try {
    const response = await fetch(
      `${provider.baseUrl.replace(/\/+$/, "")}/models`,
      {
        headers: {
          Authorization: `Bearer ${provider.apiKey}`,
        },
        signal: AbortSignal.timeout(10000),
      }
    );

    return {
      healthy: response.ok,
      message: response.ok
        ? "Provider endpoint is reachable."
        : `Provider returned HTTP ${response.status}.`,
    };
  } catch {
    return {
      healthy: false,
      message: "Provider health check failed.",
    };
  }
}

```

Add a health-check route to `aiGovernance.ts`:

```
import { checkAIProviderHealth } from "../services/aiProviderHealth";

router.post("/provider-health", async (req, res) => {
  try {
    const { institutionId, actorId } = scope(req);
    const providerKey = z.string().min(1).max(50).parse(req.body.providerKey);

    const result = await checkAIProviderHealth(providerKey);

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "PROVIDER_CHECKED",
      targetType: "AI_PROVIDER",
      details: {
        providerKey,
        healthy: result.healthy,
      },
    });

    return res.json(result);
  } catch {
    return res.status(400).json({
      message: "Unable to perform provider health check.",
    });
  }
});
```

This health check only confirms endpoint reachability, not that the model can successfully generate a valid chatbot answer. A separate controlled integration test should verify generation and embeddings.

## 6. Prompt template management

Create `apps/api/src/routes/aiPrompts.ts`.

This provides versioned prompts. Published versions should be immutable; changes create a new draft version.

```

import { Router } from "express";
import { z } from "zod";
import { prisma } from "../lib/prisma";
import { requireAuth } from "../middleware/requireAuth";
import { allowRoles } from "../middleware/allowRoles";
import { recordGovernanceAudit } from "../services/aiGovernance";

const router = Router();

router.use(requireAuth);
router.use(allowRoles("SUPER_ADMIN"));

function getScope(req: any) {
  if (!req.user?.institutionId || !req.user?.id) {
    throw new Error("Missing user scope.");
  }

  return {
    institutionId: req.user.institutionId,
    actorId: req.user.id,
  };
}

const promptSchema = z.object({
  name: z.string().trim().min(2).max(100),
  description: z.string().trim().max(500).optional(),
  content: z.string().trim().min(20).max(12000),
});

router.get("/", async (req, res) => {
  try {
    const { institutionId } = getScope(req);

    const prompts = await prisma.aIPromptTemplate.findMany({
      where: { institutionId },
      orderBy: [{ name: "asc" }, { version: "desc" }],
    });

    return res.json({ prompts });
  } catch {
    return res.status(500).json({ message: "Unable to load prompt templates." });
  }
});

router.post("/", async (req, res) => {
  const parsed = promptSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({ message: "Invalid prompt template." });
  }

  try {
    const { institutionId, actorId } = getScope(req);

    const latest = await prisma.aIPromptTemplate.findFirst({
      where: {
        institutionId,
        name: parsed.data.name,
      },
      orderBy: { version: "desc" },
      select: { version: true },
    });

    const prompt = await prisma.aIPromptTemplate.create({
      data: {
        institutionId,
        ...parsed.data,
        version: (latest?.version ?? 0) + 1,
        createdById: actorId,
        status: "DRAFT",
      },
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "PROMPT_CREATED",
      targetType: "AI_PROMPT",
      targetId: prompt.id,
      details: { name: prompt.name, version: prompt.version },
    });

    return res.status(201).json({ prompt });
  } catch (error) {
    console.error("Prompt creation failed:", error);
    return res.status(500).json({ message: "Unable to create prompt template." });
  }
});

router.post("/:id/publish", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const prompt = await prisma.aIPromptTemplate.findFirst({
      where: {
        id: req.params.id,
        institutionId,
        status: "DRAFT",
      },
    });

    if (!prompt) {
      return res.status(404).json({ message: "Draft prompt not found." });
    }

    const published = await prisma.$transaction(async (tx) => {
      await tx.aIPromptTemplate.updateMany({
        where: {
          institutionId,
          name: prompt.name,
          status: "PUBLISHED",
        },
        data: { status: "ARCHIVED" },
      });

      return tx.aIPromptTemplate.update({
        where: { id: prompt.id },
        data: {
          status: "PUBLISHED",
          publishedById: actorId,
          publishedAt: new Date(),
        },
      });
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "PROMPT_PUBLISHED",
      targetType: "AI_PROMPT",
      targetId: prompt.id,
      details: { name: prompt.name, version: prompt.version },
    });

    return res.json({ prompt: published });
  } catch (error) {
    console.error("Prompt publishing failed:", error);
    return res.status(500).json({ message: "Unable to publish prompt." });
  }
});

export default router;

```

Mount it:

```
