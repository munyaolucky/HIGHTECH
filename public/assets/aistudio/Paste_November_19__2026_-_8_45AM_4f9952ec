18. App entry and routes
src/App.tsx
This is a demonstration route setup. In the actual project, integrate with the existing authentication provider, protected route component and router rather than creating a second authentication system.

import {
  BrowserRouter,
  Routes,
  Route,
  Navigate,
} from "react-router-dom";

import { PortalShell } from "./components/portal/PortalShell";
import StaffDashboard from "./modules/staff/StaffDashboard";
import StudentDashboard from "./modules/student/StudentDashboard";
import type { PortalUser } from "./types/portal";

import "./styles/portal.css";

// Temporary UI preview only.
// Replace this with the authenticated user from the existing auth provider.

const demoStaff: PortalUser = {
  id: "preview-staff",
  name: "Staff Member",
  email: "staff@example.test",
  staffNumber: "HCA/STAFF/2026/0001",
  role: "LECTURER",
  department: "Information Technology",
  campus: "Kitengela",
};

const demoStudent: PortalUser = {
  id: "preview-student",
  name: "Student Member",
  email: "student@example.test",
  registrationNumber: "HCA/STU/2026/0001",
  role: "STUDENT",
  department: "Information Technology",
  campus: "Kitengela",
};

function StaffPortal() {
  return (
    <PortalShell user={demoStaff}>
      <StaffDashboard />
    </PortalShell>
  );
}

function StudentPortal() {
  return (
    <PortalShell user={demoStudent}>
      <StudentDashboard />
    </PortalShell>
  );
}

export default function App() {
  return (
    <BrowserRouter>
      <Routes>
        <Route
          path="/portal/staff"
          element={<StaffPortal />}
        >
          <Route
            index
            element={
              <Navigate
                to="/portal/staff/dashboard"
                replace
              />
            }
          />

          <Route
            path="dashboard"
            element={<StaffDashboard />}
          />
        </Route>

        <Route
          path="/portal/student"
          element={<StudentPortal />}
        >
          <Route
            index
            element={
              <Navigate
                to="/portal/student/dashboard"
                replace
              />
            }
          />

          <Route
            path="dashboard"
            element={<StudentDashboard />}
          />
        </Route>

        <Route
          path="/"
          element={
            <Navigate
              to="/portal/student/dashboard"
              replace
            />
          }
        />

        <Route
          path="*"
          element={
            <div style={{ padding: 40 }}>
              <h1>404</h1>
              <p>Page not found.</p>
            </div>
          }
        />
      </Routes>
    </BrowserRouter>
  );
}



Important route correction
The PortalShell above uses <Outlet />. Therefore the dashboard must be rendered through the child route, not independently inside StaffPortal or StudentPortal.

Replace the two portal wrappers in App.tsx with:

function StaffPortal() {
  return (
    <PortalShell user={demoStaff} />
  );
}

function StudentPortal() {
  return (
    <PortalShell user={demoStudent} />
  );
}



The complete routes will now render the dashboard correctly inside the shell.
