              <div
                className={`class-status ${
                  entry.status?.toLowerCase() ?? "upcoming"
                }`}
              >
                {entry.status ?? "UPCOMING"}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  );
}



