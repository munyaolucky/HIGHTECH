5. Portal sidebar
src/components/portal/PortalSidebar.tsx

import { NavLink } from "react-router-dom";
import { PortalIcon } from "./PortalIcon";
import type { PortalMenuItem, PortalRole } from "../../types/portal";
import { roleLabels, isStudentRole } from "../../data/portal-config";

interface Props {
  role: PortalRole;
  menu: PortalMenuItem[];
  collapsed: boolean;
  onToggle: () => void;
  onClose?: () => void;
}

export function PortalSidebar({
  role,
  menu,
  collapsed,
  onToggle,
  onClose,
}: Props) {
  const student = isStudentRole(role);

  return (
    <aside
      className={`portal-sidebar ${collapsed ? "collapsed" : ""}`}
      aria-label="Main navigation"
    >
      <div className="sidebar-brand">
        <div className="brand-logo">H</div>

        {!collapsed && (
          <div className="brand-text">
            <strong>HI-TECH</strong>
            <span>COLLEGE</span>
          </div>
        )}

        <button
          className="sidebar-collapse-button"
          onClick={onToggle}
          aria-label={collapsed ? "Expand sidebar" : "Collapse sidebar"}
          title={collapsed ? "Expand sidebar" : "Collapse sidebar"}
        >
          <PortalIcon
            name={collapsed ? "PanelLeftOpen" : "PanelLeftClose"}
            size={18}
          />
        </button>
      </div>

      <div className="sidebar-user">
        <div className="user-avatar">
          {student ? "S" : "T"}
        </div>

        {!collapsed && (
          <div className="sidebar-user-details">
            <strong>{roleLabels[role]}</strong>
            <span>HI-TECH Portal</span>
          </div>
        )}
      </div>

      <div className="sidebar-section-label">
        {!collapsed && "WORKSPACE"}
      </div>

      <nav className="sidebar-menu">
        {menu.map((item) => (
          <NavLink
            key={item.id}
            to={item.path}
            onClick={onClose}
            title={collapsed ? item.label : undefined}
            className={({ isActive }) =>
              `sidebar-link ${isActive ? "active" : ""}`
            }
          >
            <PortalIcon name={item.icon} size={19} />

            {!collapsed && (
              <span className="sidebar-link-label">
                {item.label}
              </span>
            )}
          </NavLink>
        ))}
      </nav>

      {!collapsed && (
        <div className="sidebar-footer">
          <div className="sidebar-footer-card">
            <PortalIcon name="LifeBuoy" size={20} />
            <div>
              <strong>Need assistance?</strong>
              <span>Contact Support Centre</span>
            </div>
          </div>
        </div>
      )}
    </aside>
  );
}



6. Header
src/components/portal/PortalHeader.tsx

import { useState } from "react";
import { PortalIcon } from "./PortalIcon";
import type { PortalUser } from "../../types/portal";
import { roleLabels } from "../../data/portal-config";

interface Props {
  user: PortalUser;
  onMenuClick: () => void;
  onLogout?: () => void;
}

export function PortalHeader({
  user,
  onMenuClick,
  onLogout,
}: Props) {
  const [showProfile, setShowProfile] = useState(false);

  return (
    <header className="portal-header">
      <button
        className="mobile-menu-button"
        onClick={onMenuClick}
        aria-label="Open navigation menu"
      >
        <PortalIcon name="Menu" size={22} />
      </button>

      <div className="header-search">
        <PortalIcon name="Search" size={18} />

        <input
          type="search"
          placeholder="Search portal..."
          aria-label="Search portal"
        />

        <span className="search-shortcut">Ctrl K</span>
      </div>

      <div className="header-actions">
        <button
          className="header-icon-button"
          aria-label="Help and support"
          title="Help and support"
        >
          <PortalIcon name="LifeBuoy" />
        </button>

        <button
          className="header-icon-button notification-button"
          aria-label="Notifications"
          title="Notifications"
        >
          <PortalIcon name="Bell" />
          <span className="notification-dot" />
        </button>

        <div className="header-profile-container">
          <button
            className="header-profile-button"
            onClick={() => setShowProfile((v) => !v)}
            aria-expanded={showProfile}
            aria-haspopup="menu"
          >
            <div className="user-avatar header-avatar">
              {user.name
                .split(" ")
                .map((n) => n[0])
                .slice(0, 2)
                .join("")
                .toUpperCase()}
            </div>

            <div className="header-profile-details">
              <strong>{user.name}</strong>
              <span>{roleLabels[user.role]}</span>
            </div>

            <PortalIcon name="ChevronDown" size={16} />
          </button>

          {showProfile && (
            <div className="profile-dropdown" role="menu">
              <div className="profile-dropdown-header">
                <strong>{user.name}</strong>
                <span>{user.email}</span>
              </div>

              <button role="menuitem">
                <PortalIcon name="UserRound" size={17} />
                My Profile
              </button>

              <button role="menuitem">
                <PortalIcon name="Settings" size={17} />
                Settings
              </button>

              <button role="menuitem">
                <PortalIcon name="ShieldCheck" size={17} />
                Security
              </button>

              <button
                role="menuitem"
                className="logout-menu-item"
                onClick={() => {
                  setShowProfile(false);
                  onLogout?.();
                }}
              >
                <PortalIcon name="LogOut" size={17} />
                Sign Out
              </button>
            </div>
          )}
        </div>
      </div>
    </header>
  );
}



7. Mobile navigation
src/components/portal/MobileNav.tsx

import { NavLink } from "react-router-dom";
import { PortalIcon } from "./PortalIcon";
import type { PortalMenuItem } from "../../types/portal";

interface Props {
  items: PortalMenuItem[];
}

export function MobileNav({ items }: Props) {
  const preferred = [
    "dashboard",
    "courses",
    "attendance",
    "communication",
    "settings",
  ];

  const visibleItems = preferred
    .map((id) => items.find((item) => item.id === id))
    .filter((item): item is PortalMenuItem => Boolean(item));

  return (
    <nav className="mobile-bottom-nav" aria-label="Mobile navigation">
      {visibleItems.map((item) => (
        <NavLink
          key={item.id}
          to={item.path}
          className={({ isActive }) =>
            `mobile-nav-item ${isActive ? "active" : ""}`
          }
        >
          <PortalIcon name={item.icon} size={21} />
          <span>{item.label}</span>
        </NavLink>
      ))}
    </nav>
  );
}



