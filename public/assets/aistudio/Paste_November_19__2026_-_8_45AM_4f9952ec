            <article
              className="timetable-entry"
              key={entry.id}
            >
              <div className="timetable-time">
                <strong>{entry.startTime}</strong>
                <span>{entry.endTime}</span>
              </div>

              <div className="timetable-entry-content">
                <strong>{entry.subject}</strong>

                {entry.unitCode && (
                  <span className="unit-code">
                    {entry.unitCode}
