  });

  const messagesEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    setSessionId(getSessionId());
  }, []);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, open]);

  async function sendMessage(value?: string) {
    const text = (value ?? input).trim();

    if (!text || loading || !sessionId) return;

    setInput("");
    setError("");
    setLoading(true);

    setMessages((current) => [
      ...current,
      { role: "USER", content: text },
    ]);

    try {
      const response = await fetch("/api/chatbot/message", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          sessionId,
          message: text,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || "Unable to send your message.");
      }

      setMessages((current) => [
        ...current,
        {
          role: "ASSISTANT",
          content: data.message.content,
        },
      ]);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to contact support. Please try again."
      );
    } finally {
      setLoading(false);
    }
  }

  async function submitEscalation(event: React.FormEvent) {
    event.preventDefault();
    setTicketMessage("");
    setError("");

    try {
      const response = await fetch("/api/chatbot/escalate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          sessionId,
          ...contact,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || "Unable to submit your request.");
      }

      setTicketMessage(
        `Support request submitted. Reference: ${data.ticketId}`
      );
      setShowEscalation(false);
      setContact({
        name: "",
        email: "",
        department: "GENERAL",
        subject: "",
        description: "",
      });
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Support request failed."
      );
    }
  }

  function startNewChat() {
    const id = crypto.randomUUID();
    sessionStorage.setItem("hitech_chat_session", id);
    setSessionId(id);
    setMessages([{
      role: "ASSISTANT",
      content: "Welcome back to HI-TECH College support. How can I help?",
    }]);
    setShowEscalation(false);
    setTicketMessage("");
    setError("");
  }

  return (
    <>
      <button
        type="button"
        className="college-chat-launcher"
        onClick={() => setOpen((value) => !value)}
        aria-label={open ? "Close college support chat" : "Open college support chat"}
        aria-expanded={open}
      >
        {open ? "×" : "💬"}
      </button>

      {open && (
        <section
          className="college-chat-window"
          aria-label="HI-TECH College support"
        >
          <header className="college-chat-header">
            <div>
              <strong>HI-TECH College Support</strong>
              <small>Website virtual assistant</small>
            </div>

            <div className="college-chat-header-actions">
              <button
                type="button"
                onClick={startNewChat}
                aria-label="Start a new conversation"
                title="New conversation"
              >
                ↻
              </button>
              <button
                type="button"
                onClick={() => setOpen(false)}
                aria-label="Close chat"
              >
                ×
              </button>
            </div>
          </header>

          <div className="college-chat-messages" aria-live="polite">
            {messages.map((message, index) => (
              <div
                key={index}
                className={`college-chat-message ${message.role.toLowerCase()}`}
              >
                <span>{message.role === "USER" ? "You" : "HI-TECH Support"}</span>
                <p>{message.content}</p>
              </div>
            ))}

            {loading && (
              <div className="college-chat-typing" role="status">
                Support is preparing an answer...
              </div>
            )}

            <div ref={messagesEndRef} />
          </div>

          {!showEscalation && messages.length <= 2 && (
            <div className="college-chat-suggestions">
              {SUGGESTIONS.map((suggestion) => (
                <button
                  key={suggestion}
                  type="button"
                  disabled={loading}
                  onClick={() => sendMessage(suggestion)}
                >
                  {suggestion}
                </button>
              ))}
            </div>
          )}

          {error && (
            <p className="college-chat-error" role="alert">{error}</p>
          )}

          {ticketMessage && (
            <p className="college-chat-success" role="status">
              {ticketMessage}
            </p>
          )}

          {showEscalation ? (
            <form className="college-chat-escalation" onSubmit={submitEscalation}>
              <h3>Contact a college office</h3>

              <label>
                Your name
                <input
                  required
                  maxLength={100}
                  value={contact.name}
                  onChange={(event) =>
                    setContact({ ...contact, name: event.target.value })
                  }
                />
              </label>

              <label>
                Email address
                <input
                  required
                  type="email"
                  maxLength={200}
                  value={contact.email}
                  onChange={(event) =>
                    setContact({ ...contact, email: event.target.value })
                  }
                />
              </label>

              <label>
                Department
                <select
                  value={contact.department}
                  onChange={(event) =>
                    setContact({
                      ...contact,
                      department: event.target.value as Department,
                    })
                  }
                >
                  {DEPARTMENTS.map((department) => (
                    <option key={department.value} value={department.value}>
                      {department.label}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Subject
                <input
                  required
                  maxLength={150}
                  value={contact.subject}
                  onChange={(event) =>
                    setContact({ ...contact, subject: event.target.value })
                  }
                />
              </label>

              <label>
                Describe your enquiry
                <textarea
                  required
                  minLength={10}
                  maxLength={3000}
                  value={contact.description}
                  onChange={(event) =>
                    setContact({ ...contact, description: event.target.value })
                  }
                />
              </label>

              <button type="submit">Submit support request</button>
              <button
                type="button"
                className="chat-secondary-button"
                onClick={() => setShowEscalation(false)}
              >
                Back to chat
              </button>
            </form>
          ) : (
            <>
              <form
                className="college-chat-input"
                onSubmit={(event) => {
                  event.preventDefault();
                  void sendMessage();
                }}
              >
                <input
                  value={input}
                  onChange={(event) => setInput(event.target.value)}
                  placeholder="Type your question..."
                  maxLength={2000}
                  aria-label="Your question"
                />
                <button type="submit" disabled={loading || !input.trim()}>
                  Send
                </button>
              </form>

              <button
                type="button"
                className="college-chat-human"
                onClick={() => setShowEscalation(true)}
              >
                Contact a human support officer
              </button>
            </>
          )}

          <footer className="college-chat-disclaimer">
            Do not share passwords, PINs, OTPs or payment details in this chat.
          </footer>
        </section>
      )}
    </>
  );
}
```

