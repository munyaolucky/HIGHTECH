### Integrate into the AI request pipeline

In the service that calls the AI provider, capture the start time before the request:

```
const startedAt = Date.now();

try {
  const response = await callAIProvider(/* existing arguments */);

  const latencyMs = Date.now() - startedAt;

  // After successfully saving the AI usage record:
  await recordAIRequestMetric({
    institutionId,
    usageRecordId: usageRecord.id,
    providerKey,
    model,
    operation: "CHAT_COMPLETION",
    latencyMs,
    success: true,
    httpStatus: 200,
  });

  return response;
} catch (error) {
  await recordAIRequestMetric({
    institutionId,
    providerKey,
    model,
    operation: "CHAT_COMPLETION",
    latencyMs: Date.now() - startedAt,
    success: false,
    errorCategory: "PROVIDER_REQUEST_FAILED",
  });

  throw error;
}
```

Replace `callAIProvider`, `usageRecord`, and the other variables with the names in your actual RAG service. Do not log API keys, complete authorization headers, or private student messages in metric records.

### Record retrieval outcomes

In `collegeChatbot.ts`, after retrieving knowledge and determining the response type:

```
await recordAIRetrievalMetric({
  institutionId,
  conversationId: conversation.id,
  messageId: assistantMessage.id,
  outcome: "ANSWERED",
  topSimilarity: knowledge[0]?.score,
  retrievedCount: knowledge.length,
  citedArticleIds: citations,
});
```

Use the appropriate outcome:

| Chatbot result                  | Retrieval outcome |
| ------------------------------- | ----------------- |
| AI answer grounded in knowledge | `ANSWERED`        |
| No matching article             | `NO_MATCH`        |
| Articles below threshold        | `LOW_CONFIDENCE`  |
| Safe fallback response          | `FALLBACK`        |
| Human support ticket created    | `ESCALATED`       |

Only record citations that were actually validated against the retrieved articles.

## 3. Automated AI service alerts

Create `apps/api/src/services/aiAlerts.ts`.

```

import { prisma } from "../lib/prisma";

export async function createAIAlert(input: {
  institutionId: string;
  type:
    | "QUOTA_WARNING"
    | "QUOTA_EXCEEDED"
    | "PROVIDER_FAILURE"
    | "INDEXING_FAILURE"
    | "HIGH_ERROR_RATE"
    | "HIGH_LATENCY";
  severity: "INFO" | "WARNING" | "CRITICAL";
  title: string;
  message: string;
  source?: string;
}) {
  const existing = await prisma.aIServiceAlert.findFirst({
    where: {
      institutionId: input.institutionId,
      type: input.type,
      source: input.source ?? null,
      status: { in: ["OPEN", "ACKNOWLEDGED"] },
    },
    orderBy: { createdAt: "desc" },
  });

  if (existing) return existing;

  return prisma.aIServiceAlert.create({
    data: {
      institutionId: input.institutionId,
      type: input.type,
      severity: input.severity,
      title: input.title,
      message: input.message,
      source: input.source ?? null,
    },
  });
}

export async function acknowledgeAIAlert(input: {
  institutionId: string;
  alertId: string;
  actorId: string;
}) {
  const result = await prisma.aIServiceAlert.updateMany({
    where: {
      id: input.alertId,
      institutionId: input.institutionId,
      status: "OPEN",
    },
    data: {
      status: "ACKNOWLEDGED",
      acknowledgedById: input.actorId,
      acknowledgedAt: new Date(),
    },
  });

  if (!result.count) {
    throw new Error("Open alert not found.");
  }

  return prisma.aIServiceAlert.findFirst({
    where: {
      id: input.alertId,
      institutionId: input.institutionId,
    },
  });
}

export async function resolveAIAlert(input: {
  institutionId: string;
  alertId: string;
  actorId: string;
}) {
  const result = await prisma.aIServiceAlert.updateMany({
    where: {
      id: input.alertId,
      institutionId: input.institutionId,
      status: { in: ["OPEN", "ACKNOWLEDGED"] },
    },
    data: {
      status: "RESOLVED",
      resolvedById: input.actorId,
      resolvedAt: new Date(),
    },
  });

  if (!result.count) {
    throw new Error("Active alert not found.");
  }

  return prisma.aIServiceAlert.findFirst({
    where: {
      id: input.alertId,
      institutionId: input.institutionId,
    },
  });
}

```

The duplicate check is a convenience, not a concurrency-safe deduplication mechanism. If multiple monitoring workers will run simultaneously, introduce a stable alert fingerprint with a database uniqueness constraint.

## 4. Monitoring service

Create `apps/api/src/services/aiMonitoring.ts`.

This checks current monthly quota consumption, provider error rates and failed indexing jobs. It creates alerts without exposing user conversation content.

```

import { prisma } from "../lib/prisma";
import { createAIAlert } from "./aiAlerts";

export async function monitorInstitutionAI(institutionId: string) {
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const lastHour = new Date(now.getTime() - 60 * 60 * 1000);

  const [configuration, usage, recentMetrics, failedJobs] = await Promise.all([
    prisma.chatbotAIConfiguration.findUnique({
      where: { institutionId },
      select: {
        monthlyTokenLimit: true,
        monthlyRequestLimit: true,
      },
    }),
    prisma.aIUsageRecord.aggregate({
      where: {
        institutionId,
        createdAt: { gte: monthStart },
      },
      _sum: {
        totalTokens: true,
      },
      _count: { _all: true },
    }),
    prisma.aIRequestMetric.findMany({
      where: {
        institutionId,
        createdAt: { gte: lastHour },
      },
      select: {
        success: true,
        latencyMs: true,
      },
    }),
    prisma.aIKnowledgeIndexJob.count({
      where: {
        institutionId,
        status: "FAILED",
      },
    }),
  ]);

  const tokens = usage._sum.totalTokens ?? 0;
  const requests = usage._count._all;

  const tokenLimit = configuration?.monthlyTokenLimit ?? 0;
  const requestLimit = configuration?.monthlyRequestLimit ?? 0;

  if (tokenLimit > 0) {
    const percentage = tokens / tokenLimit;

    if (percentage >= 1) {
      await createAIAlert({
        institutionId,
        type: "QUOTA_EXCEEDED",
        severity: "CRITICAL",
        title: "Monthly AI token quota exceeded",
        message: `AI token consumption has reached ${tokens.toLocaleString()} of ${tokenLimit.toLocaleString()}.`,
        source: "monthly-token-quota",
      });
    } else if (percentage >= 0.8) {
      await createAIAlert({
        institutionId,
        type: "QUOTA_WARNING",
        severity: "WARNING",
        title: "AI token quota approaching limit",
        message: `AI token consumption is at ${Math.round(percentage * 100)}% of the monthly allowance.`,
        source: "monthly-token-quota",
      });
    }
  }

  if (requestLimit > 0) {
    const percentage = requests / requestLimit;

    if (percentage >= 1) {
      await createAIAlert({
        institutionId,
        type: "QUOTA_EXCEEDED",
        severity: "CRITICAL",
        title: "Monthly AI request quota exceeded",
        message: `AI requests have reached ${requests} of ${requestLimit}.`,
        source: "monthly-request-quota",
      });
    } else if (percentage >= 0.8) {
      await createAIAlert({
        institutionId,
        type: "QUOTA_WARNING",
        severity: "WARNING",
        title: "AI request quota approaching limit",
        message: `AI requests are at ${Math.round(percentage * 100)}% of the monthly allowance.`,
        source: "monthly-request-quota",
      });
    }
  }

  if (recentMetrics.length >= 10) {
    const failures = recentMetrics.filter((item) => !item.success).length;
    const failureRate = failures / recentMetrics.length;

    if (failureRate >= 0.3) {
      await createAIAlert({
        institutionId,
        type: "HIGH_ERROR_RATE",
        severity: "CRITICAL",
        title: "High AI provider error rate",
        message: `${Math.round(failureRate * 100)}% of the last ${recentMetrics.length} recorded requests failed in the last hour.`,
        source: "provider-error-rate",
      });
    }

    const latencies = recentMetrics
      .map((item) => item.latencyMs)
      .filter((value): value is number => value !== null);

    if (latencies.length >= 10) {
      const sorted = [...latencies].sort((a, b) => a - b);
      const p95 = sorted[Math.ceil(sorted.length * 0.95) - 1];

      if (p95 >= 10000) {
        await createAIAlert({
          institutionId,
          type: "HIGH_LATENCY",
          severity: "WARNING",
          title: "AI response latency is high",
          message: `The measured 95th percentile latency is ${p95} milliseconds.`,
          source: "provider-latency",
        });
      }
    }
  }

  if (failedJobs > 0) {
    await createAIAlert({
      institutionId,
      type: "INDEXING_FAILURE",
      severity: "WARNING",
      title: "Knowledge indexing failures detected",
      message: `${failedJobs} knowledge indexing jobs have failed and require review.`,
      source: "knowledge-indexing",
    });
  }

  return {
    tokens,
    requests,
    failedJobs,
    recentRequestCount: recentMetrics.length,
  };
}

```

This is a threshold-based monitor, not a full observability system. It should run on a scheduled worker, not on every user chatbot request.

## 5. Analytics and alert APIs

Create `apps/api/src/routes/aiMonitoringAdmin.ts`.

```

import { Router } from "express";
import { z } from "zod";
import { prisma } from "../lib/prisma";
import { requireAuth } from "../middleware/requireAuth";
import { allowRoles } from "../middleware/allowRoles";
import { acknowledgeAIAlert, resolveAIAlert } from "../services/aiAlerts";

const router = Router();

router.use(requireAuth);
router.use(allowRoles("SUPER_ADMIN"));

function getScope(req: any) {
  const institutionId = req.user?.institutionId;
  const actorId = req.user?.id;

  if (!institutionId || !actorId) {
    throw new Error("Missing institution or authenticated user.");
  }

  return { institutionId, actorId };
}

router.get("/dashboard", async (req, res) => {
  try {
    const { institutionId } = getScope(req);

    const parsed = z.object({
      days: z.coerce.number().int().min(1).max(365).default(30),
    }).safeParse(req.query);

    if (!parsed.success) {
      return res.status(400).json({ message: "Invalid date range." });
    }

    const from = new Date();
    from.setDate(from.getDate() - parsed.data.days);

    const where = {
      institutionId,
      createdAt: { gte: from },
    };

    const [
      totals,
      byRole,
      byModel,
      byDepartment,
      feedback,
      retrieval,
      providerMetrics,
      openAlerts,
    ] = await Promise.all([
      prisma.aIUsageRecord.aggregate({
        where,
        _sum: {
          inputTokens: true,
          outputTokens: true,
          totalTokens: true,
          estimatedCost: true,
        },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.groupBy({
        by: ["userRole"],
        where,
        _sum: { totalTokens: true },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.groupBy({
        by: ["providerKey", "model"],
        where,
        _sum: { totalTokens: true, estimatedCost: true },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.groupBy({
        by: ["departmentId"],
        where: {
          ...where,
          departmentId: { not: null },
        },
        _sum: { totalTokens: true },
        _count: { _all: true },
      }),
      prisma.chatbotAnswerFeedback.groupBy({
        by: ["rating"],
        where: {
          institutionId,
          createdAt: { gte: from },
        },
        _count: { _all: true },
      }),
      prisma.aIRetrievalMetric.groupBy({
        by: ["outcome"],
        where: {
          institutionId,
          createdAt: { gte: from },
        },
        _count: { _all: true },
      }),
      prisma.aIRequestMetric.groupBy({
        by: ["providerKey", "success"],
        where: {
          institutionId,
          createdAt: { gte: from },
        },
        _count: { _all: true },
        _avg: { latencyMs: true },
      }),
      prisma.aIServiceAlert.count({
        where: {
          institutionId,
          status: { in: ["OPEN", "ACKNOWLEDGED"] },
        },
      }),
    ]);

    return res.json({
      period: { from, days: parsed.data.days },
      totals: {
        requests: totals._count._all,
        inputTokens: totals._sum.inputTokens ?? 0,
        outputTokens: totals._sum.outputTokens ?? 0,
        totalTokens: totals._sum.totalTokens ?? 0,
        estimatedCost: Number(totals._sum.estimatedCost ?? 0),
      },
      byRole,
      byModel,
      byDepartment,
      feedback,
      retrieval,
      providerMetrics,
      openAlerts,
    });
  } catch (error) {
    console.error("AI monitoring dashboard failed:", error);
    return res.status(500).json({ message: "Unable to load AI monitoring dashboard." });
  }
});

router.get("/alerts", async (req, res) => {
  try {
    const { institutionId } = getScope(req);

    const parsed = z.object({
      status: z.enum(["OPEN", "ACKNOWLEDGED", "RESOLVED"]).optional(),
      limit: z.coerce.number().int().min(1).max(200).default(50),
    }).safeParse(req.query);

    if (!parsed.success) {
      return res.status(400).json({ message: "Invalid alert filters." });
    }

    const alerts = await prisma.aIServiceAlert.findMany({
      where: {
        institutionId,
        ...(parsed.data.status ? { status: parsed.data.status } : {}),
      },
      orderBy: { createdAt: "desc" },
      take: parsed.data.limit,
    });

    return res.json({ alerts });
  } catch {
    return res.status(500).json({ message: "Unable to load AI alerts." });
  }
});

router.post("/alerts/:id/acknowledge", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const alert = await acknowledgeAIAlert({
      institutionId,
      alertId: req.params.id,
      actorId,
    });

    return res.json({ alert });
  } catch (error) {
    return res.status(400).json({
      message: error instanceof Error ? error.message : "Unable to acknowledge alert.",
    });
  }
});

router.post("/alerts/:id/resolve", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const alert = await resolveAIAlert({
      institutionId,
      alertId: req.params.id,
      actorId,
    });

    return res.json({ alert });
  } catch (error) {
    return res.status(400).json({
      message: error instanceof Error ? error.message : "Unable to resolve alert.",
    });
  }
});

export default router;

```

