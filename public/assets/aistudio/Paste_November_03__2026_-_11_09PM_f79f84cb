  });
}

export async function recordAIRetrievalMetric(input: {
  institutionId: string;
  conversationId?: string;
  messageId?: string;
  outcome:
    | "ANSWERED"
    | "NO_MATCH"
    | "LOW_CONFIDENCE"
    | "FALLBACK"
