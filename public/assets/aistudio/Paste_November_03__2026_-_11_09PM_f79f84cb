app.use("/api/ai-admin/monitoring", aiMonitoringAdminRoutes);
```

## 6. Scheduled monitoring worker

Create `apps/api/src/workers/aiMonitoringWorker.ts`.

This worker checks every institution independently. It must run as a dedicated worker or scheduled process.

```

import { prisma } from "../lib/prisma";
import { monitorInstitutionAI } from "../services/aiMonitoring";

let running = false;

export async function runAIMonitoringCycle() {
  if (running) return;
  running = true;

  try {
    const institutions = await prisma.chatbotAIConfiguration.findMany({
      select: { institutionId: true },
    });

    for (const institution of institutions) {
      try {
        await monitorInstitutionAI(institution.institutionId);
      } catch (error) {
        console.error(
          `AI monitoring failed for institution ${institution.institutionId}:`,
          error
        );
      }
    }
  } finally {
    running = false;
  }
}

export function startAIMonitoringWorker() {
  if (process.env.AI_MONITORING_WORKER_ENABLED !== "true") return;

  void runAIMonitoringCycle();

  const interval = setInterval(() => {
    void runAIMonitoringCycle();
  }, 5 * 60 * 1000);

  interval.unref?.();
}

```

Start from the API bootstrap or a dedicated worker entry point:

```
import { startAIMonitoringWorker } from "./workers/aiMonitoringWorker";

startAIMonitoringWorker();
```

Environment:

```
AI_MONITORING_WORKER_ENABLED=false
```

For production, use a single scheduled worker, distributed lock or job queue to prevent duplicate monitoring cycles. The in-memory `running` variable only prevents overlapping cycles within one process.

