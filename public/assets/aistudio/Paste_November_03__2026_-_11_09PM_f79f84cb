import { useEffect, useState } from "react";
import "./ai-governance.css";

type Report = {
  period: { from: string; days: number };
  totals: {
    requests: number;
    inputTokens: number;
    outputTokens: number;
    totalTokens: number;
    estimatedCost: number;
  };
  byRole: Array<{
    userRole: string | null;
    _sum: { totalTokens: number | null };
    _count: { _all: number };
  }>;
  byModel: Array<{
    providerKey: string;
    model: string;
    _sum: { totalTokens: number | null; estimatedCost: number | null };
    _count: { _all: number };
  }>;
  byDepartment: Array<{
    departmentId: string | null;
    _sum: { totalTokens: number | null };
    _count: { _all: number };
  }>;
  feedback: Array<{
    rating: string;
    _count: { _all: number };
  }>;
  retrieval: Array<{
    outcome: string;
    _count: { _all: number };
  }>;
  providerMetrics: Array<{
    providerKey: string;
    success: boolean;
    _count: { _all: number };
    _avg: { latencyMs: number | null };
  }>;
  openAlerts: number;
};

type Alert = {
  id: string;
  type: string;
  severity: string;
  status: string;
  title: string;
  message: string;
  createdAt: string;
};

async function api<T>(path: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`/api/ai-admin/monitoring${path}`, {
    ...options,
    credentials: "include",
    headers: {
      "Content-Type": "application/json",
      ...options.headers,
    },
  });

  const result = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(result.message || "AI monitoring request failed.");
  }

  return result as T;
}

function MetricCard({
  label,
  value,
  detail,
}: {
  label: string;
  value: string;
  detail?: string;
}) {
  return (
    <article className="ai-metric-card">
      <span>{label}</span>
      <strong>{value}</strong>
      {detail && <small>{detail}</small>}
    </article>
  );
}

export default function AIPerformancePage() {
  const [report, setReport] = useState<Report | null>(null);
  const [alerts, setAlerts] = useState<Alert[]>([]);
  const [days, setDays] = useState(30);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  async function loadDashboard() {
    setLoading(true);
    setError("");

    try {
      const [reportResult, alertResult] = await Promise.all([
        api<Report>(`/dashboard?days=${days}`),
        api<{ alerts: Alert[] }>("/alerts?limit=20"),
      ]);

      setReport(reportResult);
      setAlerts(alertResult.alerts);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to load dashboard.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadDashboard();
  }, [days]);

  async function updateAlert(alertId: string, action: "acknowledge" | "resolve") {
    setError("");
    setNotice("");

    try {
      await api(`/alerts/${alertId}/${action}`, {
        method: "POST",
        body: JSON.stringify({}),
      });

      setNotice(`Alert ${action}d successfully.`);
      await loadDashboard();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to update alert.");
    }
  }

  const totalFeedback = report?.feedback.reduce(
    (sum, item) => sum + item._count._all,
    0
  ) ?? 0;

  const helpfulFeedback = report?.feedback.find(
    (item) => item.rating === "HELPFUL"
  )?._count._all ?? 0;

  const helpfulPercentage = totalFeedback
    ? Math.round((helpfulFeedback / totalFeedback) * 100)
    : null;

  return (
    <main className="ai-admin-page">
      <header className="ai-admin-header">
        <div>
          <span>HI-TECH COLLEGE · AI OPERATIONS</span>
          <h1>AI Performance & Monitoring</h1>
          <p>Monitor service usage, response quality indicators and system alerts.</p>
        </div>

        <div className="ai-performance-controls">
          <select
            value={days}
            onChange={(e) => setDays(Number(e.target.value))}
          >
            <option value={7}>Last 7 days</option>
            <option value={30}>Last 30 days</option>
            <option value={90}>Last 90 days</option>
            <option value={180}>Last 180 days</option>
            <option value={365}>Last 365 days</option>
          </select>
          <button
            className="ai-button ai-button-outline"
            disabled={loading}
            onClick={() => void loadDashboard()}
          >
            Refresh
          </button>
        </div>
      </header>

      {error && <div className="ai-alert ai-alert-error">{error}</div>}
      {notice && <div className="ai-alert ai-alert-success">{notice}</div>}

      {loading ? (
        <p>Loading AI performance data...</p>
      ) : !report ? (
        <p>No AI performance data is currently available.</p>
      ) : (
        <>
          <section className="ai-performance-grid">
            <MetricCard label="AI requests" value={report.totals.requests.toLocaleString()} />
            <MetricCard label="Total tokens" value={report.totals.totalTokens.toLocaleString()} />
            <MetricCard label="Input tokens" value={report.totals.inputTokens.toLocaleString()} />
            <MetricCard label="Output tokens" value={report.totals.outputTokens.toLocaleString()} />
            <MetricCard label="Estimated cost" value={report.totals.estimatedCost.toFixed(4)} />
            <MetricCard label="Open alerts" value={String(report.openAlerts)} />
          </section>

          <section className="ai-admin-panel">
            <h2>AI consumption by role</h2>
            {report.byRole.length === 0 ? (
              <p>No role usage records for this period.</p>
            ) : (
              <div className="ai-report-list">
                {report.byRole.map((item) => (
                  <div className="ai-report-row" key={item.userRole ?? "unknown"}>
                    <strong>{item.userRole ?? "Unknown role"}</strong>
                    <span>{(item._sum.totalTokens ?? 0).toLocaleString()} tokens</span>
                    <span>{item._count._all} requests</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <section className="ai-admin-panel">
            <h2>Provider and model usage</h2>
            {report.byModel.length === 0 ? (
              <p>No model usage recorded.</p>
            ) : (
              <div className="ai-report-list">
                {report.byModel.map((item) => (
                  <div className="ai-report-row" key={`${item.providerKey}-${item.model}`}>
                    <strong>{item.providerKey} / {item.model}</strong>
                    <span>{(item._sum.totalTokens ?? 0).toLocaleString()} tokens</span>
                    <span>{item._count._all} requests</span>
                    <span>{Number(item._sum.estimatedCost ?? 0).toFixed(4)} estimated cost</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <section className="ai-admin-panel">
            <h2>Department consumption</h2>
            {report.byDepartment.length === 0 ? (
              <p>No department-linked usage records. Department IDs must be populated when requests are recorded.</p>
            ) : (
              <div className="ai-report-list">
                {report.byDepartment.map((item) => (
                  <div className="ai-report-row" key={item.departmentId ?? "unknown"}>
                    <strong>{item.departmentId ?? "Unassigned"}</strong>
                    <span>{(item._sum.totalTokens ?? 0).toLocaleString()} tokens</span>
                    <span>{item._count._all} requests</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <section className="ai-admin-panel">
            <h2>Chatbot feedback</h2>
            <div className="ai-performance-highlight">
              <strong>
                {helpfulPercentage === null ? "No feedback" : `${helpfulPercentage}% helpful`}
              </strong>
              <span>{totalFeedback} feedback submissions</span>
            </div>
            <div className="ai-report-list">
              {report.feedback.map((item) => (
                <div className="ai-report-row" key={item.rating}>
                  <strong>{item.rating.replaceAll("_", " ")}</strong>
                  <span>{item._count._all} responses</span>
                </div>
              ))}
            </div>
          </section>

          <section className="ai-admin-panel">
            <h2>Knowledge retrieval outcomes</h2>
            {report.retrieval.length === 0 ? (
              <p>No retrieval metrics recorded for this period.</p>
            ) : (
              <div className="ai-report-list">
                {report.retrieval.map((item) => (
                  <div className="ai-report-row" key={item.outcome}>
                    <strong>{item.outcome.replaceAll("_", " ")}</strong>
                    <span>{item._count._all} requests</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <section className="ai-admin-panel">
            <h2>Provider reliability and latency</h2>
            {report.providerMetrics.map((item, index) => (
              <div className="ai-report-row" key={`${item.providerKey}-${item.success}-${index}`}>
                <strong>{item.providerKey}</strong>
                <span>{item.success ? "Successful" : "Failed"}</span>
                <span>{item._count._all} requests</span>
                <span>
                  {item._avg.latencyMs == null
                    ? "Latency unavailable"
                    : `${Math.round(item._avg.latencyMs)} ms average`}
                </span>
              </div>
            ))}
          </section>
        </>
      )}

      <section className="ai-admin-panel">
        <h2>AI service alerts</h2>
        {alerts.length === 0 ? (
          <p>No active alerts.</p>
        ) : (
          <div className="ai-alert-list">
            {alerts.map((alert) => (
              <article className="ai-service-alert" key={alert.id}>
                <div>
                  <strong>{alert.title}</strong>
                  <p>{alert.message}</p>
                  <small>
                    {alert.severity} · {alert.status} · {new Date(alert.createdAt).toLocaleString()}
                  </small>
                </div>
                <div className="ai-alert-actions">
                  {alert.status === "OPEN" && (
                    <button
                      className="ai-button ai-button-outline"
                      onClick={() => void updateAlert(alert.id, "acknowledge")}
                    >
                      Acknowledge
                    </button>
                  )}
                  {alert.status !== "RESOLVED" && (
                    <button
                      className="ai-button"
                      onClick={() => void updateAlert(alert.id, "resolve")}
                    >
                      Resolve
                    </button>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </main>
  );
}

