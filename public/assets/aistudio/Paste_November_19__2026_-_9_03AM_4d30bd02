import type { AuthUser } from "./auth-types";

export function getUserDashboardPath(user: AuthUser): string {
  if (user.mustChangePassword) {
    return "/portal/auth/change-password";
  }

  if (user.requiresProfileCompletion) {
    return "/portal/auth/complete-profile";
  }

  if (user.dashboardPath) {
    return user.dashboardPath;
  }

  if (user.role === "STUDENT") {
    return "/portal/student/dashboard";
  }

  return "/portal/staff/dashboard";
}

export function isAccountActive(user: AuthUser): boolean {
  return user.status === "ACTIVE";
}

export function hasUserPermission(
  user: AuthUser | null,
  permission: string,
): boolean {
  if (!user) return false;

  return user.permissions.includes(permission);
}

export function hasAnyUserPermission(
  user: AuthUser | null,
  permissions: string[],
): boolean {
  if (!user) return false;

  return permissions.some((permission) =>
    user.permissions.includes(permission),
  );
}

