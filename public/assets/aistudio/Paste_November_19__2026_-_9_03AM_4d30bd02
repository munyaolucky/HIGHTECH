import type { ReactNode } from "react";
import { useAuth } from "./useAuth";
import type { PortalRole } from "../types/portal";

interface Props {
  roles: PortalRole[];
  children: ReactNode;
  fallback?: ReactNode;
}

export function RoleGate({
  roles,
  children,
  fallback = null,
}: Props) {
