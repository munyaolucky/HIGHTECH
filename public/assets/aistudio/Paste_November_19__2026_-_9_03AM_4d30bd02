## **19. Correct the route guard to support both layouts and standalone screens**

The route guard must support both nested routes and standalone pages. Update it as follows.

### `src/auth/ProtectedRoute.tsx`**&#x20;— corrected**

```

import {
  Navigate,
  Outlet,
  useLocation,
} from "react-router-dom";
import type { ReactNode } from "react";

import { useAuth } from "./useAuth";
import { SessionLoading } from "../components/portal/SessionLoading";
import { AccessDenied } from "../components/portal/AccessDenied";

interface Props {
  roles?: string[];
  permissions?: string[];
  requireAllPermissions?: boolean;
  allowIncompleteProfile?: boolean;
  children?: ReactNode;
}

export function ProtectedRoute({
  roles,
  permissions,
  requireAllPermissions = true,
  allowIncompleteProfile = false,
  children,
}: Props) {
  const auth = useAuth();
  const location = useLocation();

  if (auth.loading) {
    return <SessionLoading />;
  }

  if (!auth.user) {
    return (
      <Navigate
        to="/portal/login"
        replace
        state={{ from: location.pathname }}
      />
    );
  }

  const user = auth.user;

  if (user.status !== "ACTIVE") {
    return <AccessDenied />;
  }

  if (
    user.mustChangePassword &&
    location.pathname !== "/portal/auth/change-password"
  ) {
    return (
      <Navigate
        to="/portal/auth/change-password"
        replace
      />
    );
  }

  if (
    user.requiresProfileCompletion &&
    !allowIncompleteProfile &&
    location.pathname !== "/portal/auth/complete-profile"
  ) {
    return (
      <Navigate
        to="/portal/auth/complete-profile"
        replace
      />
    );
  }

  if (roles && !roles.includes(user.role)) {
    return <AccessDenied />;
  }

  if (permissions?.length) {
    const permitted = requireAllPermissions
      ? permissions.every((p) => user.permissions.includes(p))
      : permissions.some((p) => user.permissions.includes(p));

    if (!permitted) {
      return <AccessDenied />;
    }
  }

  return children ?? <Outlet />;
}

```

