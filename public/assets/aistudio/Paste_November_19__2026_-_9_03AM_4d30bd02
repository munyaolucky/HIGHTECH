## **4. Auth API service**

### `src/auth/auth-api.ts`

This service uses HttpOnly session cookies rather than storing access tokens in `localStorage`.

The API contract assumed in this slice:

| Method | Endpoint                     | Purpose                   |
| ------ | ---------------------------- | ------------------------- |
| POST   | `/api/auth/login`            | Authenticate              |
| GET    | `/api/auth/me`               | Restore session           |
| POST   | `/api/auth/logout`           | Logout                    |
| POST   | `/api/auth/password/change`  | Change password           |
| POST   | `/api/auth/profile/complete` | Complete required profile |

```

import type {
  AuthResponse,
  LoginRequest,
} from "./auth-types";

const API_BASE = "/api";

async function request<T>(
  path: string,
  options: RequestInit = {},
): Promise<T> {
  const response = await fetch(`${API_BASE}${path}`, {
    ...options,
    credentials: "include",
    headers: {
      Accept: "application/json",
      ...(options.body ? { "Content-Type": "application/json" } : {}),
      ...options.headers,
    },
  });

  if (!response.ok) {
    const body = await response.json().catch(() => null);

    throw new Error(
      body?.message ??
      `Request failed (${response.status})`,
    );
  }

  if (response.status === 204) {
    return undefined as T;
  }

  return response.json() as Promise<T>;
}

export const authApi = {
  login(payload: LoginRequest) {
    return request<AuthResponse>("/auth/login", {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },

  me() {
    return request<AuthResponse>("/auth/me");
  },

  logout() {
    return request<void>("/auth/logout", {
      method: "POST",
    });
  },

  changePassword(payload: {
    currentPassword: string;
    newPassword: string;
  }) {
    return request<void>("/auth/password/change", {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },

  completeProfile(payload: Record<string, unknown>) {
    return request<void>("/auth/profile/complete", {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },
};

```

