## **11. Protected route component**

### `src/auth/ProtectedRoute.tsx`

This component protects pages based on:

- Authentication.
- Account status.
- Mandatory password changes.
- Profile completion.
- Allowed roles.
- Required permissions.

```

import {
  Navigate,
  Outlet,
  useLocation,
} from "react-router-dom";

import { useAuth } from "./useAuth";
import { getUserDashboardPath } from "./auth-utils";
import { SessionLoading } from "../components/portal/SessionLoading";
import { AccessDenied } from "../components/portal/AccessDenied";

interface Props {
  roles?: string[];
  permissions?: string[];
  requireAllPermissions?: boolean;
  allowIncompleteProfile?: boolean;
}

export function ProtectedRoute({
  roles,
  permissions,
  requireAllPermissions = true,
  allowIncompleteProfile = false,
}: Props) {
  const auth = useAuth();
  const location = useLocation();

  if (auth.loading) {
    return <SessionLoading />;
  }

  if (!auth.user) {
    return (
      <Navigate
        to="/portal/login"
        replace
        state={{ from: location.pathname }}
      />
    );
  }

  if (auth.user.status !== "ACTIVE") {
    return <AccessDenied />;
  }

  if (
    auth.user.mustChangePassword &&
    location.pathname !== "/portal/auth/change-password"
  ) {
    return (
      <Navigate
        to="/portal/auth/change-password"
        replace
      />
    );
  }

  if (
    auth.user.requiresProfileCompletion &&
    !allowIncompleteProfile &&
    location.pathname !== "/portal/auth/complete-profile"
  ) {
    return (
      <Navigate
        to="/portal/auth/complete-profile"
        replace
      />
    );
  }

  if (roles && roles.length > 0) {
    if (!roles.includes(auth.user.role)) {
      return <AccessDenied />;
    }
  }

  if (permissions && permissions.length > 0) {
    const userPermissions = auth.user.permissions;

    const permitted = requireAllPermissions
      ? permissions.every((p) => userPermissions.includes(p))
      : permissions.some((p) => userPermissions.includes(p));

    if (!permitted) {
      return <AccessDenied />;
    }
  }

  return <Outlet />;
}

```

## **12. Permission gate component**

### `src/auth/PermissionGate.tsx`

This is for hiding or showing sections, buttons and links within an already protected page.

```

import type { ReactNode } from "react";
import { useAuth } from "./useAuth";

interface Props {
  permission?: string;
  permissions?: string[];
  requireAll?: boolean;
  fallback?: ReactNode;
  children: ReactNode;
}

export function PermissionGate({
  permission,
  permissions = [],
  requireAll = true,
  fallback = null,
  children,
}: Props) {
  const { user } = useAuth();

  if (!user) return fallback;

  const required = permission
    ? [permission, ...permissions]
    : permissions;

  if (required.length === 0) {
    return children;
  }

  const permitted = requireAll
    ? required.every((p) => user.permissions.includes(p))
    : required.some((p) => user.permissions.includes(p));

  return permitted ? children : fallback;
}

```

