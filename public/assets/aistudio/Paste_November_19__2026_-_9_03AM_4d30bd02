                element={
                  <Navigate
                    to="dashboard"
                    replace
                  />
                }
              />

              <Route
                path="dashboard"
                element={<StudentDashboard />}
              />
            </Route>
          </Route>

          <Route
            path="/"
            element={
              <Navigate
                to="/portal"
                replace
              />
            }
          />

          <Route
            path="*"
            element={
              <Navigate
                to="/portal"
                replace
              />
            }
          />
        </Routes>
      </AuthProvider>
    </BrowserRouter>
  );
}

