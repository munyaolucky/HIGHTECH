## 2. Support Escalations page

Create `apps/web/src/pages/admin/ChatbotEscalationsPage.tsx`.

The page uses the existing `GET /escalations` and `PATCH /escalations/:id` endpoints. Assigning a ticket to the current administrator uses the existing `ASSIGNED` status action described in Module 36.

```

import { useEffect, useMemo, useState } from "react";
import "./chatbot-admin.css";

type TicketStatus = "PENDING" | "ASSIGNED" | "RESOLVED" | "REJECTED";

type ChatMessage = {
  id: string;
  role: "USER" | "ASSISTANT" | "SYSTEM";
  content: string;
  createdAt: string;
};

type Escalation = {
  id: string;
  subject: string;
  department: string;
  description: string;
  status: TicketStatus;
  resolution?: string | null;
  assignedToId?: string | null;
  createdAt: string;
  updatedAt: string;
  conversation?: {
    id: string;
    visitorName?: string | null;
    visitorEmail?: string | null;
    messages?: ChatMessage[];
  };
};

const API = "/api/chatbot-admin";

async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`${API}${path}`, {
    ...options,
    credentials: "include",
    headers: {
      "Content-Type": "application/json",
      ...options.headers,
    },
  });

  const payload = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(payload.message || payload.error || `Request failed (${response.status})`);
  }
  return payload as T;
}

function formatDate(value: string) {
  return new Date(value).toLocaleString();
}

export default function ChatbotEscalationsPage() {
  const [tickets, setTickets] = useState<Escalation[]>([]);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [statusFilter, setStatusFilter] = useState("ALL");
  const [resolution, setResolution] = useState("");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  async function loadTickets() {
    setLoading(true);
    setError("");

    try {
      const result = await request<{ escalations: Escalation[] }>("/escalations");
      const rows = result.escalations ?? [];
      setTickets(rows);
      setSelectedId((current) =>
        current && rows.some((ticket) => ticket.id === current)
          ? current
          : rows[0]?.id ?? null
      );
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to load support requests.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadTickets();
  }, []);

  const filteredTickets = useMemo(
    () =>
      tickets.filter(
        (ticket) => statusFilter === "ALL" || ticket.status === statusFilter
      ),
    [tickets, statusFilter]
  );

  const selected = filteredTickets.find((ticket) => ticket.id === selectedId) ?? null;

  useEffect(() => {
    setResolution(selected?.resolution ?? "");
  }, [selectedId, selected?.resolution]);

  async function updateTicket(
    ticket: Escalation,
    changes: { status?: TicketStatus; resolution?: string }
  ) {
    setSaving(true);
    setError("");
    setNotice("");

    try {
      await request(`/escalations/${ticket.id}`, {
        method: "PATCH",
        body: JSON.stringify(changes),
      });
      setNotice("Support request updated.");
      await loadTickets();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to update support request.");
    } finally {
      setSaving(false);
    }
  }

  async function assignToMe(ticket: Escalation) {
    await updateTicket(ticket, { status: "ASSIGNED" });
  }

  return (
    <div className="chatbot-admin-page">
      <header className="chatbot-admin-heading">
        <div>
          <span className="chatbot-admin-eyebrow">CUSTOMER CARE</span>
          <h1>Chatbot Support Requests</h1>
          <p>Review escalated website conversations and record the action taken.</p>
        </div>
        <button className="chatbot-button chatbot-button-secondary" onClick={() => void loadTickets()}>
          Refresh
        </button>
      </header>

      {error && <div className="chatbot-alert chatbot-alert-error">{error}</div>}
      {notice && <div className="chatbot-alert chatbot-alert-success">{notice}</div>}

      <section className="chatbot-ticket-summary">
        {(["PENDING", "ASSIGNED", "RESOLVED", "REJECTED"] as TicketStatus[]).map((status) => (
          <button
            type="button"
            key={status}
            className={`chatbot-summary-card ${statusFilter === status ? "is-selected" : ""}`}
            onClick={() => setStatusFilter(statusFilter === status ? "ALL" : status)}
          >
            <span>{status}</span>
            <strong>{tickets.filter((ticket) => ticket.status === status).length}</strong>
          </button>
        ))}
      </section>

      <div className="chatbot-ticket-layout">
        <section className="chatbot-admin-panel chatbot-ticket-list-panel">
          <div className="chatbot-panel-heading">
            <div>
              <h2>Requests</h2>
              <p>{filteredTickets.length} request(s)</p>
            </div>
            <select
              aria-label="Filter support requests"
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
            >
              <option value="ALL">All statuses</option>
              <option value="PENDING">Pending</option>
              <option value="ASSIGNED">Assigned</option>
              <option value="RESOLVED">Resolved</option>
              <option value="REJECTED">Rejected</option>
            </select>
          </div>

          {loading ? (
            <p className="chatbot-empty-state">Loading support requests...</p>
          ) : filteredTickets.length === 0 ? (
            <p className="chatbot-empty-state">No support requests found.</p>
          ) : (
            <div className="chatbot-ticket-list">
              {filteredTickets.map((ticket) => (
                <button
                  type="button"
                  key={ticket.id}
                  className={`chatbot-ticket-row ${selectedId === ticket.id ? "is-active" : ""}`}
                  onClick={() => setSelectedId(ticket.id)}
                >
                  <span className={`chatbot-status chatbot-status-${ticket.status.toLowerCase()}`}>
                    {ticket.status}
                  </span>
                  <strong>{ticket.subject}</strong>
                  <span>{ticket.department}</span>
                  <small>{ticket.conversation?.visitorName || "Website visitor"} · {formatDate(ticket.createdAt)}</small>
                </button>
              ))}
            </div>
          )}
        </section>

        <section className="chatbot-admin-panel chatbot-ticket-detail">
          {!selected ? (
            <div className="chatbot-empty-state">Select a support request to view its details.</div>
          ) : (
            <>
              <div className="chatbot-panel-heading">
                <div>
                  <span className={`chatbot-status chatbot-status-${selected.status.toLowerCase()}`}>
                    {selected.status}
                  </span>
                  <h2>{selected.subject}</h2>
                  <p>Department: {selected.department}</p>
                </div>
              </div>

              <div className="chatbot-ticket-contact">
                <div>
                  <small>Visitor</small>
                  <strong>{selected.conversation?.visitorName || "Not provided"}</strong>
                </div>
                <div>
                  <small>Email</small>
                  <strong>{selected.conversation?.visitorEmail || "Not provided"}</strong>
                </div>
                <div>
                  <small>Submitted</small>
                  <strong>{formatDate(selected.createdAt)}</strong>
                </div>
              </div>

              <div className="chatbot-ticket-description">
                <h3>Request description</h3>
                <p>{selected.description}</p>
              </div>

              <div className="chatbot-transcript">
                <h3>Conversation transcript</h3>
                {(selected.conversation?.messages ?? []).length === 0 ? (
                  <p className="chatbot-empty-state">No transcript messages were returned by the API.</p>
                ) : (
                  selected.conversation!.messages!.map((message) => (
                    <div className={`chatbot-transcript-message chatbot-transcript-${message.role.toLowerCase()}`} key={message.id}>
                      <div>
                        <strong>{message.role === "USER" ? "Visitor" : message.role === "ASSISTANT" ? "Chatbot" : "System"}</strong>
                        <small>{formatDate(message.createdAt)}</small>
                      </div>
                      <p>{message.content}</p>
                    </div>
                  ))
                )}
              </div>

              <div className="chatbot-resolution">
                <label htmlFor="ticket-resolution">Resolution / internal handling notes</label>
                <textarea
                  id="ticket-resolution"
                  rows={4}
                  maxLength={5000}
                  value={resolution}
                  onChange={(e) => setResolution(e.target.value)}
                  placeholder="Record the action taken, response given, or reason for rejection..."
                />
                <button
                  className="chatbot-button chatbot-button-secondary"
                  disabled={saving}
                  onClick={() => void updateTicket(selected, { resolution })}
                >
                  Save notes
                </button>
              </div>

              <div className="chatbot-ticket-actions">
                {selected.status !== "ASSIGNED" && selected.status !== "RESOLVED" && (
                  <button
                    className="chatbot-button chatbot-button-secondary"
                    disabled={saving}
                    onClick={() => void assignToMe(selected)}
                  >
                    Assign to me
                  </button>
                )}

                {selected.status !== "RESOLVED" && (
                  <button
                    className="chatbot-button"
                    disabled={saving || !resolution.trim()}
                    onClick={() => void updateTicket(selected, { status: "RESOLVED", resolution })}
                  >
                    Mark resolved
                  </button>
                )}

                {selected.status !== "REJECTED" && selected.status !== "RESOLVED" && (
                  <button
                    className="chatbot-button chatbot-button-danger"
                    disabled={saving}
                    onClick={() => void updateTicket(selected, { status: "REJECTED", resolution })}
                  >
                    Reject request
                  </button>
                )}
              </div>
            </>
          )}
        </section>
      </div>
    </div>
  );
}

```

