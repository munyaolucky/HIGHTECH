# Module 37 – HI-TECH College Chatbot Admin Dashboard

This module adds two administration screens to the chatbot introduced in Module 36:

1. Knowledge Base Management – create, edit, search, draft, publish and archive approved answers.
2. Support Escalations – review conversations, assign requests, update ticket status and record resolutions.

The screens use the existing `/api/chatbot-admin` endpoints. They do not display fabricated analytics or pretend that live-agent chat is available.

## 1. Knowledge Base page

Create `apps/web/src/pages/admin/ChatbotKnowledgePage.tsx`.

This implementation assumes the admin API returns `{ articles: [...] }` for the knowledge list, and accepts `category`, `question`, `answer` and `keywords` when creating or editing an article.

```

import { useEffect, useMemo, useState } from "react";
import "./chatbot-admin.css";

type ArticleStatus = "DRAFT" | "PUBLISHED" | "ARCHIVED";

type Article = {
  id: string;
  category: string;
  question: string;
  answer: string;
  keywords: string[];
  status: ArticleStatus;
  createdAt: string;
  updatedAt: string;
};

type ArticleForm = {
  category: string;
  question: string;
  answer: string;
  keywords: string;
};

const API = "/api/chatbot-admin";

async function apiRequest<T>(path: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`${API}${path}`, {
    ...options,
    credentials: "include",
    headers: {
      "Content-Type": "application/json",
      ...options.headers,
    },
  });

  const payload = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(payload.message || payload.error || `Request failed (${response.status})`);
  }

  return payload as T;
}

const emptyForm: ArticleForm = {
  category: "",
  question: "",
  answer: "",
  keywords: "",
};

export default function ChatbotKnowledgePage() {
  const [articles, setArticles] = useState<Article[]>([]);
  const [form, setForm] = useState<ArticleForm>(emptyForm);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("ALL");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  async function loadArticles() {
    setLoading(true);
    setError("");

    try {
      const result = await apiRequest<{ articles: Article[] }>("/knowledge");
      setArticles(result.articles ?? []);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to load knowledge articles.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadArticles();
  }, []);

  const filteredArticles = useMemo(() => {
    const term = search.trim().toLowerCase();

    return articles.filter((article) => {
      const matchesStatus =
        statusFilter === "ALL" || article.status === statusFilter;

      const searchable = [
        article.category,
        article.question,
        article.answer,
        ...(article.keywords ?? []),
      ].join(" ").toLowerCase();

      return matchesStatus && (!term || searchable.includes(term));
    });
  }, [articles, search, statusFilter]);

  function startEdit(article: Article) {
    setEditingId(article.id);
    setForm({
      category: article.category,
      question: article.question,
      answer: article.answer,
      keywords: (article.keywords ?? []).join(", "),
    });
    setNotice("");
    setError("");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function resetForm() {
    setEditingId(null);
    setForm(emptyForm);
  }

  async function saveArticle(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSaving(true);
    setError("");
    setNotice("");

    const payload = {
      category: form.category.trim(),
      question: form.question.trim(),
      answer: form.answer.trim(),
      keywords: form.keywords
        .split(",")
        .map((keyword) => keyword.trim())
        .filter(Boolean),
    };

    try {
      if (editingId) {
        await apiRequest(`/knowledge/${editingId}`, {
          method: "PATCH",
          body: JSON.stringify(payload),
        });
        setNotice("Knowledge article updated.");
      } else {
        await apiRequest("/knowledge", {
          method: "POST",
          body: JSON.stringify(payload),
        });
        setNotice("Knowledge article created as a draft. Review it before publishing.");
      }

      resetForm();
      await loadArticles();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to save article.");
    } finally {
      setSaving(false);
    }
  }

  async function changeStatus(article: Article, status: ArticleStatus) {
    setError("");
    setNotice("");

    try {
      await apiRequest(`/knowledge/${article.id}/status`, {
        method: "PATCH",
        body: JSON.stringify({ status }),
      });
      setNotice(`Article status changed to ${status.toLowerCase()}.`);
      await loadArticles();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to update article status.");
    }
  }

  async function archiveArticle(article: Article) {
    if (!window.confirm(`Archive "${article.question}"?`)) return;
    await changeStatus(article, "ARCHIVED");
  }

  return (
    <div className="chatbot-admin-page">
      <header className="chatbot-admin-heading">
        <div>
          <span className="chatbot-admin-eyebrow">WEBSITE MANAGEMENT</span>
          <h1>Chatbot Knowledge Base</h1>
          <p>Manage the approved information used by the college website chatbot.</p>
        </div>
        <button className="chatbot-button chatbot-button-secondary" onClick={() => void loadArticles()}>
          Refresh
        </button>
      </header>

      {error && <div className="chatbot-alert chatbot-alert-error">{error}</div>}
      {notice && <div className="chatbot-alert chatbot-alert-success">{notice}</div>}

      <section className="chatbot-admin-panel">
        <div className="chatbot-panel-heading">
          <div>
            <h2>{editingId ? "Edit knowledge article" : "Add knowledge article"}</h2>
            <p>Use clear questions and verified answers from the relevant college office.</p>
          </div>
          {editingId && (
            <button type="button" className="chatbot-text-button" onClick={resetForm}>
              Cancel editing
            </button>
          )}
        </div>

        <form onSubmit={saveArticle} className="chatbot-knowledge-form">
          <label>
            Category
            <input
              required
              maxLength={100}
              value={form.category}
              onChange={(e) => setForm({ ...form, category: e.target.value })}
              placeholder="e.g. Admissions, Fees, Examinations"
            />
          </label>

          <label>
            Question or topic
            <input
              required
              maxLength={500}
              value={form.question}
              onChange={(e) => setForm({ ...form, question: e.target.value })}
              placeholder="e.g. How do I apply for admission?"
            />
          </label>

          <label className="chatbot-form-full">
            Approved answer
            <textarea
              required
              rows={6}
              maxLength={10000}
              value={form.answer}
              onChange={(e) => setForm({ ...form, answer: e.target.value })}
              placeholder="Enter the verified response the chatbot should use..."
            />
          </label>

          <label className="chatbot-form-full">
            Search keywords
            <input
              value={form.keywords}
              onChange={(e) => setForm({ ...form, keywords: e.target.value })}
              placeholder="admission, application, intake, registration"
            />
            <small>Separate keywords with commas.</small>
          </label>

          <div className="chatbot-form-actions chatbot-form-full">
            <button className="chatbot-button" type="submit" disabled={saving}>
              {saving ? "Saving..." : editingId ? "Save changes" : "Create draft"}
            </button>
            {editingId && (
              <button className="chatbot-button chatbot-button-secondary" type="button" onClick={resetForm}>
                Cancel
              </button>
            )}
          </div>
        </form>
      </section>

      <section className="chatbot-admin-panel">
        <div className="chatbot-panel-heading">
          <div>
            <h2>Knowledge articles</h2>
            <p>{filteredArticles.length} article(s) displayed</p>
          </div>
        </div>

        <div className="chatbot-list-toolbar">
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search questions, answers or keywords..."
            aria-label="Search knowledge articles"
          />
          <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)}>
            <option value="ALL">All statuses</option>
            <option value="DRAFT">Draft</option>
            <option value="PUBLISHED">Published</option>
            <option value="ARCHIVED">Archived</option>
          </select>
        </div>

        {loading ? (
          <p className="chatbot-empty-state">Loading knowledge articles...</p>
        ) : filteredArticles.length === 0 ? (
          <p className="chatbot-empty-state">No knowledge articles match this search.</p>
        ) : (
          <div className="chatbot-article-list">
            {filteredArticles.map((article) => (
              <article className="chatbot-article-card" key={article.id}>
                <div className="chatbot-article-main">
                  <div className="chatbot-article-meta">
                    <span>{article.category}</span>
                    <span className={`chatbot-status chatbot-status-${article.status.toLowerCase()}`}>
                      {article.status}
                    </span>
                  </div>
                  <h3>{article.question}</h3>
                  <p>{article.answer}</p>
                  <div className="chatbot-keywords">
                    {(article.keywords ?? []).map((keyword) => (
                      <span key={keyword}>{keyword}</span>
                    ))}
                  </div>
                </div>

                <div className="chatbot-article-actions">
                  <button className="chatbot-text-button" onClick={() => startEdit(article)}>
                    Edit
                  </button>

                  {article.status !== "PUBLISHED" && (
                    <button
                      className="chatbot-text-button"
                      onClick={() => void changeStatus(article, "PUBLISHED")}
                    >
                      Publish
                    </button>
                  )}

                  {article.status === "PUBLISHED" && (
                    <button
                      className="chatbot-text-button"
                      onClick={() => void changeStatus(article, "DRAFT")}
                    >
                      Unpublish
                    </button>
                  )}

                  {article.status !== "ARCHIVED" && (
                    <button
                      className="chatbot-text-button chatbot-danger-text"
                      onClick={() => void archiveArticle(article)}
                    >
                      Archive
                    </button>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  );
}

