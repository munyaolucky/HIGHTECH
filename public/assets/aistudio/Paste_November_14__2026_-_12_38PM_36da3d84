                </Field>
              </div>
            )}

            {step === 3 && !["STUDENT", "STAFF"].includes(category) && (
              <div className="registration-form-grid">
                <Field label="Organization / role">
                  <input value={form.jobTitle} onChange={(e) => update("jobTitle", e.target.value)} />
                </Field>
                <Field label="Additional reference">
                  <input value={form.notes} onChange={(e) => update("notes", e.target.value)} />
                </Field>
              </div>
            )}

            {step === 4 && category === "PARENT" && (
              <div className="registration-form-grid">
                <Field label="Student registration number" required>
                  <input value={form.studentNumber} onChange={(e) => update("studentNumber", e.target.value)} placeholder="HCA/STU/2026/0001" />
                </Field>
                <Field label="Relationship" required>
                  <select value={form.relationship} onChange={(e) => update("relationship", e.target.value)}>
                    <option value="">Select relationship</option>
                    <option value="PARENT">Parent</option>
