            )}
          </div>

          <div className="registration-form-footer">
            <button
              className="reg-button reg-button-outline"
              disabled={step === 0 || saving}
              onClick={() => setStep((current) => current - 1)}
            >
              <ChevronLeft size={17} /> Previous
            </button>

            <div>
              <button
                className="reg-button reg-button-outline"
                disabled={saving}
                onClick={() => saveRegistration(false)}
              >
                Save draft
              </button>

              {step < steps.length - 1 ? (
                <button className="reg-button reg-button-primary" onClick={nextStep}>
                  Continue <ChevronRight size={17} />
                </button>
              ) : (
                <button
                  className="reg-button reg-button-primary"
                  disabled={saving}
                  onClick={() => saveRegistration(true)}
                >
                  {saving ? "Submitting..." : "Submit for approval"}
                </button>
              )}
            </div>
          </div>
        </section>
      )}

      {selectedRecord && (
        <div className="registration-modal-backdrop" role="presentation">
          <section
            className="registration-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="record-title"
          >
            <button
              className="registration-modal-close"
              aria-label="Close record details"
              onClick={() => setSelectedRecord(null)}
            >
              ×
            </button>
            <span className="registration-eyebrow">REGISTRATION RECORD</span>
            <h2 id="record-title">{selectedRecord.fullName}</h2>
            <p>{selectedRecord.registrationNumber}</p>
            <StatusBadge status={selectedRecord.status} />
            <dl>
              <div><dt>Category</dt><dd>{selectedRecord.category}</dd></div>
              <div><dt>Email</dt><dd>{selectedRecord.email}</dd></div>
              <div><dt>Phone</dt><dd>{selectedRecord.phone}</dd></div>
              <div><dt>Campus</dt><dd>{selectedRecord.campus}</dd></div>
              <div><dt>Department</dt><dd>{selectedRecord.department}</dd></div>
            </dl>
            <div className="registration-modal-actions">
              {canApprove && selectedRecord.status === "UNDER_REVIEW" && (
                <>
                  <button className="reg-button reg-button-primary" disabled>
                    Approval API required
                  </button>
                  <button className="reg-button reg-button-outline" disabled>
                    Request changes
                  </button>
                </>
              )}
              {canActivate && selectedRecord.status === "APPROVED" && (
                <button className="reg-button reg-button-primary" disabled>
                  Invitation API required
                </button>
              )}
              <button
                className="reg-button reg-button-outline"
                onClick={() => setSelectedRecord(null)}
              >
                Close
              </button>
            </div>
          </section>
        </div>
      )}
    </main>
  );
}

function RegistrationTable({
  records,
  onSelect,
}: {
  records: RegistrationRecord[];
  onSelect: (record: RegistrationRecord) => void;
}) {
  if (!records.length) {
    return (
      <div className="registration-empty">
        <Search size={25} />
        <strong>No registrations found</strong>
        <p>Try changing your search or filter.</p>
      </div>
    );
  }

  return (
    <div className="registration-table-wrap">
      <table className="registration-table">
        <thead>
          <tr>
            <th>Person</th>
            <th>Registration number</th>
            <th>Category</th>
            <th>Campus</th>
            <th>Status</th>
            <th aria-label="Actions" />
          </tr>
        </thead>
        <tbody>
          {records.map((record) => (
            <tr key={record.id}>
              <td>
                <strong>{record.fullName}</strong>
                <small>{record.email}</small>
              </td>
              <td>{record.registrationNumber}</td>
              <td>{record.category}</td>
              <td>{record.campus}</td>
              <td><StatusBadge status={record.status} /></td>
              <td>
                <button
                  className="registration-icon-button"
                  aria-label={`View ${record.fullName}`}
                  onClick={() => onSelect(record)}
                >
                  <Eye size={17} />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

