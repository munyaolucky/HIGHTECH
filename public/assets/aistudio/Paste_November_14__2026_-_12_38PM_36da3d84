export default function RegistrationWorkspace({
  permissions,
  onCreate,
}: Props) {
  const [records, setRecords] = useState(initialRecords);
  const [category, setCategory] =
    useState<RegistrationCategory>("STUDENT");
  const [form, setForm] =
    useState<RegistrationFormData>(EMPTY_REGISTRATION);
  const [step, setStep] = useState(0);
  const [view, setView] = useState<"dashboard" | "create" | "directory">(
    "dashboard"
  );
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("ALL");
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");
  const [saving, setSaving] = useState(false);
  const [selectedRecord, setSelectedRecord] =
    useState<RegistrationRecord | null>(null);

  const can = (permission: string) =>
    permissions.includes(permission);

  const canCreate = can("users.registration.create");
  const canView = can("users.registration.view");
  const canApprove = can("users.registration.approve");
  const canActivate = can("users.registration.activate");

  const filteredRecords = useMemo(() => {
    return records.filter((record) => {
      const query = search.toLowerCase();

      const matchesSearch =
        record.fullName.toLowerCase().includes(query) ||
        record.registrationNumber.toLowerCase().includes(query) ||
        record.email.toLowerCase().includes(query);

      const matchesFilter =
        filter === "ALL" || record.status === filter;

      return matchesSearch && matchesFilter;
    });
  }, [records, search, filter]);

  const stats = {
    total: records.length,
    pending: records.filter((r) =>
      ["SUBMITTED", "UNDER_REVIEW"].includes(r.status)
    ).length,
    approved: records.filter((r) =>
      ["APPROVED", "INVITED", "ACTIVATED"].includes(r.status)
    ).length,
    drafts: records.filter((r) => r.status === "DRAFT").length,
  };

  function update<K extends keyof RegistrationFormData>(
    key: K,
    value: RegistrationFormData[K]
  ) {
    setForm((previous) => ({ ...previous, [key]: value }));
    setError("");
  }

  function startRegistration(type: RegistrationCategory) {
    if (!canCreate) return;

    setCategory(type);
    setForm(EMPTY_REGISTRATION);
    setStep(0);
    setError("");
    setSuccess("");
    setView("create");
  }

  function validateStep() {
    if (step === 0) {
      if (!form.firstName.trim() || !form.lastName.trim()) {
        return "Enter the first name and last name.";
      }
    }

    if (step === 1) {
      if (!form.phone.trim()) {
        return "Enter a contact phone number.";
      }

      if (
        form.email &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email)
      ) {
        return "Enter a valid email address.";
      }
    }

    if (category === "STUDENT" && step === 3) {
      if (!form.programmeId || !form.campusId) {
        return "Select a programme and campus.";
      }
    }

    if (category === "STAFF" && step === 3) {
      if (!form.jobTitle.trim() || !form.departmentId) {
        return "Enter the job title and department.";
      }
    }

    if (category === "PARENT" && step === 4) {
      if (!form.studentNumber.trim() || !form.relationship) {
        return "Enter the student's number and relationship.";
      }
    }

    return "";
  }

  function nextStep() {
    const validation = validateStep();

    if (validation) {
      setError(validation);
      return;
    }

    setStep((current) => Math.min(current + 1, steps.length - 1));
  }

  async function saveRegistration(submit: boolean) {
    if (!canCreate || saving) return;

    const validation = validateStep();
    if (validation) {
      setError(validation);
      return;
    }

    if (!form.firstName.trim() || !form.lastName.trim()) {
      setError("First name and last name are required.");
      return;
    }

    setSaving(true);
    setError("");
    setSuccess("");

    try {
      if (!onCreate) {
        throw new Error(
          "Registration API is not connected yet. Connect the onCreate handler."
        );
      }

      await onCreate(category, form, submit);

      setSuccess(
        submit
          ? "Registration submitted successfully."
          : "Registration draft saved successfully."
      );

      setView("dashboard");
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to save registration."
      );
    } finally {
      setSaving(false);
    }
  }

  const fullName = [
    form.firstName,
    form.middleName,
    form.lastName,
  ].filter(Boolean).join(" ");

  return (
    <main className="registration-workspace">
      <header className="registration-topbar">
        <div>
          <div className="registration-eyebrow">
            HI-TECH COLLEGE / ADMINISTRATION
          </div>
          <h1>User Registration</h1>
          <p>Manage institutional records and portal onboarding.</p>
        </div>

        <div className="registration-top-actions">
          <span className="registration-campus">
            <Building2 size={16} /> Kitengela Campus
          </span>
          {canCreate && (
            <button
              className="reg-button reg-button-primary"
              onClick={() => setView("create")}
            >
              <Plus size={17} /> New registration
            </button>
          )}
        </div>
      </header>

      <nav className="registration-tabs">
        <button
          className={view === "dashboard" ? "active" : ""}
          onClick={() => setView("dashboard")}
        >
          <LayoutDashboard size={16} /> Overview
        </button>
        {canView && (
          <button
            className={view === "directory" ? "active" : ""}
            onClick={() => setView("directory")}
          >
            <Users size={16} /> User directory
          </button>
        )}
        {canCreate && (
          <button
            className={view === "create" ? "active" : ""}
            onClick={() => setView("create")}
          >
            <UserPlus size={16} /> Register user
          </button>
        )}
      </nav>

      {error && (
        <div className="registration-alert alert-error" role="alert">
          <XCircle size={18} /> {error}
        </div>
      )}

      {success && (
        <div className="registration-alert alert-success" role="status">
          <CheckCircle2 size={18} /> {success}
        </div>
      )}

      {view === "dashboard" && (
        <>
          <section className="registration-stats">
            <article className="registration-stat">
              <span>Total records</span>
              <strong>{stats.total}</strong>
              <Users size={21} />
            </article>
            <article className="registration-stat">
              <span>Awaiting review</span>
              <strong>{stats.pending}</strong>
              <Clock3 size={21} />
            </article>
            <article className="registration-stat">
              <span>Approved / active</span>
              <strong>{stats.approved}</strong>
              <CheckCircle2 size={21} />
            </article>
            <article className="registration-stat">
              <span>Drafts</span>
              <strong>{stats.drafts}</strong>
              <FileText size={21} />
            </article>
          </section>

          <section className="registration-panel">
            <div className="registration-section-heading">
              <div>
                <h2>Create a registration</h2>
                <p>Select the type of institutional record.</p>
              </div>
            </div>

            <div className="registration-category-grid">
              {categories.map((item) => {
                const Icon = item.icon;

                return (
                  <button
                    key={item.id}
                    className="registration-category-card"
                    disabled={!canCreate}
                    onClick={() => startRegistration(item.id)}
                  >
                    <span className="category-icon">
                      <Icon size={22} />
                    </span>
                    <strong>{item.label}</strong>
                    <small>{item.description}</small>
                    <ChevronRight size={17} className="category-arrow" />
                  </button>
                );
              })}
            </div>
          </section>

          <section className="registration-panel">
            <div className="registration-section-heading">
              <div>
                <h2>Recent registrations</h2>
                <p>Latest records in this workspace.</p>
              </div>
              {canView && (
                <button
                  className="reg-button reg-button-outline"
                  onClick={() => setView("directory")}
                >
                  View all
                </button>
              )}
            </div>
            <RegistrationTable
              records={records.slice(0, 5)}
              onSelect={setSelectedRecord}
            />
          </section>
        </>
      )}

      {view === "directory" && canView && (
        <section className="registration-panel">
          <div className="registration-section-heading">
            <div>
              <h2>User directory</h2>
              <p>Search registration records you are authorized to view.</p>
            </div>
          </div>

          <div className="registration-toolbar">
            <div className="registration-search">
              <Search size={17} />
              <input
                value={search}
                onChange={(event) => setSearch(event.target.value)}
                placeholder="Search name, number or email..."
              />
            </div>

            <select
              value={filter}
              onChange={(event) => setFilter(event.target.value)}
              aria-label="Filter registration status"
            >
              <option value="ALL">All statuses</option>
              {Object.entries(statusLabels).map(([value, label]) => (
                <option value={value} key={value}>{label}</option>
              ))}
            </select>
          </div>

          <RegistrationTable
            records={filteredRecords}
            onSelect={setSelectedRecord}
          />
        </section>
      )}

      {view === "create" && canCreate && (
        <section className="registration-panel registration-form-panel">
          <div className="registration-section-heading">
            <div>
              <span className="registration-eyebrow">NEW RECORD</span>
              <h2>{categories.find((item) => item.id === category)?.label} registration</h2>
              <p>Complete the required information before submission.</p>
            </div>
            <button
