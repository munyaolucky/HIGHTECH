                    <option value="HOSPITALITY">Hospitality</option>
                    <option value="ACADEMIC">Academic Office</option>
                    <option value="ADMINISTRATION">Administration</option>
                  </select>
                </Field>
              </div>
            )}

            {step === 3 && category === "STUDENT" && (
              <div className="registration-form-grid">
                <Field label="Programme" required>
                  <select value={form.programmeId} onChange={(e) => update("programmeId", e.target.value)}>
                    <option value="">Select programme</option>
                    <option value="ICT">Information Communication Technology</option>
                    <option value="COMPUTER_SCIENCE">Computer Science</option>
                    <option value="BUSINESS">Business Management</option>
                    <option value="HOSPITALITY">Hospitality</option>
                  </select>
                </Field>
                <Field label="Intake">
                  <select value={form.intake} onChange={(e) => update("intake", e.target.value)}>
                    <option value="">Select intake</option>
                    <option value="JANUARY_2027">January 2027</option>
                    <option value="MAY_2027">May 2027</option>
                    <option value="SEPTEMBER_2027">September 2027</option>
                  </select>
                </Field>
                <Field label="Study mode">
                  <select value={form.studyMode} onChange={(e) => update("studyMode", e.target.value)}>
                    <option value="FULL_TIME">Full time</option>
                    <option value="PART_TIME">Part time</option>
                    <option value="ONLINE">Online</option>
                    <option value="HYBRID">Hybrid</option>
                  </select>
                </Field>
              </div>
            )}

            {step === 3 && category === "STAFF" && (
              <div className="registration-form-grid">
                <Field label="Job title" required>
                  <input value={form.jobTitle} onChange={(e) => update("jobTitle", e.target.value)} placeholder="e.g. Lecturer" />
                </Field>
                <Field label="Employment type">
                  <select value={form.employmentType} onChange={(e) => update("employmentType", e.target.value)}>
                    <option value="">Select employment type</option>
                    <option value="PERMANENT">Permanent</option>
                    <option value="CONTRACT">Contract</option>
                    <option value="PART_TIME">Part time</option>
                    <option value="TEMPORARY">Temporary</option>
