                    <option value="FEMALE">Female</option>
                    <option value="MALE">Male</option>
                    <option value="OTHER">Other</option>
                    <option value="NOT_DISCLOSED">Prefer not to say</option>
                  </select>
                </Field>
              </div>
            )}

            {step === 1 && (
              <div className="registration-form-grid">
                <Field label="Email address">
                  <input type="email" value={form.email} onChange={(e) => update("email", e.target.value)} />
                </Field>
                <Field label="Phone number" required>
                  <input value={form.phone} onChange={(e) => update("phone", e.target.value)} placeholder="+254..." />
                </Field>
              </div>
            )}

            {step === 2 && (
              <div className="registration-form-grid">
                <Field label="Campus" required>
                  <select value={form.campusId} onChange={(e) => update("campusId", e.target.value)}>
                    <option value="">Select campus</option>
                    <option value="KITENGELA">Kitengela Campus</option>
