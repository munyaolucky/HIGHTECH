}

.um-alert button {
  display: grid;
  place-items: center;
  margin-left: auto;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.um-alert--error { color: #a61b1b; background: #fff0f0; }
.um-alert--success { color: #087b55; background: #e8f7f0; }

.um-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgb(12 27 45 / 55%);
}

.um-modal {
  width: min(650px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  padding: 23px;
  border-radius: 16px;
  background: white;
  box-shadow: 0 20px 70px rgb(0 0 0 / 20%);
}

.um-modal h2 {
  margin: 6px 0 0;
  color: var(--um-navy);
}

.um-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 24px 0;
}

.um-detail {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.um-detail span,
.um-modal__status > span {
  color: var(--um-muted);
  font-size: 11px;
}

.um-detail strong {
  overflow-wrap: anywhere;
  color: var(--um-navy);
  font-size: 13px;
}

.um-modal__status {
  padding: 13px 0;
  border-top: 1px solid var(--um-border);
  border-bottom: 1px solid var(--um-border);
}

.um-modal__actions { margin-top: 17px; }

.um-security-note {
  margin: 18px 0 0;
  color: var(--um-muted);
  font-size: 11px;
  line-height: 1.6;
}

@media (max-width: 900px) {
  .um-stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .um-filters { grid-template-columns: 1fr 1fr; }
  .um-search { grid-column: 1 / -1; }
}

@media (max-width: 600px) {
  .user-management { padding: 16px; }
  .user-management__header { align-items: flex-start; flex-direction: column; }
