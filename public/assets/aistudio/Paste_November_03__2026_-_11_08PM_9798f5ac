        <a
          className="ai-button ai-button-outline"
          href="/api/ai-admin/audit/export.csv"
          target="_blank"
          rel="noreferrer"
        >
          Export CSV
        </a>
      </header>

      <section className="ai-admin-panel">
        <div className="ai-audit-filters">
          <label>
            Action
            <select value={action} onChange={(e) => setAction(e.target.value)}>
              <option value="">All actions</option>
              <option value="CONFIG_UPDATED">Configuration updated</option>
              <option value="AI_ENABLED">AI enabled</option>
              <option value="AI_DISABLED">AI disabled</option>
              <option value="EMERGENCY_DISABLED">Emergency disabled</option>
              <option value="PROVIDER_CHECKED">Provider checked</option>
              <option value="PROMPT_CREATED">Prompt created</option>
              <option value="PROMPT_PUBLISHED">Prompt published</option>
              <option value="INDEXING_REQUESTED">Indexing requested</option>
              <option value="QUOTA_UPDATED">Quota updated</option>
            </select>
          </label>

          <label>
            Target type
            <input
              value={targetType}
              onChange={(e) => setTargetType(e.target.value)}
              placeholder="e.g. AI_PROMPT"
            />
          </label>

          <label>
            From
            <input
              type="datetime-local"
              value={from}
              onChange={(e) => setFrom(e.target.value)}
            />
          </label>

          <label>
            To
            <input
              type="datetime-local"
              value={to}
              onChange={(e) => setTo(e.target.value)}
            />
          </label>

          <button className="ai-button" onClick={applyFilters} disabled={loading}>
            Apply filters
          </button>
        </div>
      </section>

      <section className="ai-admin-panel">
        <h2>Audit events</h2>

        {error && <div className="ai-alert ai-alert-error">{error}</div>}
        {loading ? (
          <p>Loading audit events...</p>
        ) : records.length === 0 ? (
          <p>No audit records found.</p>
        ) : (
          <div className="ai-audit-list">
            {records.map((record) => (
              <article className="ai-audit-record" key={record.id}>
                <div>
                  <strong>{record.action.replaceAll("_", " ")}</strong>
                  <p>{record.targetType} · {record.targetId ?? "No target ID"}</p>
                </div>
                <div className="ai-audit-meta">
                  <span>Actor: {record.actorId ?? "System"}</span>
                  <span>{new Date(record.createdAt).toLocaleString()}</span>
                </div>
                <details>
                  <summary>View event details</summary>
                  <pre>{JSON.stringify(record.details ?? {}, null, 2)}</pre>
                </details>
              </article>
            ))}
          </div>
        )}

        <div className="ai-form-actions">
          <button
            className="ai-button ai-button-outline"
            disabled={!cursor || loading}
            onClick={() => void loadAudit(false)}
          >
            First page
          </button>
          <button
            className="ai-button"
            disabled={!nextCursor || loading}
            onClick={() => void loadAudit(true)}
          >
            Next page
          </button>
        </div>
      </section>
    </main>
  );
}

