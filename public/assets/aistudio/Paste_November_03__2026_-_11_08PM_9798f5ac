Important: `articleId` is intentionally not declared as a Prisma relation here because the existing article model's ID and tenant ownership should be verified before adding a foreign key. Every job query must still verify that the article belongs to the same institution.

## 2. Indexing queue service

Create `apps/api/src/services/aiIndexingQueue.ts`.

This service creates indexing jobs and prevents duplicate pending jobs for the same article.

```

import { prisma } from "../lib/prisma";

export async function enqueueKnowledgeIndexing(input: {
  institutionId: string;
  articleId: string;
  requestedById?: string;
}) {
  const article = await prisma.chatbotKnowledgeArticle.findFirst({
    where: {
      id: input.articleId,
      institutionId: input.institutionId,
      status: "PUBLISHED",
    },
    select: { id: true },
  });

  if (!article) {
    throw new Error("Published knowledge article not found.");
  }

  const existing = await prisma.aIKnowledgeIndexJob.findFirst({
    where: {
      institutionId: input.institutionId,
      articleId: input.articleId,
      status: { in: ["PENDING", "PROCESSING"] },
    },
    orderBy: { createdAt: "desc" },
  });

  if (existing) return existing;

  await prisma.chatbotKnowledgeArticle.update({
    where: { id: article.id },
    data: {
      indexingStatus: "PENDING",
      indexingError: null,
    },
  });

  return prisma.aIKnowledgeIndexJob.create({
    data: {
      institutionId: input.institutionId,
      articleId: input.articleId,
      requestedById: input.requestedById,
      status: "PENDING",
      nextRetryAt: new Date(),
    },
  });
}

export async function cancelKnowledgeIndexing(input: {
  institutionId: string;
  jobId: string;
}) {
  const job = await prisma.aIKnowledgeIndexJob.findFirst({
    where: {
      id: input.jobId,
      institutionId: input.institutionId,
      status: "PENDING",
    },
  });

  if (!job) {
    throw new Error("Pending indexing job not found.");
  }

  return prisma.aIKnowledgeIndexJob.update({
    where: { id: job.id },
    data: { status: "CANCELLED" },
  });
}

```

## 3. Indexing worker

Create `apps/api/src/services/aiIndexingWorker.ts`.

The worker processes pending jobs, updates article status and retries failures with increasing delays.

```

import { prisma } from "../lib/prisma";
import { indexKnowledgeArticle } from "./chatbotKnowledgeIndex";

const WORKER_BATCH_SIZE = 5;
const MAX_ATTEMPTS = 5;

function retryDelayMinutes(attempt: number) {
  return Math.min(60, 2 ** Math.max(0, attempt - 1));
}

export async function processAIIndexingBatch() {
  const jobs = await prisma.aIKnowledgeIndexJob.findMany({
    where: {
      status: "PENDING",
      nextRetryAt: { lte: new Date() },
    },
    orderBy: { createdAt: "asc" },
    take: WORKER_BATCH_SIZE,
    select: { id: true, institutionId: true, articleId: true, attempts: true },
  });

  let processed = 0;

  for (const job of jobs) {
    // Atomic claim: only one worker can claim this pending job.
    const claimed = await prisma.aIKnowledgeIndexJob.updateMany({
      where: {
        id: job.id,
        status: "PENDING",
      },
      data: {
        status: "PROCESSING",
        startedAt: new Date(),
        attempts: { increment: 1 },
      },
    });

    if (claimed.count !== 1) continue;

    try {
      const article = await prisma.chatbotKnowledgeArticle.findFirst({
        where: {
          id: job.articleId,
          institutionId: job.institutionId,
          status: "PUBLISHED",
        },
        select: { id: true },
      });

      if (!article) {
        await prisma.aIKnowledgeIndexJob.update({
          where: { id: job.id },
          data: {
            status: "CANCELLED",
            lastError: "Article is no longer published or does not exist.",
            completedAt: new Date(),
          },
        });
        continue;
      }

      await indexKnowledgeArticle(job.institutionId, job.articleId);

      const indexedArticle = await prisma.chatbotKnowledgeArticle.findFirst({
        where: {
          id: job.articleId,
          institutionId: job.institutionId,
        },
        select: {
          embeddingModel: true,
          embeddingUpdatedAt: true,
        },
      });

      await prisma.$transaction([
        prisma.chatbotKnowledgeArticle.updateMany({
          where: {
            id: job.articleId,
            institutionId: job.institutionId,
          },
          data: {
            indexingStatus: "INDEXED",
            indexingError: null,
            indexedAt: indexedArticle?.embeddingUpdatedAt ?? new Date(),
            indexedModel: indexedArticle?.embeddingModel ?? null,
          },
        }),
        prisma.aIKnowledgeIndexJob.update({
          where: { id: job.id },
          data: {
            status: "INDEXED",
            embeddingModel: indexedArticle?.embeddingModel ?? null,
            completedAt: new Date(),
            lastError: null,
          },
        }),
      ]);

      processed++;
    } catch (error) {
      const message =
        error instanceof Error ? error.message.slice(0, 1500) : "Unknown indexing error";

      const current = await prisma.aIKnowledgeIndexJob.findUnique({
        where: { id: job.id },
        select: { attempts: true, maxAttempts: true },
      });

      const attempts = current?.attempts ?? job.attempts + 1;
      const maxAttempts = current?.maxAttempts ?? MAX_ATTEMPTS;
      const permanentlyFailed = attempts >= maxAttempts;

      const delay = retryDelayMinutes(attempts);

      await prisma.$transaction([
        prisma.aIKnowledgeIndexJob.update({
          where: { id: job.id },
          data: {
            status: permanentlyFailed ? "FAILED" : "PENDING",
            lastError: message,
            nextRetryAt: new Date(Date.now() + delay * 60_000),
            completedAt: permanentlyFailed ? new Date() : null,
          },
        }),
        prisma.chatbotKnowledgeArticle.updateMany({
          where: {
            id: job.articleId,
            institutionId: job.institutionId,
          },
          data: {
            indexingStatus: permanentlyFailed ? "FAILED" : "PENDING",
            indexingError: message,
          },
        }),
      ]);
    }
  }

  return { processed, checked: jobs.length };
}

```

### Start the worker

In `apps/api/src/workers/aiIndexingWorker.ts`:

```
import { processAIIndexingBatch } from "../services/aiIndexingWorker";

let running = false;

export function startAIIndexingWorker() {
  if (running) return;
  running = true;

  const run = async () => {
    try {
      await processAIIndexingBatch();
    } catch (error) {
      console.error("AI indexing worker failed:", error);
    }
  };

  void run();

  const interval = setInterval(() => {
    void run();
  }, 15_000);

  interval.unref?.();
}
```

Start it from the API bootstrap after the server has initialized:

```
import { startAIIndexingWorker } from "./workers/aiIndexingWorker";

if (process.env.AI_INDEXING_WORKER_ENABLED === "true") {
  startAIIndexingWorker();
}
```

Add to `.env`:

```
AI_INDEXING_WORKER_ENABLED=false
```

Set this to `true` only for the designated worker process. If the API runs on multiple instances, deploy a dedicated worker process rather than starting one in every API instance.

Worker recovery requirement: A process can crash after changing a job to `PROCESSING`. Add a scheduled recovery operation that moves stale processing jobs back to `PENDING` after a defined timeout, while ensuring that a job is not reclaimed while a legitimate long-running embedding request is still active. For production, a dedicated queue such as BullMQ is preferable.

## 4. Add indexing administration endpoints

Create `apps/api/src/routes/aiIndexingAdmin.ts`.

```

import { Router } from "express";
import { z } from "zod";
import { prisma } from "../lib/prisma";
import { requireAuth } from "../middleware/requireAuth";
import { allowRoles } from "../middleware/allowRoles";
import { enqueueKnowledgeIndexing, cancelKnowledgeIndexing } from "../services/aiIndexingQueue";
import { recordGovernanceAudit } from "../services/aiGovernance";

const router = Router();

router.use(requireAuth);
router.use(allowRoles("SUPER_ADMIN"));

function getScope(req: any) {
  if (!req.user?.institutionId || !req.user?.id) {
    throw new Error("Missing authenticated user scope.");
  }

  return {
    institutionId: req.user.institutionId,
    actorId: req.user.id,
  };
}

router.get("/jobs", async (req, res) => {
  try {
    const { institutionId } = getScope(req);

    const status = z.enum([
      "PENDING",
      "PROCESSING",
      "INDEXED",
      "FAILED",
      "CANCELLED",
    ]).optional().safeParse(req.query.status);

    if (!status.success) {
      return res.status(400).json({ message: "Invalid indexing status." });
    }

    const jobs = await prisma.aIKnowledgeIndexJob.findMany({
      where: {
        institutionId,
        ...(status.data ? { status: status.data } : {}),
      },
      orderBy: { createdAt: "desc" },
      take: 100,
    });

    const articleIds = [...new Set(jobs.map((job) => job.articleId))];

    const articles = await prisma.chatbotKnowledgeArticle.findMany({
      where: { institutionId, id: { in: articleIds } },
      select: { id: true, question: true, category: true },
    });

    const articleMap = new Map(articles.map((article) => [article.id, article]));

    return res.json({
      jobs: jobs.map((job) => ({
        ...job,
        article: articleMap.get(job.articleId) ?? null,
      })),
    });
  } catch (error) {
    console.error("Indexing jobs retrieval failed:", error);
    return res.status(500).json({ message: "Unable to load indexing jobs." });
  }
});

router.post("/articles/:articleId/reindex", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const job = await enqueueKnowledgeIndexing({
      institutionId,
      articleId: req.params.articleId,
      requestedById: actorId,
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "INDEXING_REQUESTED",
      targetType: "KNOWLEDGE_ARTICLE",
      targetId: req.params.articleId,
      details: { jobId: job.id },
    });

    return res.status(202).json({ job });
  } catch (error) {
    return res.status(400).json({
      message: error instanceof Error ? error.message : "Unable to queue article.",
    });
  }
});

router.post("/reindex-all", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const articles = await prisma.chatbotKnowledgeArticle.findMany({
      where: { institutionId, status: "PUBLISHED" },
      select: { id: true },
      take: 500,
    });

    let queued = 0;

    for (const article of articles) {
      await enqueueKnowledgeIndexing({
        institutionId,
        articleId: article.id,
        requestedById: actorId,
      });
      queued++;
    }

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "INDEXING_REQUESTED",
      targetType: "KNOWLEDGE_LIBRARY",
      details: { queued, maximumBatch: 500 },
    });

    return res.status(202).json({
      message: "Bulk indexing request accepted.",
      queued,
      limit: 500,
    });
  } catch (error) {
    console.error("Bulk indexing request failed:", error);
    return res.status(500).json({ message: "Unable to queue bulk indexing." });
  }
});

router.post("/jobs/:jobId/retry", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const job = await prisma.aIKnowledgeIndexJob.findFirst({
      where: {
        id: req.params.jobId,
        institutionId,
        status: "FAILED",
      },
    });

    if (!job) {
      return res.status(404).json({ message: "Failed indexing job not found." });
    }

    const nextJob = await enqueueKnowledgeIndexing({
      institutionId,
      articleId: job.articleId,
      requestedById: actorId,
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "INDEXING_REQUESTED",
      targetType: "INDEXING_JOB",
      targetId: job.id,
      details: { replacementJobId: nextJob.id },
    });

    return res.status(202).json({ job: nextJob });
  } catch (error) {
    return res.status(400).json({
      message: error instanceof Error ? error.message : "Unable to retry indexing.",
    });
  }
});

router.post("/jobs/:jobId/cancel", async (req, res) => {
  try {
    const { institutionId, actorId } = getScope(req);

    const job = await cancelKnowledgeIndexing({
      institutionId,
      jobId: req.params.jobId,
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "INDEXING_REQUESTED",
      targetType: "INDEXING_JOB",
      targetId: job.id,
      details: { cancelled: true },
    });

    return res.json({ job });
  } catch (error) {
    return res.status(400).json({
      message: error instanceof Error ? error.message : "Unable to cancel job.",
    });
  }
});

export default router;

```

Mount:

```
import aiIndexingAdminRoutes from "./routes/aiIndexingAdmin";

app.use("/api/ai-admin/indexing", aiIndexingAdminRoutes);
```

Bulk indexing note: This endpoint deliberately limits each request to 500 articles. For a large knowledge library, replace the loop with a database-backed bulk enqueue operation and pagination. Also add rate limiting to administrative bulk actions.

## 5. Prompt version history and rollback

The prompt manager from Module 40 can publish new versions. Now it needs a permanent history record and a rollback operation.

Update `apps/api/src/routes/aiPrompts.ts`.

When creating a prompt, after creating the prompt record, add:

```
await prisma.aIPromptVersionHistory.create({
  data: {
    institutionId,
    promptId: prompt.id,
    promptName: prompt.name,
    version: prompt.version,
    action: "CREATED",
    changedById: actorId,
    snapshot: {
      name: prompt.name,
      description: prompt.description,
      content: prompt.content,
      version: prompt.version,
      status: prompt.status,
    },
  },
});
```

When publishing, record the publication:

```
await prisma.aIPromptVersionHistory.create({
  data: {
    institutionId,
    promptId: published.id,
    promptName: published.name,
    version: published.version,
    action: "PUBLISHED",
    changedById: actorId,
    snapshot: {
      name: published.name,
      description: published.description,
      content: published.content,
      version: published.version,
      status: published.status,
    },
  },
});
```

Add the following endpoints to the same router:

```

router.get("/:id/history", async (req, res) => {
  try {
    const { institutionId } = getScope(req);

    const prompt = await prisma.aIPromptTemplate.findFirst({
      where: { id: req.params.id, institutionId },
      select: { id: true, name: true },
    });

    if (!prompt) {
      return res.status(404).json({ message: "Prompt not found." });
    }

    const history = await prisma.aIPromptVersionHistory.findMany({
      where: {
        institutionId,
        promptName: prompt.name,
      },
      orderBy: { createdAt: "desc" },
      take: 100,
    });

    return res.json({ history });
  } catch {
    return res.status(500).json({ message: "Unable to load prompt history." });
  }
});

router.post("/:id/rollback", async (req, res) => {
  const schema = z.object({
    version: z.number().int().positive(),
  });

  const parsed = schema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({ message: "A valid version is required." });
  }

  try {
    const { institutionId, actorId } = getScope(req);

    const source = await prisma.aIPromptTemplate.findFirst({
      where: {
        id: req.params.id,
        institutionId,
        version: parsed.data.version,
      },
    });

    if (!source) {
      return res.status(404).json({ message: "Source prompt version not found." });
    }

    const latest = await prisma.aIPromptTemplate.findFirst({
      where: { institutionId, name: source.name },
      orderBy: { version: "desc" },
      select: { version: true },
    });

    const nextVersion = (latest?.version ?? 0) + 1;

    const rolledBack = await prisma.$transaction(async (tx) => {
      await tx.aIPromptTemplate.updateMany({
        where: {
          institutionId,
          name: source.name,
          status: "PUBLISHED",
        },
        data: { status: "ARCHIVED" },
      });

      const created = await tx.aIPromptTemplate.create({
        data: {
          institutionId,
          name: source.name,
          description: source.description,
          content: source.content,
          version: nextVersion,
          status: "PUBLISHED",
          createdById: actorId,
          publishedById: actorId,
          publishedAt: new Date(),
        },
      });

      await tx.aIPromptVersionHistory.create({
        data: {
          institutionId,
          promptId: created.id,
          promptName: created.name,
          version: created.version,
          action: "ROLLED_BACK",
          changedById: actorId,
          snapshot: {
            name: created.name,
            description: created.description,
            content: created.content,
            version: created.version,
            restoredFromVersion: source.version,
            status: created.status,
          },
        },
      });

      return created;
    });

    await recordGovernanceAudit({
      institutionId,
      actorId,
      action: "CONFIG_UPDATED",
      targetType: "AI_PROMPT",
      targetId: rolledBack.id,
      details: {
        name: rolledBack.name,
        restoredFromVersion: source.version,
        newVersion: rolledBack.version,
      },
    });

    return res.status(201).json({ prompt: rolledBack });
  } catch (error) {
    console.error("Prompt rollback failed:", error);
    return res.status(500).json({ message: "Unable to roll back prompt." });
  }
});

```

The rollback creates a new version rather than modifying an old one. That preserves the history of what was previously published.

## 6. Audit log filters and export

Create `apps/api/src/routes/aiAuditAdmin.ts`.

```

import { Router } from "express";
import { z } from "zod";
import { prisma } from "../lib/prisma";
import { requireAuth } from "../middleware/requireAuth";
import { allowRoles } from "../middleware/allowRoles";

const router = Router();

router.use(requireAuth);
router.use(allowRoles("SUPER_ADMIN"));

router.get("/", async (req, res) => {
  try {
    const institutionId = req.user?.institutionId;

    if (!institutionId) {
      return res.status(400).json({ message: "Institution scope is required." });
    }

    const filters = z.object({
      action: z.string().optional(),
      targetType: z.string().optional(),
      from: z.string().datetime().optional(),
      to: z.string().datetime().optional(),
      limit: z.coerce.number().int().min(1).max(200).default(50),
      cursor: z.string().optional(),
    }).safeParse(req.query);

    if (!filters.success) {
      return res.status(400).json({ message: "Invalid audit filters." });
    }

    const { action, targetType, from, to, limit, cursor } = filters.data;

    const records = await prisma.aIGovernanceAudit.findMany({
      where: {
        institutionId,
        ...(action ? { action: action as any } : {}),
        ...(targetType ? { targetType } : {}),
        ...(from || to
          ? {
              createdAt: {
                ...(from ? { gte: new Date(from) } : {}),
                ...(to ? { lte: new Date(to) } : {}),
              },
            }
          : {}),
      },
      orderBy: [{ createdAt: "desc" }, { id: "desc" }],
      take: limit + 1,
      ...(cursor ? { cursor: { id: cursor }, skip: 1 } : {}),
    });

    const hasMore = records.length > limit;
    const page = hasMore ? records.slice(0, limit) : records;

    return res.json({
      records: page,
      nextCursor: hasMore ? page[page.length - 1]?.id ?? null : null,
    });
  } catch (error) {
    console.error("AI audit query failed:", error);
    return res.status(500).json({ message: "Unable to load AI audit records." });
  }
});

router.get("/export.csv", async (req, res) => {
  try {
    const institutionId = req.user?.institutionId;

    if (!institutionId) {
      return res.status(400).json({ message: "Institution scope is required." });
    }

    const records = await prisma.aIGovernanceAudit.findMany({
      where: { institutionId },
      orderBy: { createdAt: "desc" },
      take: 5000,
    });

    const cell = (value: unknown) => {
      let text = value == null ? "" : String(value);

      // Protect spreadsheet users from CSV formula injection.
      if (/^[\s]*[=+\-@]/.test(text)) text = `'${text}`;

      return `"${text.replace(/"/g, '""')}"`;
    };

    const rows = [
      ["Date", "Actor", "Action", "Target Type", "Target ID", "Details"],
      ...records.map((record) => [
        record.createdAt.toISOString(),
        record.actorId ?? "",
        record.action,
        record.targetType,
        record.targetId ?? "",
        JSON.stringify(record.details ?? {}),
      ]),
    ];

    const csv = rows.map((row) => row.map(cell).join(",")).join("\r\n");

    res.setHeader("Content-Type", "text/csv; charset=utf-8");
    res.setHeader(
      "Content-Disposition",
      'attachment; filename="ai-governance-audit.csv"'
    );

    return res.send("\uFEFF" + csv);
  } catch (error) {
    console.error("AI audit export failed:", error);
    return res.status(500).json({ message: "Unable to export AI audit records." });
  }
});

export default router;

```

Mount:

```
import aiAuditAdminRoutes from "./routes/aiAuditAdmin";

app.use("/api/ai-admin/audit", aiAuditAdminRoutes);
```

The audit export is limited to the latest 5,000 records. For larger datasets, use date filters and paginated export jobs. Audit records should be append-only: do not provide ordinary administrators with update or delete endpoints.

## 7. AI usage and feedback performance reports

Create `apps/api/src/routes/aiPerformanceAdmin.ts`.

This endpoint reports token consumption by role, model and operation, alongside feedback ratings. It does not treat thumbs-up ratings as a definitive measure of answer correctness.

```

import { Router } from "express";
import { z } from "zod";
import { prisma } from "../lib/prisma";
import { requireAuth } from "../middleware/requireAuth";
import { allowRoles } from "../middleware/allowRoles";

const router = Router();

router.use(requireAuth);
router.use(allowRoles("SUPER_ADMIN"));

router.get("/", async (req, res) => {
  try {
    const institutionId = req.user?.institutionId;

    if (!institutionId) {
      return res.status(400).json({ message: "Institution scope is required." });
    }

    const parsed = z.object({
      days: z.coerce.number().int().min(7).max(365).default(30),
    }).safeParse(req.query);

    if (!parsed.success) {
      return res.status(400).json({ message: "Invalid reporting period." });
    }

    const from = new Date();
    from.setDate(from.getDate() - parsed.data.days);

    const usageWhere = {
      institutionId,
      createdAt: { gte: from },
    };

    const [
      byRole,
      byModel,
      byOperation,
      feedback,
      usage,
    ] = await Promise.all([
      prisma.aIUsageRecord.groupBy({
        by: ["userRole"],
        where: usageWhere,
        _sum: { totalTokens: true, estimatedCost: true },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.groupBy({
        by: ["providerKey", "model"],
        where: usageWhere,
        _sum: { totalTokens: true, estimatedCost: true },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.groupBy({
        by: ["operation"],
        where: usageWhere,
        _sum: { totalTokens: true },
        _count: { _all: true },
      }),
      prisma.chatbotAnswerFeedback.groupBy({
        by: ["rating"],
        where: {
          institutionId,
          createdAt: { gte: from },
        },
        _count: { _all: true },
      }),
      prisma.aIUsageRecord.aggregate({
        where: usageWhere,
        _sum: {
          inputTokens: true,
          outputTokens: true,
          totalTokens: true,
          estimatedCost: true,
        },
        _count: { _all: true },
      }),
    ]);

    return res.json({
      period: { from, days: parsed.data.days },
      totals: {
        requests: usage._count._all,
        inputTokens: usage._sum.inputTokens ?? 0,
        outputTokens: usage._sum.outputTokens ?? 0,
        totalTokens: usage._sum.totalTokens ?? 0,
        estimatedCost: Number(usage._sum.estimatedCost ?? 0),
      },
      byRole,
      byModel,
      byOperation,
      feedback: feedback.map((item) => ({
        rating: item.rating,
        count: item._count._all,
      })),
    });
  } catch (error) {
    console.error("AI performance report failed:", error);
    return res.status(500).json({ message: "Unable to load AI performance reports." });
  }
});

export default router;

