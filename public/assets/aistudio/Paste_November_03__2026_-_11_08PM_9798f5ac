import { useEffect, useState } from "react";

type IndexJob = {
  id: string;
  articleId: string;
  status: "PENDING" | "PROCESSING" | "INDEXED" | "FAILED" | "CANCELLED";
  attempts: number;
  maxAttempts: number;
  lastError?: string | null;
  embeddingModel?: string | null;
  createdAt: string;
  article?: {
    question: string;
    category: string;
  } | null;
};

const API = "/api/ai-admin/indexing";

async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`${API}${path}`, {
    ...options,
    credentials: "include",
    headers: {
      "Content-Type": "application/json",
      ...options.headers,
    },
  });

  const result = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(result.message || "Indexing request failed.");
  }

  return result as T;
}

export default function AIIndexingPage() {
  const [jobs, setJobs] = useState<IndexJob[]>([]);
  const [status, setStatus] = useState("ALL");
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  async function loadJobs() {
    setLoading(true);
    setError("");

    try {
      const query = status === "ALL" ? "" : `?status=${status}`;
      const result = await request<{ jobs: IndexJob[] }>(`/jobs${query}`);
      setJobs(result.jobs);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to load indexing jobs.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadJobs();
  }, [status]);

  async function runAction(path: string, successMessage: string) {
    setBusy(true);
    setError("");
    setNotice("");

    try {
      await request(path, {
        method: "POST",
        body: JSON.stringify({}),
      });
      setNotice(successMessage);
      await loadJobs();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Action failed.");
    } finally {
      setBusy(false);
    }
  }

  const counts = {
    pending: jobs.filter((job) => job.status === "PENDING").length,
    processing: jobs.filter((job) => job.status === "PROCESSING").length,
    indexed: jobs.filter((job) => job.status === "INDEXED").length,
    failed: jobs.filter((job) => job.status === "FAILED").length,
  };

  return (
    <main className="ai-admin-page">
      <header className="ai-admin-header">
        <div>
          <span>HI-TECH COLLEGE · KNOWLEDGE INTELLIGENCE</span>
          <h1>Knowledge Indexing</h1>
          <p>Monitor article embeddings and manage failed indexing jobs.</p>
        </div>

        <button
          className="ai-button ai-button-outline"
          onClick={() => void loadJobs()}
          disabled={loading || busy}
        >
          Refresh queue
        </button>
      </header>

      {error && <div className="ai-alert ai-alert-error">{error}</div>}
      {notice && <div className="ai-alert ai-alert-success">{notice}</div>}

      <section className="ai-usage-grid ai-indexing-stats">
        <article><span>Pending</span><strong>{counts.pending}</strong></article>
        <article><span>Processing</span><strong>{counts.processing}</strong></article>
        <article><span>Indexed</span><strong>{counts.indexed}</strong></article>
        <article><span>Failed</span><strong>{counts.failed}</strong></article>
      </section>

      <section className="ai-admin-panel">
        <div className="ai-section-heading">
          <div>
            <h2>Queue management</h2>
            <p>Bulk indexing is limited to 500 published articles per request.</p>
          </div>

          <button
            className="ai-button"
            disabled={busy}
            onClick={() => {
              if (window.confirm("Queue up to 500 published articles for re-indexing?")) {
                void runAction("/reindex-all", "Bulk re-index request submitted.");
              }
            }}
          >
            Re-index published articles
          </button>
        </div>

        <label>
          Filter jobs
          <select value={status} onChange={(e) => setStatus(e.target.value)}>
            <option value="ALL">All jobs</option>
            <option value="PENDING">Pending</option>
            <option value="PROCESSING">Processing</option>
            <option value="INDEXED">Indexed</option>
            <option value="FAILED">Failed</option>
            <option value="CANCELLED">Cancelled</option>
          </select>
        </label>
      </section>

      <section className="ai-admin-panel">
        <h2>Indexing jobs</h2>

        {loading ? (
          <p>Loading indexing jobs...</p>
        ) : jobs.length === 0 ? (
          <p>No indexing jobs found for this filter.</p>
        ) : (
          <div className="ai-indexing-list">
            {jobs.map((job) => (
              <article className="ai-indexing-job" key={job.id}>
                <div className="ai-indexing-job-heading">
                  <div>
                    <strong>{job.article?.question ?? job.articleId}</strong>
                    <p>{job.article?.category ?? "Article unavailable"}</p>
                  </div>
                  <span className={`ai-status ai-status-${job.status.toLowerCase()}`}>
                    {job.status}
                  </span>
                </div>

                <div className="ai-indexing-meta">
                  <span>Attempts: {job.attempts}/{job.maxAttempts}</span>
                  <span>Model: {job.embeddingModel ?? "Not recorded"}</span>
                  <span>{new Date(job.createdAt).toLocaleString()}</span>
                </div>

                {job.lastError && (
                  <p className="ai-indexing-error">{job.lastError}</p>
                )}

                <div className="ai-indexing-actions">
                  {job.status === "FAILED" && (
                    <button
                      className="ai-button ai-button-outline"
                      disabled={busy}
                      onClick={() =>
                        void runAction(
                          `/jobs/${job.id}/retry`,
                          "Retry job submitted."
                        )
                      }
                    >
                      Retry
                    </button>
                  )}

                  {job.status === "PENDING" && (
                    <button
                      className="ai-button ai-button-outline"
                      disabled={busy}
                      onClick={() =>
                        void runAction(
                          `/jobs/${job.id}/cancel`,
                          "Pending job cancelled."
                        )
                      }
                    >
                      Cancel
                    </button>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </main>
  );
}

