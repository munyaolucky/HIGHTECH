import { useEffect, useState } from "react";

type AuditRecord = {
  id: string;
  actorId?: string | null;
  action: string;
  targetType: string;
  targetId?: string | null;
  details?: unknown;
  createdAt: string;
};

export default function AIAuditPage() {
  const [records, setRecords] = useState<AuditRecord[]>([]);
  const [action, setAction] = useState("");
  const [targetType, setTargetType] = useState("");
  const [from, setFrom] = useState("");
  const [to, setTo] = useState("");
  const [cursor, setCursor] = useState<string | null>(null);
  const [nextCursor, setNextCursor] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  async function loadAudit(next = false) {
    setLoading(true);
    setError("");

    const params = new URLSearchParams({ limit: "50" });

    if (action) params.set("action", action);
    if (targetType) params.set("targetType", targetType);
    if (from) params.set("from", new Date(from).toISOString());
    if (to) params.set("to", new Date(to).toISOString());

    const activeCursor = next ? nextCursor : null;
    if (activeCursor) params.set("cursor", activeCursor);

    try {
      const response = await fetch(
        `/api/ai-admin/audit?${params.toString()}`,
        { credentials: "include" }
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || "Unable to load audit records.");
      }

      setRecords(result.records);
      setCursor(activeCursor);
      setNextCursor(result.nextCursor);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Audit request failed.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadAudit(false);
  }, []);

  function applyFilters() {
    setCursor(null);
    setNextCursor(null);
    void loadAudit(false);
  }

  return (
    <main className="ai-admin-page">
      <header className="ai-admin-header">
        <div>
          <span>HI-TECH COLLEGE · SECURITY & COMPLIANCE</span>
          <h1>AI Governance Audit</h1>
