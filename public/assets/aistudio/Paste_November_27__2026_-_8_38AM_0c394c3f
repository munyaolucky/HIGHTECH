Correct the preview fallback in src/modules/student/fees/feesApi.ts
The current fetchJsonOrFallback() silently returns preview data on HTTP 401, HTTP 403 and network errors.
Replace its implementation with:
Code
function isExplicitPreviewMode(): boolean {
  if (typeof window === 'undefined') return false;

  return (
    new URLSearchParams(window.location.search)
      .get('preview') === '1'
  );
}

async function fetchJsonOrFallback<T>(
  url: string,
  options: RequestInit | undefined,
  fallback: () => T
): Promise<{ data: T; source: 'server' | 'preview' }> {
  const previewAllowed = isExplicitPreviewMode();

  if (typeof fetch !== 'function') {
    if (previewAllowed) {
      return {
        data: fallback(),
        source: 'preview',
      };
    }

    throw new Error('The financial service is unavailable.');
  }

  try {
    const res = await fetch(url, {
      credentials: 'include',
      ...options,
      headers: {
        'Content-Type': 'application/json',
        ...(options?.headers ?? {}),
      },
    });

    const payload = (await res.json().catch(() => ({}))) as {
      success?: boolean;
      data?: T;
      error?: string;
    };

    if (res.status === 401 || res.status === 403) {
      if (previewAllowed) {
        return {
          data: fallback(),
          source: 'preview',
        };
      }

      throw new Error(
        res.status === 401
          ? 'Please sign in to access your financial records.'
          : 'You are not authorized to access these financial records.'
      );
    }

    if (!res.ok || !payload.success || payload.data === undefined) {
      throw new Error(
        payload.error ||
          `Financial request failed with HTTP ${res.status}.`
      );
    }

    return {
      data: payload.data,
      source: 'server',
    };
  } catch (error) {
    if (error instanceof TypeError && previewAllowed) {
      return {
        data: fallback(),
        source: 'preview',
      };
    }

    throw error;
  }
}
Preview mode must be visibly labelled and must never be used for actual payment submission or reconciliation.
