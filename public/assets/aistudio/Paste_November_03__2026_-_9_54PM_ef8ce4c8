  background: transparent;
  border: 0;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

/* FEE SUMMARY */

.hca-fee-balance {
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  border-radius: 8px;
  background: linear-gradient(110deg, #edf5ff, #f7faff);
}

.hca-fee-balance small {
  color: #5d718c;
  font-size: 10px;
  font-weight: 600;
}

.hca-fee-balance strong {
  color: #103c76;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.8px;
}

.hca-fee-balance span {
  color: #8593a7;
  font-size: 9px;
}

.hca-fee-progress {
  margin: 14px 0;
}

.hca-fee-progress-label {
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  color: #65758c;
  font-size: 10px;
}

.hca-fee-progress-label strong {
  color: #087d50;
}

.hca-progress-track {
  height: 8px;
  overflow: hidden;
  border-radius: 20px;
  background: #e9eef5;
}

.hca-progress-value {
  width: 75%;
  height: 100%;
  border-radius: 20px;
  background: linear-gradient(90deg, #07975d, #35c58b);
}

.hca-pay-button {
  width: 100%;
  min-height: 42px;
  padding: 0 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  color: #fff;
  background: #0963c6;
  border: 0;
  border-radius: 7px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.hca-pay-button:hover {
  background: #064d9d;
}

.hca-pay-button svg:last-child {
  margin-left: auto;
}

/* PROMOTIONAL BANNER */

.hca-promo-banner {
  min-height: 175px;
  padding: 19px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-radius: 9px;
  color: #fff;
  background-color: #073b83;
  background-image:
    linear-gradient(90deg, rgba(4, 40, 104, 0.97) 0%, rgba(5, 62, 133, 0.84) 52%, rgba(4, 45, 100, 0.1) 100%),
    url("https://images.unsplash.com/photo-1498243691581-b145c3f54a5a?auto=format&fit=crop&w=900&q=80");
  background-size: cover;
  background-position: center;
}

.hca-promo-content {
  position: relative;
  z-index: 1;
}

.hca-promo-content > span {
  color: #ffd04a;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.hca-promo-content h3 {
  margin: 8px 0;
  color: #fff;
  font-size: 19px;
  line-height: 1.25;
  font-weight: 800;
}

.hca-promo-content h3 b {
  color: #ffd12d;
}

.hca-promo-content p {
  margin: 0 0 12px;
  color: #e7f1ff;
  font-size: 9px;
}

.hca-promo-content button {
  min-height: 32px;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #092d60;
  background: #ffc400;
  border: 0;
  border-radius: 6px;
  font-family: inherit;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
}

/* SUPPORT CARD */

.hca-support-card {
  padding: 14px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #fff;
  border: 1px solid var(--hca-border);
  border-radius: 9px;
}

.hca-support-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #e8f2ff;
  color: #075fc2;
}

.hca-support-card strong {
  font-size: 11px;
}

.hca-support-card p {
  margin: 5px 0 7px;
  color: var(--hca-muted);
  font-size: 9px;
}

.hca-support-card button {
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #0864c9;
  background: transparent;
  border: 0;
  font-family: inherit;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
}

/* FOOTER */

.hca-footer {
  margin-top: 20px;
  padding: 17px 4px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-top: 1px solid #dfe8f3;
  color: #718198;
}

.hca-footer > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hca-footer > div:first-child strong {
  color: var(--hca-navy);
  font-size: 10px;
}

.hca-footer > div:first-child span,
.hca-footer p {
  font-size: 9px;
}

.hca-footer p {
  margin: 0;
}

.hca-footer-links {
  display: flex;
  gap: 13px;
}

.hca-footer-links button {
  padding: 0;
  color: #526985;
  background: transparent;
  border: 0;
  font-family: inherit;
  font-size: 9px;
  cursor: pointer;
}

/* MOBILE OVERLAY */

.hca-sidebar-overlay {
  display: none;
}

/* RESPONSIVE */

@media (max-width: 1250px) {
  .hca-quick-actions {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hca-content-grid {
    grid-template-columns: minmax(0, 1.4fr) minmax(270px, 1fr);
  }

  .hca-event-row {
    grid-template-columns: 50px minmax(100px, 1fr) minmax(90px, 0.6fr);
  }

  .hca-event-location {
    display: none;
  }
}

@media (max-width: 900px) {
  .hca-sidebar {
    position: fixed;
    top: 78px;
    left: 0;
    z-index: 80;
    height: calc(100vh - 78px);
    transform: translateX(-105%);
    transition: transform 0.25s ease;
  }

  .hca-sidebar.open {
    transform: translateX(0);
  }

  .hca-sidebar-overlay {
    position: fixed;
    inset: 78px 0 0;
    z-index: 70;
    display: block;
    background: rgba(4, 19, 42, 0.48);
    border: 0;
  }

  .hca-mobile-menu {
    display: grid;
    place-items: center;
  }

  .hca-brand {
    min-width: 0;
    margin-right: auto;
  }

  .hca-header-right {
    gap: 10px;
  }

  .hca-search {
    width: 170px;
  }

  .hca-content-grid {
    grid-template-columns: 1fr;
  }

  .hca-right-column {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .hca-notifications-panel {
    grid-row: span 2;
  }
}

@media (max-width: 600px) {
  .hca-topbar {
    height: 66px;
    padding: 0 12px;
    gap: 8px;
  }

  .hca-brand {
    gap: 6px;
  }

  .hca-brand-icon {
    width: 37px;
    height: 40px;
  }

  .hca-brand-icon svg {
    width: 31px;
  }

  .hca-brand h1 {
    font-size: 14px;
  }

  .hca-brand p {
    font-size: 9px;
  }

  .hca-mobile-menu {
    order: 3;
    width: 34px;
    height: 38px;
  }

  .hca-header-right {
    margin-left: auto;
  }

  .hca-search {
    display: none;
  }

  .hca-profile-info {
    display: none;
  }

  .hca-profile-button {
    gap: 3px;
  }

  .hca-avatar {
    width: 34px;
    height: 34px;
  }

  .hca-profile-button > svg {
    width: 13px;
  }

  .hca-dropdown {
    position: fixed;
    top: 60px;
    right: 8px;
    width: min(340px, calc(100vw - 16px));
  }

  .hca-profile-dropdown {
    width: 210px;
  }

  .hca-layout {
    min-height: calc(100vh - 66px);
  }

  .hca-sidebar {
    top: 66px;
    height: calc(100vh - 66px);
    width: 265px;
  }

  .hca-sidebar-overlay {
    inset: 66px 0 0;
  }

  .hca-main {
    padding: 0 12px 20px;
  }

  .hca-hero {
    min-height: 260px;
    margin: 0 -12px;
    padding: 27px 20px;
    background-position: center;
  }

  .hca-hero h2 {
    font-size: 34px;
  }

  .hca-hero-content p {
    font-size: 13px;
  }

  .hca-hero-button {
    min-height: 40px;
    font-size: 10px;
  }

  .hca-hero-tag {
    right: 13px;
    bottom: 10px;
    font-size: 8px;
  }

  .hca-quick-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    margin-top: 12px;
  }

  .hca-quick-card {
    min-height: 66px;
    padding: 9px;
  }

  .hca-quick-icon {
    width: 31px;
  }

  .hca-quick-icon svg {
    width: 24px;
  }

  .hca-quick-text strong {
    font-size: 10px;
  }

  .hca-quick-text small {
    font-size: 8px;
  }

  .hca-content-grid {
    gap: 12px;
  }

  .hca-left-column,
  .hca-right-column {
    gap: 12px;
  }

  .hca-right-column {
    display: flex;
  }

  .hca-panel {
    padding: 11px;
  }

  .hca-panel-title h3 {
    font-size: 12px;
  }

  .hca-panel-title svg {
    width: 19px;
  }

  .hca-text-link {
    font-size: 9px;
  }

  .hca-academic-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .hca-stat-card {
    min-height: 65px;
    padding: 9px;
    gap: 8px;
  }

  .hca-stat-card > svg {
    width: 27px;
    height: 27px;
  }

  .hca-stat-card small {
    font-size: 8px;
  }

  .hca-stat-card strong {
    font-size: 10px;
  }

  .hca-event-row {
    grid-template-columns: 45px minmax(0, 1fr);
    gap: 8px;
    padding: 9px 0;
  }

  .hca-event-name strong {
    font-size: 9px;
  }

  .hca-event-time {
    grid-column: 2;
    font-size: 8px;
  }

  .hca-event-location {
    display: none;
  }

  .hca-shortcuts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hca-shortcuts button {
    min-height: 65px;
  }

  .hca-notification-row {
    gap: 8px;
  }

  .hca-notification-message strong {
    font-size: 9px;
  }

  .hca-notification-time {
    font-size: 8px;
  }

  .hca-promo-banner {
    min-height: 160px;
  }

  .hca-footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
  }

  .hca-footer p {
    order: 3;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hca-dashboard *,
  .hca-dashboard *::before,
  .hca-dashboard *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

4. Add the dashboard to your application
For example, in src/App.tsx:

import StudentDashboard from "./modules/student/StudentDashboard";

function App() {
  return (
    <StudentDashboard
      studentName="Amina Wanjiku"
      registrationNumber="HCA/STU/2026/001"
      programme="BSc. Computer Science"
      academicYear="2026"
      semester="Semester 1"
      registeredCourses={6}
      attendance={95}
      gpa={3.75}
      onNavigate={(page) => {
        console.log("Navigate to:", page);
      }}
      onLogout={() => {
        window.location.href = "/login";
      }}
    />
  );
}

export default App;

