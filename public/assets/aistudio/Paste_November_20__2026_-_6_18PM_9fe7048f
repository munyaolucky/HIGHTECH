## **3. Browser security event handling**

**Path:** `apps/web/src/modules/student/exams/secure/examSecurity.ts`

This module blocks common clipboard actions inside the exam page and records focus/fullscreen events. It does not pretend to block operating-system-level application switching.

```

import type {
  ExamSecurityEvent,
  SecurityEventType,
} from "./examTypes";

type SecurityOptions = {
  onEvent: (event: ExamSecurityEvent) => void;
  blockClipboard?: boolean;
  blockContextMenu?: boolean;
  blockShortcuts?: boolean;
};

export function installExamSecurity({
  onEvent,
  blockClipboard = true,
  blockContextMenu = true,
  blockShortcuts = true,
}: SecurityOptions) {
  const report = (
    type: SecurityEventType,
    details?: string
  ) => {
    onEvent({
      type,
      occurredAt: new Date().toISOString(),
      details,
    });
  };

  const prevent = (
    event: Event,
    type: SecurityEventType,
    details?: string
  ) => {
    event.preventDefault();
    report(type, details);
  };

  const handleCopy = (event: ClipboardEvent) => {
    if (blockClipboard) {
      prevent(event, "COPY_ATTEMPT");
    }
  };

  const handlePaste = (event: ClipboardEvent) => {
    if (blockClipboard) {
      prevent(event, "PASTE_ATTEMPT");
    }
  };

  const handleCut = (event: ClipboardEvent) => {
    if (blockClipboard) {
      prevent(event, "CUT_ATTEMPT");
    }
  };

  const handleContextMenu = (event: MouseEvent) => {
    if (blockContextMenu) {
      prevent(event, "CONTEXT_MENU");
    }
  };

  const handleKeyDown = (event: KeyboardEvent) => {
    if (!blockShortcuts) return;

    const key = event.key.toLowerCase();
    const modifier = event.ctrlKey || event.metaKey;

    const blocked =
      (modifier && ["c", "v", "x", "p", "s", "u"].includes(key)) ||
      event.key === "F12" ||
      (event.altKey && event.key === "Tab");

    if (blocked) {
      prevent(
        event,
        "PROHIBITED_SHORTCUT",
        `Key: ${event.key}`
      );
    }
  };

  const handleVisibility = () => {
    if (document.visibilityState === "hidden") {
      report("TAB_HIDDEN");
    }
  };

  const handleBlur = () => {
    report("WINDOW_BLUR");
  };

  const handleFullscreen = () => {
    if (!document.fullscreenElement) {
      report("FULLSCREEN_EXIT");
    }
  };

  const handleDragStart = (event: DragEvent) => {
    prevent(event, "DRAG_ATTEMPT");
  };

  document.addEventListener("copy", handleCopy);
  document.addEventListener("paste", handlePaste);
  document.addEventListener("cut", handleCut);
  document.addEventListener("contextmenu", handleContextMenu);
  document.addEventListener("keydown", handleKeyDown);
  document.addEventListener("visibilitychange", handleVisibility);
  document.addEventListener("dragstart", handleDragStart);
  document.addEventListener("fullscreenchange", handleFullscreen);
  window.addEventListener("blur", handleBlur);

  return () => {
    document.removeEventListener("copy", handleCopy);
    document.removeEventListener("paste", handlePaste);
    document.removeEventListener("cut", handleCut);
    document.removeEventListener("contextmenu", handleContextMenu);
    document.removeEventListener("keydown", handleKeyDown);
    document.removeEventListener("visibilitychange", handleVisibility);
    document.removeEventListener("dragstart", handleDragStart);
    document.removeEventListener("fullscreenchange", handleFullscreen);
    window.removeEventListener("blur", handleBlur);
  };
}

export async function enterExamFullscreen(): Promise<boolean> {
  try {
    if (!document.fullscreenElement) {
      await document.documentElement.requestFullscreen();
    }

    return Boolean(document.fullscreenElement);
  } catch {
    return false;
  }
}

export async function exitExamFullscreen(): Promise<void> {
  if (document.fullscreenElement) {
    await document.exitFullscreen();
  }
}

```

## **4. Exam session hook**

**Path:** `apps/web/src/modules/student/exams/secure/useExamSession.ts`

This hook keeps answers in React state, saves them to the API, and maintains a local recovery copy. The server must remain authoritative for the actual start time and expiry time.

```

import { useCallback, useEffect, useRef, useState } from "react";
import type {
  ExamAnswer,
  ExamAnswerValue,
  ExamSession,
  ExamSecurityEvent,
} from "./examTypes";

const API = "/api/student/exam-sessions";

type SaveState = "saved" | "saving" | "offline" | "error";

export function useExamSession(initialSession: ExamSession) {
  const [session, setSession] = useState(initialSession);
  const [answers, setAnswers] = useState<ExamAnswer[]>(
    initialSession.answers ?? []
  );
  const [saveState, setSaveState] = useState<SaveState>("saved");
  const [remainingSeconds, setRemainingSeconds] = useState(0);

  const saveTimer = useRef<number | undefined>(undefined);
  const latestAnswers = useRef(answers);

  useEffect(() => {
    latestAnswers.current = answers;
  }, [answers]);

  useEffect(() => {
    if (!session.expiresAt || session.status !== "active") return;

    const updateTime = () => {
      const remaining = Math.max(
        0,
        Math.floor(
          (new Date(session.expiresAt!).getTime() - Date.now()) / 1000
        )
      );

      setRemainingSeconds(remaining);

      if (remaining === 0) {
        setSession((current) => ({
          ...current,
          status: "expired",
        }));
      }
    };

    updateTime();
    const interval = window.setInterval(updateTime, 1000);

    return () => window.clearInterval(interval);
  }, [session.expiresAt, session.status]);

  const persistAnswers = useCallback(async () => {
    if (session.status !== "active") return;

    setSaveState("saving");

    try {
      const response = await fetch(
        `${API}/${session.id}/answers`,
        {
          method: "PUT",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            answers: latestAnswers.current,
          }),
        }
      );

      if (!response.ok) {
        throw new Error("Answer save failed");
      }

      setSaveState("saved");
      localStorage.removeItem(`exam-recovery-${session.id}`);
    } catch {
      setSaveState(navigator.onLine ? "error" : "offline");

      localStorage.setItem(
        `exam-recovery-${session.id}`,
        JSON.stringify(latestAnswers.current)
      );
    }
  }, [session.id, session.status]);

  const updateAnswer = useCallback(
    (questionId: string, value: ExamAnswerValue) => {
      if (session.status !== "active") return;

      setAnswers((current) => {
        const next = [...current];
        const index = next.findIndex(
          (answer) => answer.questionId === questionId
        );

        const answer: ExamAnswer = {
          questionId,
          value,
          updatedAt: new Date().toISOString(),
        };

        if (index >= 0) next[index] = answer;
        else next.push(answer);

        latestAnswers.current = next;
        return next;
      });

      if (saveTimer.current) {
        window.clearTimeout(saveTimer.current);
      }

      saveTimer.current = window.setTimeout(
        () => void persistAnswers(),
        800
      );
    },
    [persistAnswers, session.status]
  );

  const recordSecurityEvent = useCallback(
    async (event: ExamSecurityEvent) => {
      try {
        await fetch(`${API}/${session.id}/security-events`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(event),
        });
      } catch {
        // Do not discard the event if temporarily offline.
        const key = `exam-events-${session.id}`;
        const existing = JSON.parse(
          localStorage.getItem(key) || "[]"
        ) as ExamSecurityEvent[];

        localStorage.setItem(
          key,
          JSON.stringify([...existing, event])
        );
      }
    },
    [session.id]
  );

  const submitExam = useCallback(async () => {
    await persistAnswers();

    const response = await fetch(`${API}/${session.id}/submit`, {
      method: "POST",
      credentials: "include",
    });

    if (!response.ok) {
      throw new Error("The exam could not be submitted.");
    }

    setSession((current) => ({
      ...current,
      status: "submitted",
    }));
  }, [persistAnswers, session.id]);

  useEffect(() => {
    return () => {
      if (saveTimer.current) {
        window.clearTimeout(saveTimer.current);
      }
    };
  }, []);

  return {
    session,
    answers,
    saveState,
    remainingSeconds,
    updateAnswer,
    recordSecurityEvent,
    persistAnswers,
    submitExam,
  };
}

```

**Integration note:** The example uses a cookie-authenticated API contract. Adapt the URL, authentication and response schema to the existing HI-TECH API before using it. A local recovery copy is not proof that the server received an answer; reconcile it with the server when the connection returns.

