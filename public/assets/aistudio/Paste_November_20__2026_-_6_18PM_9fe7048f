```

import type { ReactNode } from "react";
import "./SecureExam.css";

interface SecureExamLayoutProps {
  title: string;
  subject: string;
  remainingSeconds: number;
  saveState: "saved" | "saving" | "offline" | "error";
  children: ReactNode;
  onSubmit: () => void;
}

function formatTime(seconds: number) {
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const secs = seconds % 60;

  return [hours, minutes, secs]
    .map((value) => String(value).padStart(2, "0"))
    .join(":");
}

export default function SecureExamLayout({
  title,
  subject,
  remainingSeconds,
  saveState,
  children,
  onSubmit,
}: SecureExamLayoutProps) {
  return (
    <main className="secure-exam">
      <header className="secure-exam__header">
        <div className="secure-exam__brand">
          <div className="secure-exam__logo">HT</div>
          <div>
            <strong>HI-TECH COLLEGE</strong>
            <span>Secure Examination Environment</span>
          </div>
        </div>

        <div className="secure-exam__header-right">
          <span className="secure-exam__secure-label">
            <span className="secure-exam__secure-dot" />
            SECURE EXAM MODE
          </span>
          <div
            className={`secure-exam__timer ${
              remainingSeconds <= 300 ? "is-warning" : ""
            }`}
            aria-live="off"
          >
            <small>TIME REMAINING</small>
            <strong>{formatTime(remainingSeconds)}</strong>
          </div>
        </div>
      </header>

      <section className="secure-exam__exam-heading">
        <div>
          <p>{subject}</p>
          <h1>{title}</h1>
        </div>

        <div className="secure-exam__save-state" role="status">
          {saveState === "saved" && "All answers saved"}
          {saveState === "saving" && "Saving answers…"}
          {saveState === "offline" && "Offline — recovery copy stored"}
          {saveState === "error" && "Save failed — reconnect"}
        </div>
      </section>

      <div className="secure-exam__content">{children}</div>

      <footer className="secure-exam__footer">
        <span>HI-TECH College · Examination Services</span>
        <button
          type="button"
          className="secure-exam__submit"
          onClick={onSubmit}
        >
          Submit examination
        </button>
      </footer>
    </main>
  );
}

