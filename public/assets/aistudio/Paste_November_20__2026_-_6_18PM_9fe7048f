## **6. Examination page**

**Path:** `apps/web/src/modules/student/exams/secure/SecureExamPage.tsx`

This page provides question navigation, answer inputs, a review list, fullscreen entry and a final submission confirmation.

```

import { useEffect, useMemo, useState } from "react";
import SecureExamLayout from "./SecureExamLayout";
import { useExamSession } from "./useExamSession";
import {
  enterExamFullscreen,
  installExamSecurity,
} from "./examSecurity";
import type {
  ExamSession,
  ExamSecurityEvent,
} from "./examTypes";

interface Props {
  initialSession: ExamSession;
}

export default function SecureExamPage({ initialSession }: Props) {
  const exam = useExamSession(initialSession);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [started, setStarted] = useState(
    initialSession.status === "active"
  );
  const [showSubmitDialog, setShowSubmitDialog] = useState(false);
  const [securityWarning, setSecurityWarning] = useState("");

  const questions = exam.session.exam.questions;
  const question = questions[currentIndex];

  const answerMap = useMemo(
    () =>
      new Map(
        exam.answers.map((answer) => [
          answer.questionId,
          answer.value,
        ])
      ),
    [exam.answers]
  );

  const answeredCount = exam.answers.filter((answer) => {
    if (Array.isArray(answer.value)) return answer.value.length > 0;
    return answer.value.trim().length > 0;
  }).length;

  useEffect(() => {
    if (!started || exam.session.status !== "active") return;

    const cleanup = installExamSecurity({
      onEvent: (event: ExamSecurityEvent) => {
        void exam.recordSecurityEvent(event);

        if (
          event.type === "TAB_HIDDEN" ||
          event.type === "FULLSCREEN_EXIT"
        ) {
          setSecurityWarning(
            "Your exam window lost focus or exited fullscreen. Return to the examination."
          );
        }
      },
    });

    return cleanup;
  }, [started, exam.session.status, exam.recordSecurityEvent]);

  useEffect(() => {
    if (exam.session.status === "expired") {
      void exam.submitExam().catch(() => {
        setSecurityWarning(
          "Time has expired. Submission could not be confirmed. Please contact the examination supervisor."
        );
      });
    }
  }, [exam.session.status, exam.submitExam]);

  async function startExam() {
    const fullscreen = await enterExamFullscreen();

    if (!fullscreen) {
      setSecurityWarning(
        "Fullscreen could not be enabled. Please allow fullscreen and try again."
      );
      return;
    }

    setStarted(true);
  }

  async function confirmSubmit() {
    try {
      await exam.submitExam();
      setShowSubmitDialog(false);
    } catch {
      setSecurityWarning(
        "Submission failed. Your answers remain available for retry."
      );
    }
  }

  if (exam.session.status === "submitted") {
    return (
      <main className="secure-exam__complete">
        <div className="secure-exam__complete-card">
          <div className="secure-exam__complete-icon">✓</div>
          <h1>Examination submitted</h1>
          <p>Your submission has been received.</p>
          <p className="secure-exam__reference">
            Session reference: {exam.session.id}
          </p>
          <p>You may now leave the examination environment.</p>
        </div>
      </main>
    );
  }

  if (!started) {
    return (
      <main className="secure-exam__instructions">
        <div className="secure-exam__instructions-card">
          <div className="secure-exam__brand">
            <div className="secure-exam__logo">HT</div>
            <div>
              <strong>HI-TECH COLLEGE</strong>
              <span>Secure Examination Environment</span>
            </div>
          </div>

          <p className="secure-exam__eyebrow">EXAMINATION INSTRUCTIONS</p>
          <h1>{exam.session.exam.title}</h1>
          <p>{exam.session.exam.subject}</p>

          <div className="secure-exam__exam-facts">
            <span>
              <strong>{exam.session.exam.durationMinutes}</strong>
              Minutes
            </span>
            <span>
              <strong>{exam.session.exam.questions.length}</strong>
              Questions
            </span>
            <span>
              <strong>{exam.session.exam.totalMarks}</strong>
              Total marks
            </span>
          </div>

          <h2>Before you begin</h2>
          <ul>
            {exam.session.exam.instructions.map((instruction) => (
              <li key={instruction}>{instruction}</li>
            ))}
          </ul>

          <div className="secure-exam__notice">
            Copying, pasting and prohibited shortcuts are disabled
            within this examination page. Focus and fullscreen
            events may be recorded.
          </div>

          {securityWarning && (
            <p className="secure-exam__warning" role="alert">
              {securityWarning}
            </p>
          )}

          <button
            className="secure-exam__start"
            type="button"
            onClick={() => void startExam()}
          >
            Enter secure examination
          </button>
        </div>
      </main>
    );
  }

  if (!question) {
    return <p>No examination questions are available.</p>;
  }

  const selected = answerMap.get(question.id) ?? "";

  return (
    <SecureExamLayout
      title={exam.session.exam.title}
      subject={exam.session.exam.subject}
      remainingSeconds={exam.remainingSeconds}
      saveState={exam.saveState}
      onSubmit={() => setShowSubmitDialog(true)}
    >
      {securityWarning && (
        <div className="secure-exam__warning" role="alert">
          {securityWarning}
          <button
            type="button"
            onClick={() => setSecurityWarning("")}
          >
            Dismiss
          </button>
        </div>
      )}

      <div className="secure-exam__progress">
        <div>
          <strong>{answeredCount}</strong> of {questions.length} answered
        </div>
        <div className="secure-exam__progress-track">
          <span
            style={{
              width: `${(answeredCount / Math.max(questions.length, 1)) * 100}%`,
            }}
          />
        </div>
      </div>

      <div className="secure-exam__workspace">
        <section className="secure-exam__question">
          <div className="secure-exam__question-top">
            <span>QUESTION {question.number}</span>
            <span>{question.marks} marks</span>
          </div>

          <h2>{question.text}</h2>

          {question.instruction && (
            <p className="secure-exam__question-instruction">
              {question.instruction}
            </p>
          )}

          {question.type === "SINGLE_CHOICE" ||
          question.type === "TRUE_FALSE" ? (
            <div className="secure-exam__options">
              {(question.options ?? []).map((option) => (
                <label key={option.id}>
                  <input
                    type="radio"
                    name={question.id}
                    value={option.id}
                    checked={selected === option.id}
                    onChange={() =>
                      exam.updateAnswer(question.id, option.id)
                    }
                  />
                  <span>{option.text}</span>
                </label>
              ))}
            </div>
          ) : question.type === "MULTIPLE_CHOICE" ? (
            <div className="secure-exam__options">
              {(question.options ?? []).map((option) => {
                const values = Array.isArray(selected) ? selected : [];

                return (
                  <label key={option.id}>
                    <input
                      type="checkbox"
                      checked={values.includes(option.id)}
                      onChange={(event) => {
                        const next = event.target.checked
                          ? [...values, option.id]
                          : values.filter((value) => value !== option.id);

                        exam.updateAnswer(question.id, next);
                      }}
                    />
                    <span>{option.text}</span>
                  </label>
                );
              })}
            </div>
          ) : (
            <textarea
              className="secure-exam__answer"
              value={typeof selected === "string" ? selected : ""}
              onChange={(event) =>
                exam.updateAnswer(question.id, event.target.value)
              }
              placeholder="Type your answer here..."
              rows={8}
              spellCheck={false}
              autoComplete="off"
            />
          )}

          <div className="secure-exam__question-actions">
            <button
              type="button"
              disabled={currentIndex === 0}
              onClick={() => setCurrentIndex((index) => index - 1)}
            >
              Previous
            </button>

            <button
              type="button"
              disabled={currentIndex === questions.length - 1}
              onClick={() => setCurrentIndex((index) => index + 1)}
            >
              Next question
            </button>
          </div>
        </section>

        <aside className="secure-exam__navigator">
          <h2>Question navigator</h2>
          <div className="secure-exam__question-grid">
            {questions.map((item, index) => {
              const value = answerMap.get(item.id);
              const isAnswered = Array.isArray(value)
                ? value.length > 0
                : Boolean(value?.trim());

              return (
                <button
                  type="button"
                  key={item.id}
                  className={[
                    index === currentIndex ? "is-current" : "",
                    isAnswered ? "is-answered" : "",
                  ].join(" ")}
                  aria-label={`Question ${item.number}${
                    isAnswered ? ", answered" : ", not answered"
                  }`}
                  aria-current={index === currentIndex ? "step" : undefined}
                  onClick={() => setCurrentIndex(index)}
                >
                  {item.number}
                </button>
              );
            })}
          </div>

          <div className="secure-exam__legend">
            <span><i className="answered" /> Answered</span>
            <span><i className="unanswered" /> Not answered</span>
            <span><i className="current" /> Current</span>
          </div>

          <button
            className="secure-exam__review"
            type="button"
            onClick={() => setShowSubmitDialog(true)}
          >
            Review and submit
          </button>
        </aside>
      </div>

      {showSubmitDialog && (
        <div
          className="secure-exam__modal-backdrop"
          role="presentation"
        >
          <section
            className="secure-exam__modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="submit-title"
          >
            <h2 id="submit-title">Submit examination?</h2>
            <p>
              You have answered {answeredCount} of {questions.length} questions.
            </p>
            {answeredCount < questions.length && (
              <p className="secure-exam__warning">
                Some questions have not been answered.
              </p>
            )}
            <div className="secure-exam__modal-actions">
              <button
                type="button"
                onClick={() => setShowSubmitDialog(false)}
              >
                Continue exam
              </button>
              <button
                type="button"
                className="secure-exam__submit"
                onClick={() => void confirmSubmit()}
              >
                Confirm submission
              </button>
            </div>
          </section>
        </div>
      )}
    </SecureExamLayout>
  );
}

```

